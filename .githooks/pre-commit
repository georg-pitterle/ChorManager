#!/usr/bin/env sh
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if command -v php >/dev/null 2>&1; then
	php bin/normalize_lf_staged.php
	php bin/check_lf_repo.php
	exit 0
fi

if command -v ddev >/dev/null 2>&1; then
	# In einem Worktree zeigt --show-toplevel auf das Worktree-Verzeichnis,
	# nicht auf das Haupt-Checkout. DDEV ist aber nur im Haupt-Checkout
	# konfiguriert. Deshalb den gemeinsamen Git-Ordner auflösen.
	GIT_COMMON=$(git rev-parse --git-common-dir)
	DDEV_ROOT=$(cd "$GIT_COMMON/.." && pwd -P)
	(cd "$DDEV_ROOT" && ddev exec php bin/normalize_lf_staged.php)
	(cd "$DDEV_ROOT" && ddev exec php bin/check_lf_repo.php)
	exit 0
fi

echo "Error: Neither 'php' nor 'ddev' is available in PATH. Cannot run line-ending guard." >&2
exit 1
