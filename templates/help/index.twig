{% extends "layout.twig" %}

{% block title %}
    Hilfe - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Hilfe</h1>
            <p class="text-muted mb-0">Anleitungen zu allen Bereichen, die du nutzen kannst.</p>
        </div>
    </section>
{% endblock page_header %}

{# Die Themen ordnet HelpCatalog wie die Seitenleiste und filtert sie nach Rechten und
   Modulen. Das Suchfeld blendet help-index.js ein; ohne Skript bleibt die volle Liste. #}
{% block content %}
    <div class="dashboard-shell">
        {% if groups|length > 0 %}
            <div class="help-filter" data-help-filter hidden>
                <label class="form-label" for="help-filter-input">Anleitung suchen</label>
                <input type="search"
                       class="form-control"
                       id="help-filter-input"
                       placeholder="z. B. Absage, Noten, Newsletter"
                       autocomplete="off"
                       spellcheck="false">
            </div>

            {% if questions|length > 0 %}
                <section class="dashboard-section dashboard-section--flat"
                         aria-labelledby="help-questions-title"
                         data-help-questions>
                    <div class="dashboard-section-head">
                        <h2 class="dashboard-section-title" id="help-questions-title">Häufige Fragen</h2>
                    </div>
                    <ul class="help-questions">
                        {% for entry in questions %}
                            <li>
                                <a href="/help/{{ entry.slug }}" class="help-question">
                                    <span>{{ entry.question }}</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            <section class="dashboard-section dashboard-section--flat" aria-labelledby="help-topics-title">
                <div class="dashboard-section-head">
                    <h2 class="dashboard-section-title" id="help-topics-title">Alle Anleitungen</h2>
                </div>
                <div class="help-groups">
                    {% for group in groups %}
                        <div class="help-group" data-help-group>
                            <h3 class="group-label" id="help-group-{{ group.key }}">{{ group.title }}</h3>
                            <div class="list-group help-topics" aria-labelledby="help-group-{{ group.key }}">
                                {% for topic in group.topics %}
                                    {% set _search_text = [topic.title]|merge(topic.keywords)|join(" ") %}
                                    <a href="/help/{{ topic.slug }}"
                                       class="list-group-item list-group-item-action help-topic"
                                       data-help-topic
                                       data-help-search="{{ _search_text }}">{{ topic.title }}</a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="text-muted mb-0 d-none" data-help-filter-empty>
                    Keine Anleitung gefunden. Versuch es mit einem anderen Wort.
                </p>
            </section>
        {% else %}
            <p class="text-muted mb-0">
                Für dich gibt es hier gerade keine Anleitungen. Fehlt dir etwas, frag den Administrator.
            </p>
        {% endif %}
    </div>
{% endblock content %}

{% block scripts %}
    <script src="{{ asset_path('/js/help-index.js') }}"></script>
{% endblock scripts %}
