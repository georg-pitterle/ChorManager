{% extends "layout.twig" %}

{% block title %}
    {{ title }} - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">{{ title }}</h1>
        </div>
        <div class="page-actions">
            <a href="/help" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Zur Übersicht
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="help-page">
        <div class="help-layout">
            <article class="card help-article">
                <div class="card-body markdown-content">
                    {{ content_html|raw }}
                </div>
            </article>
            {% if toc %}
                <nav class="help-toc" aria-labelledby="help-toc-title">
                    <h2 class="group-label" id="help-toc-title">Auf dieser Seite</h2>
                    <ul>
                        {% for section in toc %}
                            <li><a href="#{{ section.id }}">{{ section.label }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </div>
    </div>
{% endblock content %}
