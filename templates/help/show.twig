{% extends "layout.twig" %}

{% block title %}
    {{ title }} - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/help">Hilfe</a></li>
                    <li class="breadcrumb-item active">{{ title }}</li>
                </ol>
            </nav>
            <h1 class="h2 mb-1">{{ title }}</h1>
        </div>
        <div class="page-actions">
            <a href="/help" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Zur Übersicht
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context">
            <div class="card border-0 shadow-sm">
                <div class="card-body markdown-content">
                    {{ content_html|raw }}
                </div>
            </div>
        </section>
    </div>
{% endblock content %}
