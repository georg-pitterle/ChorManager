{% import _self as mail_badge_ui %}

{# Briefsymbol samt Zähler-Pille.
   Die Pille steckt immer im Markup und wird bei 0 nur ausgeblendet, damit die
   Fokus-Abfrage in mail-badge.js sie bloß ein- und ausblenden muss, statt Markup
   und Klassenliste in JavaScript nachzubauen. Rot bleibt dem Fall "mindestens eine
   ungelesene Nachricht" vorbehalten: Es signalisiert Handlungsbedarf und wäre bei 0
   irreführend. #}
{% macro count_pill(unseen_count) %}
    {% set _hidden_class = unseen_count > 0 ? "" : " d-none" %}
    {% set _label = unseen_count > 99 ? "99+" : unseen_count %}
    <i class="bi bi-envelope-fill fs-5"></i>
    <span class="badge bg-danger rounded-pill mail-badge-count{{ _hidden_class }}"
          data-mail-badge-count>{{ _label }}</span>
{% endmacro %}

{% set _mail_badge = mail_badge() %}
{% set _unseen_count = _mail_badge.unseen_count %}
{% set _external_webmail_url = _mail_badge.external_webmail_url %}
{# Sichtbar, sobald ein Postfach eingerichtet ist - auch bei 0 ungelesenen
   Nachrichten, damit der Schnellzugriff aufs Postfach nicht ausgerechnet dann
   verschwindet, wenn alles gelesen ist. #}
{% if _unseen_count is not null %}
    {% if settings.modules.webmail %}
        <form action="/profile/webmail/start" method="post" class="m-0 me-3" target="_blank">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button type="submit"
                    class="btn btn-link text-white p-0 mail-badge-trigger"
                    title="Postfach öffnen"
                    data-mail-badge>{{ mail_badge_ui.count_pill(_unseen_count) }}</button>
        </form>
    {% elseif _external_webmail_url %}
        <a href="{{ _external_webmail_url }}"
           class="btn btn-link text-white p-0 mail-badge-trigger me-3"
           target="_blank"
           rel="noopener noreferrer"
           title="Postfach öffnen"
           data-mail-badge>{{ mail_badge_ui.count_pill(_unseen_count) }}</a>
    {% else %}
        <span class="text-white me-3 mail-badge-trigger"
              title="Postfach"
              data-mail-badge>{{ mail_badge_ui.count_pill(_unseen_count) }}</span>
    {% endif %}
{% endif %}
<div class="d-flex align-items-center text-white dropdown">
    <a href="#"
       class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
       id="userDropdown"
       data-bs-toggle="dropdown"
       aria-expanded="false">
        <i class="bi bi-person-circle fs-5 me-2"></i>
    </a>
    <ul class="dropdown-menu dropdown-menu-end shadow"
        aria-labelledby="userDropdown">
        <li>
            <a class="dropdown-item" href="/profile">
                <i class="bi bi-person-fill me-2"></i> Mein Profil</a>
        </li>
        <li>
            <hr class="dropdown-divider">
        </li>
        <li>
            <form action="/logout" method="post" class="m-0">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button type="submit" class="dropdown-item text-danger">
                    <i class="bi bi-box-arrow-right me-2"></i> Abmelden
                </button>
            </form>
        </li>
    </ul>
</div>
