<div class="table-toolbar">
    <div class="d-flex gap-2 align-items-center flex-wrap" data-table-controls>
        <input type="search"
               class="form-control form-control-sm"
               data-table-search
               placeholder="Suche..."
               aria-label="Tabellensuche">
        <button type="button"
                class="btn btn-sm btn-outline-secondary d-md-none"
                data-table-filter-toggle
                aria-expanded="false"
                hidden>Filter</button>
        <div class="d-flex gap-2 align-items-center" data-table-plugin-slot></div>
        <div class="dropdown">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary dropdown-toggle"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    data-table-sort-toggle
                    disabled>Sortierung</button>
            <div class="dropdown-menu dropdown-menu-end table-sort-panel"
                 data-table-sort-panel>
                <p class="table-sort-panel-empty text-muted mb-2"
                   data-table-sort-empty>Keine aktive Sortierung.</p>
                <div class="table-sort-panel-list mb-2" data-table-sort-current></div>
                <div class="dropdown-divider my-2" data-table-sort-divider hidden></div>
                <div data-table-sort-available-section hidden>
                    <p class="text-muted small mb-2">Weitere Spalten</p>
                    <div class="table-sort-panel-list" data-table-sort-available></div>
                </div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger w-100 mt-3"
                        data-table-sort-clear
                        disabled>Sortierung zurücksetzen</button>
            </div>
        </div>
        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                data-table-reset
                title="Suche, Filter, Sortierung und Ansicht zurücksetzen"
                disabled>Zurücksetzen</button>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap table-toolbar__status">
        <span class="small text-muted"
              data-table-result-count
              role="status"
              aria-live="polite"
              aria-atomic="true"></span>
        <button type="button"
                class="btn btn-link btn-sm p-0"
                data-table-filter-clear
                hidden>Filter zurücksetzen</button>
        <div class="d-flex gap-2 align-items-center flex-wrap"
             data-table-pagination>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-table-page-prev
                    aria-label="Vorherige Seite"
                    disabled>‹</button>
            <span class="small text-muted"
                  data-table-page-label
                  role="status"
                  aria-live="polite"
                  aria-atomic="true">Seite 1 / 1</span>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-table-page-next
                    aria-label="Nächste Seite"
                    disabled>›</button>
            <select class="form-select form-select-sm"
                    data-table-page-size
                    aria-label="Seitengröße"
                    disabled>
                <option value="25">25 pro Seite</option>
                <option value="50">50 pro Seite</option>
                <option value="100" selected>100 pro Seite</option>
                <option value="200">200 pro Seite</option>
            </select>
        </div>
    </div>
    <div class="dropdown ms-auto" data-table-view-toggle>
        <button type="button"
                class="btn btn-sm btn-outline-secondary dropdown-toggle"
                data-bs-toggle="dropdown"
                aria-expanded="false">Ansicht</button>
        <div class="dropdown-menu dropdown-menu-end">
            <button type="button"
                    class="dropdown-item"
                    data-table-mode="auto">Auto</button>
            <button type="button"
                    class="dropdown-item"
                    data-table-view="cards">Karten</button>
            <button type="button"
                    class="dropdown-item"
                    data-table-view="table">Tabelle</button>
        </div>
    </div>
</div>
