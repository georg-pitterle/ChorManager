{% extends "layout.twig" %}

{% block title %}
    Finanzauswertung - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Bereiche</p>
            <h1 class="h2 mb-1">Finanzauswertung</h1>
            <p class="text-muted mb-0">
                Geschäftsjahr: <strong>{{ fiscal_start }} – {{ fiscal_end }}</strong>
            </p>
        </div>
        <div class="page-actions d-flex align-items-center gap-2">
            {% if available_years|length >= 1 %}
                <form method="get"
                      action="/finances/report"
                      class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">Geschäftsjahr:</label>
                    <select name="year" class="form-select form-select-sm onchange-submit w-auto">
                        {% for year, label in available_years %}
                            <option value="{{ year }}" {{ year == selected_year ? 'selected' : '' }}>{{ label }}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            {% endif %}
            <a href="/finances/report/pdf?year={{ selected_year }}"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-file-earmark-pdf"></i> PDF herunterladen
            </a>
            <a href="/finances" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Zurück zum Kassabuch
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context"
                 aria-labelledby="finance-report-overview-title">
            <div class="dashboard-section-head">
                <h2 class="dashboard-section-title" id="finance-report-overview-title">Auswertungsübersicht</h2>
                <p class="dashboard-section-lead mb-0">Kennzahlen, Zahlungsarten und Gruppensalden für das gewählte Geschäftsjahr.</p>
            </div>

            <div class="finances-report">
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                            <div class="card-body py-4">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                                        <i class="bi bi-graph-up-arrow text-success fs-3"></i>
                                    </div>
                                    <div>
                                        <h6 class="card-subtitle text-muted mb-1">Einnahmen</h6>
                                        <h3 class="card-title text-success mb-0">{{ total_income|number_format(2, ',', '.') }} €</h3>
                                        {% if reversed_income > 0 %}
                                            <div class="small text-muted">davon Storno: {{ reversed_income|number_format(2, ',', '.') }} €</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                            <div class="card-body py-4">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                                        <i class="bi bi-graph-down-arrow text-danger fs-3"></i>
                                    </div>
                                    <div>
                                        <h6 class="card-subtitle text-muted mb-1">Ausgaben</h6>
                                        <h3 class="card-title text-danger mb-0">{{ total_expense|number_format(2, ',', '.') }} €</h3>
                                        {% if reversed_expense > 0 %}
                                            <div class="small text-muted">davon Storno: {{ reversed_expense|number_format(2, ',', '.') }} €</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 border-start {{ balance >= 0 ? 'border-primary' : 'border-warning' }} border-4 h-100">
                            <div class="card-body py-4">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                                        <i class="bi bi-cash-stack text-primary fs-3"></i>
                                    </div>
                                    <div>
                                        <h6 class="card-subtitle text-muted mb-1">Saldo</h6>
                                        <h3 class="card-title mb-0 {{ balance >= 0 ? 'text-primary' : 'text-warning' }}">
                                            {{ balance > 0 ? '+' : '' }}{{ balance|number_format(2, ',', '.') }} €
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {% if reversed_income > 0 or reversed_expense > 0 %}
                    <div class="alert alert-info" role="alert">
                        Stornierte Buchungen und ihre Gegenbuchungen bleiben im Kassabuch stehen und sind
                        in Einnahmen und Ausgaben enthalten; im Saldo heben sie einander auf. Die
                        Budgetauswertung rechnet solche Paare dagegen heraus - deren Ist-Werte liegen
                        deshalb um die oben ausgewiesenen Beträge niedriger.
                    </div>
                {% endif %}

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <h5 class="text-muted fw-semibold mb-3">
                            <i class="bi bi-safe me-1"></i> Kassabericht je Konto
                        </h5>
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-0">
                                <div class="table-responsive finance-report-table-wrap">
                                    <table class="table table-sm mb-0 finance-report-table finance-statement-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Konto</th>
                                                <th class="text-end finance-report-amount-cell">Anfangsbestand</th>
                                                <th class="text-end finance-report-amount-cell">Einnahmen</th>
                                                <th class="text-end finance-report-amount-cell">Ausgaben</th>
                                                <th class="text-end finance-report-amount-cell">Endbestand</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for row in account_statement.accounts %}
                                                <tr>
                                                    <td data-label="Konto">
                                                        {{ row.account.name }}
                                                        <span class="text-muted small">
                                                            ({{ row.account.type == "cash" ? "Bar" : "Bank" }})
                                                        </span>
                                                    </td>
                                                    <td class="text-end finance-report-amount-cell" data-label="Anfangsbestand">
                                                        {{ row.opening|number_format(2, ",", ".") }} €
                                                    </td>
                                                    <td class="text-end text-success finance-report-amount-cell" data-label="Einnahmen">
                                                        + {{ row.income|number_format(2, ",", ".") }} €
                                                    </td>
                                                    <td class="text-end text-danger finance-report-amount-cell" data-label="Ausgaben">
                                                        − {{ row.expense|number_format(2, ",", ".") }} €
                                                    </td>
                                                    {% set _closing_negative = row.closing < 0 %}
                                                    <td class="text-end fw-bold finance-report-amount-cell {{ _closing_negative ? "text-danger" : "text-success" }}"
                                                        data-label="Endbestand">
                                                        {{ row.closing|number_format(2, ",", ".") }} €
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-dark fw-bold">
                                                <td>Gesamt</td>
                                                <td class="text-end finance-report-amount-cell">
                                                    {{ account_statement.totals.opening|number_format(2, ",", ".") }} €
                                                </td>
                                                <td class="text-end finance-report-amount-cell">
                                                    + {{ account_statement.totals.income|number_format(2, ",", ".") }} €
                                                </td>
                                                <td class="text-end finance-report-amount-cell">
                                                    − {{ account_statement.totals.expense|number_format(2, ",", ".") }} €
                                                </td>
                                                <td class="text-end finance-report-amount-cell">
                                                    {{ account_statement.totals.closing|number_format(2, ",", ".") }} €
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small mt-2 mb-0">
                            Der Endbestand ist mit dem gezählten Bargeld bzw. dem Kontoauszug abzustimmen. Offene Posten ohne Zahldatum sind nicht enthalten.
                        </p>
                        {% set _before_opening = account_statement.totals.before_opening_count|default(0) %}
                        {% if _before_opening > 0 %}
                            <div class="alert alert-warning small mt-3 mb-0" role="alert">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <strong>{{ _before_opening }} Buchung(en) liegen vor dem Stichtag ihres Kontos</strong>
                                und sind in diesem Kassabericht deshalb nicht enthalten - der Anfangsbestand deckt
                                laut Konvention alles davor ab. Betroffen:
                                <ul class="mb-0 mt-1">
                                    {% for row in account_statement.accounts %}
                                        {% set _row_before = row.before_opening_count|default(0) %}
                                        {% if _row_before > 0 %}
                                            <li>
                                                {{ row.account.name }}: {{ _row_before }} Buchung(en) ab
                                                {{ row.before_opening_first|date("d.m.Y") }}, Stichtag
                                                {{ row.account.opening_date|date("d.m.Y") }}
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <h5 class="text-muted fw-semibold mb-3">
                            <i class="bi bi-funnel me-1"></i> Saldo nach Zahlungsart
                        </h5>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-secondary bg-opacity-10 p-3 rounded-circle me-3">
                                        <i class="bi bi-cash-coin text-secondary fs-4"></i>
                                    </div>
                                    <h6 class="mb-0 fw-semibold">Bar (Kassa)</h6>
                                </div>
                                <div class="table-responsive finance-report-table-wrap">
                                    <table class="table table-sm mb-0 finance-report-table">
                                        <tr>
                                            <td class="text-muted">Einnahmen</td>
                                            <td class="text-end text-success fw-bold finance-report-amount-cell">
                                                + {{ cash_income|number_format(2, ',', '.') }} €
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Ausgaben</td>
                                            <td class="text-end text-danger fw-bold finance-report-amount-cell">
                                                − {{ cash_expense|number_format(2, ',', '.') }} €
                                            </td>
                                        </tr>
                                        <tr class="table-light fw-bold">
                                            <td>Saldo Bar</td>
                                            {% set cash_balance = cash_income - cash_expense %}
                                            <td class="text-end finance-report-amount-cell {{ cash_balance >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ cash_balance|number_format(2, ',', '.') }} €
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-info bg-opacity-10 p-3 rounded-circle me-3">
                                        <i class="bi bi-bank text-info fs-4"></i>
                                    </div>
                                    <h6 class="mb-0 fw-semibold">Überweisung (Bank)</h6>
                                </div>
                                <div class="table-responsive finance-report-table-wrap">
                                    <table class="table table-sm mb-0 finance-report-table">
                                        <tr>
                                            <td class="text-muted">Einnahmen</td>
                                            <td class="text-end text-success fw-bold finance-report-amount-cell">
                                                + {{ bank_income|number_format(2, ',', '.') }} €
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Ausgaben</td>
                                            <td class="text-end text-danger fw-bold finance-report-amount-cell">
                                                − {{ bank_expense|number_format(2, ',', '.') }} €
                                            </td>
                                        </tr>
                                        <tr class="table-light fw-bold">
                                            <td>Saldo Bank</td>
                                            {% set bank_balance = bank_income - bank_expense %}
                                            <td class="text-end finance-report-amount-cell {{ bank_balance >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ bank_balance|number_format(2, ',', '.') }} €
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {% if has_groups %}
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-success bg-opacity-10 border-0 py-3">
                                    <h6 class="mb-0 text-success fw-bold">
                                        <i class="bi bi-plus-circle me-1"></i> Einnahmen nach Gruppe
                                    </h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive finance-report-table-wrap">
                                        <table class="table table-hover table-sm mb-0 finance-report-table">
                                            <tbody>
                                                {% set found_income = false %}
                                                {% for grp, totals in group_totals %}
                                                    {% if totals.income > 0 %}
                                                        {% set found_income = true %}
                                                        <tr>
                                                            <td>{{ grp }}</td>
                                                            <td class="text-end text-success fw-bold finance-report-amount-cell">
                                                                + {{ totals.income|number_format(2, ',', '.') }} €
                                                            </td>
                                                        </tr>
                                                    {% endif %}
                                                {% endfor %}
                                                {% if not found_income %}
                                                    <tr>
                                                        <td class="text-center py-3 text-muted">Keine Einnahmen</td>
                                                    </tr>
                                                {% endif %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-danger bg-opacity-10 border-0 py-3">
                                    <h6 class="mb-0 text-danger fw-bold">
                                        <i class="bi bi-dash-circle me-1"></i> Ausgaben nach Gruppe
                                    </h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive finance-report-table-wrap">
                                        <table class="table table-hover table-sm mb-0 finance-report-table">
                                            <tbody>
                                                {% set found_expense = false %}
                                                {% for grp, totals in group_totals %}
                                                    {% if totals.expense > 0 %}
                                                        {% set found_expense = true %}
                                                        <tr>
                                                            <td>{{ grp }}</td>
                                                            <td class="text-end text-danger fw-bold finance-report-amount-cell">
                                                                − {{ totals.expense|number_format(2, ',', '.') }} €
                                                            </td>
                                                        </tr>
                                                    {% endif %}
                                                {% endfor %}
                                                {% if not found_expense %}
                                                    <tr>
                                                        <td class="text-center py-3 text-muted">Keine Ausgaben</td>
                                                    </tr>
                                                {% endif %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-tag me-2"></i>Saldo nach Gruppe
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive finance-report-table-wrap">
                                <table class="table table-hover table-sm mb-0 finance-report-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Gruppe</th>
                                            <th class="text-end text-success finance-report-amount-cell">Einnahmen</th>
                                            <th class="text-end text-danger finance-report-amount-cell">Ausgaben</th>
                                            <th class="text-end finance-report-amount-cell">Saldo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for grp, totals in group_totals %}
                                            {% set grp_balance = totals.income - totals.expense %}
                                            <tr>
                                                <td>
                                                    {% if grp == '(Keine Gruppe)' %}
                                                        <span class="text-muted fst-italic">{{ grp }}</span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-light text-dark border me-1">{{ grp }}</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-end text-success finance-report-amount-cell">+ {{ totals.income|number_format(2, ',', '.') }} €</td>
                                                <td class="text-end text-danger finance-report-amount-cell">− {{ totals.expense|number_format(2, ',', '.') }} €</td>
                                                <td class="text-end fw-bold finance-report-amount-cell {{ grp_balance >= 0 ? 'text-success' : 'text-danger' }}">
                                                    {{ grp_balance|number_format(2, ',', '.') }} €
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="card shadow-sm border-0 table-shell"
                     data-table-engine="true"
                     data-table-id="finances.report.timeline"
                     data-default-view="auto"
                     data-default-page-size="100"
                     data-page-size-options="25,50,100,200"
                     data-default-sort-key="payment_date"
                     data-default-sort-dir="asc">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Verlauf des Geschäftsjahres</h5>
                    </div>
                    {{ include("partials/table_toolbar.twig") }}
                    <div class="card-body p-0">
                        <div class="table-responsive finance-report-table-wrap">
                            <table class="table table-hover table-sm mb-0 table-responsive-cards finance-report-table"
                                   id="financesReportTimelineTable">
                                <thead class="table-light">
                                    <tr>
                                        <th class="finance-report-date-cell"
                                            data-sort-key="payment_date"
                                            data-sort-type="date">Datum</th>
                                        <th class="finance-report-number-cell"
                                            data-sort-key="running_number"
                                            data-sort-type="number">Lfd. Nr.</th>
                                        <th class="finance-report-description-cell"
                                            data-sort-key="description"
                                            data-sort-type="text">Beschreibung</th>
                                        <th class="text-end finance-report-amount-cell"
                                            data-sort-key="income"
                                            data-sort-type="number">Einnahme</th>
                                        <th class="text-end finance-report-amount-cell"
                                            data-sort-key="expense"
                                            data-sort-type="number">Ausgabe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set current_balance = 0 %}
                                    {% for item in finances %}
                                        {% if item.type == 'income' %}
                                            {% set current_balance = current_balance + item.amount %}
                                        {% else %}
                                            {% set current_balance = current_balance - item.amount %}
                                        {% endif %}
                                        <tr data-sort-payment_date="{{ item.payment_date|date("Y-m-d") }}"
                                            data-sort-running_number="{{ item.running_number }}"
                                            data-sort-description="{{ item.description|lower }}"
                                            data-sort-income="{{ item.type == "income" ? item.amount : 0 }}"
                                            data-sort-expense="{{ item.type == "expense" ? item.amount : 0 }}">
                                            <td class="finance-report-date-cell" data-label="Datum">{{ item.payment_date|date("d.m.Y") }}</td>
                                            <td class="text-muted finance-report-number-cell" data-label="Lfd. Nr.">#{{ item.running_number }}</td>
                                            <td class="finance-report-description-cell" data-label="Beschreibung">{{ item.description }}</td>
                                            <td class="text-end text-success finance-report-amount-cell"
                                                data-label="Einnahme">
                                                {{ item.type == "income" ? "+ " ~ item.amount|number_format(2, ",", ".") ~ " €" : "" }}
                                            </td>
                                            <td class="text-end text-danger finance-report-amount-cell"
                                                data-label="Ausgabe">
                                                {{ item.type == "expense" ? "- " ~ item.amount|number_format(2, ",", ".") ~ " €" : "" }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">Keine Buchungen vorhanden.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>

                                {% if finances|length > 0 %}
                                    <tfoot>
                                        <tr class="table-dark fw-bold">
                                            <td colspan="3" class="text-end">Gesamtsaldo:</td>
                                            <td colspan="2"
                                                class="text-end finance-report-amount-cell {{ current_balance >= 0 ? "text-success" : "text-danger" }}">
                                                {{ current_balance|number_format(2, ",", ".") }} €
                                            </td>
                                        </tr>
                                    </tfoot>
                                {% endif %}
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock content %}
