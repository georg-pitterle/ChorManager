{% extends is_modal|default(false) ? 'layout_modal.twig' : 'layout.twig' %}

{% block title %}
    Newsletter-Vorschau ({{ newsletter.title }}) - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Bereiche</p>
            <h1 class="h2 mb-1">Newsletter-Vorschau</h1>
            <p class="text-muted mb-0">{{ newsletter.title }}</p>
        </div>
        <div class="page-actions">
            <a href="/newsletters?project_id={{ newsletter.project_id }}&status={{ newsletter.status == 'sent' ? 'sent' : 'draft' }}"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle"></i> Schließen
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="container-fluid px-0">
        <div class="row">
            <div class="col-12">
                <div class="surface-card card border-0">
                    <div class="card-header bg-light">
                        <h5 class="mb-1">{{ preview_title|default(newsletter.title) }}</h5>
                        <small class="text-muted">
                            Von: {{ newsletter.createdBy|person_name }}
                            | Erstellt: {{ newsletter.created_at|date("d.m.Y H:i") }}
                        </small>
                        {% if preview_recipient_name is defined and preview_recipient_name != "" %}
                            <p class="text-muted small mb-0 mt-2">
                                {% if preview_is_own_data|default(false) %}
                                    Platzhalter sind mit deinen eigenen Daten gefüllt.
                                {% else %}
                                    Platzhalter sind mit den Daten von {{ preview_recipient_name }} gefüllt.
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>
                    <div class="card-body p-0">
                        <iframe src="{{ preview_frame_url }}"
                                class="newsletter-preview-frame"
                                title="Newsletter-Vorschau"
                                sandbox=""
                                loading="lazy"></iframe>
                    </div>
                    <div class="card-footer">
                        <div class="text-muted text-center">
                            <small>
                                Empfänger: <strong class="badge bg-info">{{ newsletter.recipient_count }}</strong>
                                | Status: <strong>{{ newsletter.status }}</strong>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}
