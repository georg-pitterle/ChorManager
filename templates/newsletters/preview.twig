{% extends is_modal|default(false) ? 'layout_modal.twig' : 'layout.twig' %}

{% import "macros/help.twig" as help %}

{# Zwei Gesichter: Der Lesedialog des Archivs (is_reader und modal) zeigt nur den Newsletter.
   Alles andere ist die Verwaltungs-Vorschau - wer außerhalb des Dialogs liest, landet auf der
   eigenen Leseseite (NewsletterController::read()). #}
{% set _is_reader = is_reader|default(not can_manage_newsletters|default(false)) %}
{% set _subject = preview_title|default(newsletter.title) %}

{% block title %}
    {{ _is_reader ? "Newsletter" : "Newsletter-Vorschau" }} ({{ _subject }}) - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Newsletter-Vorschau</h1>
            <p class="text-muted mb-0">{{ _subject }}</p>
        </div>
        <div class="page-actions">
            {{ help.button("newsletter", "Newsletter") }}
            {% set _status_filter = newsletter.status == "sent" ? "sent" : "draft" %}
            <a href="/newsletters?project_id={{ newsletter.project_id }}&status={{ _status_filter }}"
               class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Schließen
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if _is_reader and is_modal|default(false) %}
        {# Im Lesedialog des Archivs stehen Betreff und Versanddatum bereits im Dialogkopf. #}
        <div class="newsletter-reader" data-newsletter-reader>
            <iframe src="{{ preview_frame_url }}"
                    class="newsletter-preview-frame"
                    title="Newsletter {{ _subject }}"
                    sandbox="allow-popups allow-popups-to-escape-sandbox allow-downloads"></iframe>
            {{ include("newsletters/partials/preview_attachments.twig") }}
        </div>
    {% else %}
        {% set _sender = newsletter.createdBy|person_name %}
        {% set _is_sent = newsletter.status == "sent" %}
        <div class="surface-card card border-0 newsletter-preview-card">
            <div class="card-header">
                {# Der Betreff steht in der Seitenüberschrift und im Mailkopf; hier stehen nur die
                   Angaben, die die Mail selbst nicht trägt. #}
                <p class="newsletter-preview-facts mb-0">
                    <span>Von {{ _sender }}</span>
                    {% if newsletter.recipient_count|default(0) > 0 %}
                        <span>{{ newsletter.recipient_count }} Empfänger</span>
                    {% endif %}
                    {% if _is_sent and newsletter.sent_at %}
                        <span class="newsletter-preview-facts__status">Versendet am {{ newsletter.sent_at|date("d.m.Y H:i") }}</span>
                    {% elseif _is_sent %}
                        <span class="newsletter-preview-facts__status">{{ status_label|default("Versendet") }}</span>
                    {% else %}
                        <span class="newsletter-preview-facts__status">
                            {{ status_label|default("Entwurf") }}, erstellt am {{ newsletter.created_at|date("d.m.Y H:i") }}
                        </span>
                    {% endif %}
                </p>
                {# Nur fremde Empfängerdaten sind erklärungsbedürftig: Dass die eigenen
                   Daten eingesetzt sind, sieht man am Text selbst. #}
                {% set _shows_foreign_data = not preview_is_own_data|default(false) %}
                {% set _has_recipient_name = preview_recipient_name|default("") != "" %}
                {% if _shows_foreign_data and _has_recipient_name %}
                    <p class="text-muted small mb-0 mt-2">
                        Platzhalter sind mit den Daten von {{ preview_recipient_name }} gefüllt.
                    </p>
                {% endif %}
            </div>
            <div class="card-body p-0">
                <iframe src="{{ preview_frame_url }}"
                        class="newsletter-preview-frame"
                        title="Newsletter-Vorschau"
                        sandbox="allow-popups allow-popups-to-escape-sandbox allow-downloads"></iframe>
            </div>
            {{ include("newsletters/partials/preview_attachments.twig", {in_card: true}) }}
        </div>
    {% endif %}
{% endblock content %}
