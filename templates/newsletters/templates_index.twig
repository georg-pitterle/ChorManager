{% extends "layout.twig" %}

{% block title %}
    Newsletter-Vorlagen - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Bereiche</p>
            <h1 class="h2 mb-1">Newsletter-Vorlagen</h1>
            <p class="text-muted mb-0">Globale und projektbezogene Vorlagen zentral verwalten.</p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#createTemplateModal">
                <i class="bi bi-plus-circle"></i> Vorlage erstellen
            </button>
            <a href="/newsletters" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Zurück zu Newslettern
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="container-fluid px-0">
        {% if success %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ success }}
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        {% endif %}
        {% if error %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ error }}
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        {% endif %}

        <div class="dashboard-shell">
            <section class="dashboard-section dashboard-section--context"
                     aria-labelledby="newsletter-templates-list-title">
                <div class="dashboard-section-head">
                    <h2 class="dashboard-section-title" id="newsletter-templates-list-title">Vorlagenübersicht</h2>
                    <p class="dashboard-section-lead mb-0">{{ templates|length }} Vorlagen im aktuellen Ergebnis.</p>
                </div>

                <div class="surface-card card border-0 table-shell"
                     data-table-engine="true"
                     data-table-id="newsletters.templates.index"
                     data-default-view="auto"
                     data-default-page-size="100"
                     data-page-size-options="25,50,100,200"
                     data-default-sort-key="name">
                    {{ include("partials/table_toolbar.twig") }}
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 table-responsive-cards"
                                   id="newsletterTemplatesTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th data-sort-key="name" data-sort-type="text">Name</th>
                                        <th data-sort-key="context" data-sort-type="text">Kontext</th>
                                        <th class="text-end">Aktionen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for template in templates %}
                                        <tr data-sort-name="{{ template.name|lower }}"
                                            data-sort-context="{{ template.project_id ? "projekt" : "global" }}">
                                            <td data-label="Name">{{ template.name }}</td>
                                            <td data-label="Kontext">
                                                <span class="badge rounded-pill {{ template.project_id ? "bg-info text-dark" : "bg-secondary" }}">
                                                    {{ template.project_id ? "Projekt" : "Global" }}
                                                </span>
                                            </td>
                                            <td data-label="Aktionen" class="text-end">
                                                <div class="btn-group"
                                                     role="group"
                                                     aria-label="Aktionen für Vorlage {{ template.name }}">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            data-newsletter-modal-url="/newsletters/templates/{{ template.id }}/edit?modal=1"
                                                            data-newsletter-modal-title="Vorlage bearbeiten">
                                                        <i class="bi bi-pencil"></i> Bearbeiten
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split"
                                                            data-bs-toggle="dropdown"
                                                            aria-expanded="false"
                                                            data-bs-boundary="viewport">
                                                        <span class="visually-hidden">Weitere Aktionen</span>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <form method="post" action="/newsletters/templates/{{ template.id }}/clone">
                                                                <button type="submit" class="dropdown-item">
                                                                    <i class="bi bi-files me-2"></i> Klonen
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center py-4 text-muted">Es sind noch keine Vorlagen vorhanden.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="modal fade"
             id="createTemplateModal"
             tabindex="-1"
             aria-labelledby="createTemplateModalLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    {# modal-form-shell: Bootstrap verteilt Kopf, Körper und Fußleiste über
                       .modal-content. Dieses Formular umschließt die drei und ist damit das
                       einzige Flex-Kind - ohne die Hülle reicht es die Höhenbeschränkung nicht
                       weiter, der Körper wächst auf volle Inhaltshöhe und schiebt die Knöpfe
                       aus dem Bild. #}
                    <form method="post"
                          action="/newsletters/templates"
                          class="modal-form-shell">
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="createTemplateModalLabel">Neue Vorlage erstellen</h2>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        {# Eigene id-Vorsilbe: Der Bearbeiten-Dialog wird in
                           #newsletterActionContent derselben Seite nachgeladen und bringt
                           seine eigenen Felder mit. Ohne Vorsilbe stünde jede id zweimal im
                           Dokument - Beschriftungen zeigten aufs falsche Feld und TinyMCE
                           wie TomSelect griffen sich jeweils das erstbeste Element. #}
                        <div class="modal-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label" for="create-template-name">Name</label>
                                    <input class="form-control" id="create-template-name" name="name" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="create-template-project_id">Kontext</label>
                                    <select class="form-select" id="create-template-project_id" name="project_id">
                                        <option value="">Global</option>
                                        {% for project in projects %}<option value="{{ project.id }}">{{ project.name }}</option>{% endfor %}
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="create-template-default_title">Titelvorschlag (optional)</label>
                                    <input class="form-control"
                                           id="create-template-default_title"
                                           name="default_title"
                                           maxlength="255"
                                           placeholder="Titel, den der Newsletter aus dieser Vorlage erhält">
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="create-template-description">Beschreibung</label>
                                    <textarea class="form-control"
                                              id="create-template-description"
                                              name="description"
                                              rows="2"></textarea>
                                </div>

                                <div class="col-12">
                                    <section aria-labelledby="create-template-sources-title">
                                        <h3 class="h6" id="create-template-sources-title">Empfängerquellen</h3>
                                        <p class="text-muted small">
                                            Diese Angaben werden übernommen, sobald die Vorlage in einen Newsletter geladen wird.
                                        </p>

                                        <div class="mb-3">
                                            <label class="form-label" for="create-template-source-project_members">Projektmitglieder</label>
                                            <select id="create-template-source-project_members"
                                                    class="form-select"
                                                    name="source_project_members[]"
                                                    data-tom-select
                                                    data-placeholder="Projekte auswählen …"
                                                    multiple>
                                                {% for project in projects %}
                                                    <option value="{{ project.id }}">{{ project.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="create-template-source-event_attendees">Veranstaltungsteilnehmer</label>
                                            <select id="create-template-source-event_attendees"
                                                    class="form-select"
                                                    name="source_event_attendees[]"
                                                    data-tom-select
                                                    data-placeholder="Veranstaltungen auswählen …"
                                                    multiple>
                                                {% for event in events %}
                                                    <option value="{{ event.id }}">
                                                        {{ event.title }} ({{ event.starts_at|date("d.m.Y") }})
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="create-template-source-role">Rollen</label>
                                            <select id="create-template-source-role"
                                                    class="form-select"
                                                    name="source_role[]"
                                                    data-tom-select
                                                    data-placeholder="Rollen auswählen …"
                                                    multiple>
                                                {% for role in roles %}
                                                    <option value="{{ role.id }}">{{ role.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <div class="mb-0">
                                            <label class="form-label" for="create-template-source-user">Einzelne Mitglieder</label>
                                            <select id="create-template-source-user"
                                                    class="form-select"
                                                    name="source_user[]"
                                                    data-tom-select
                                                    data-placeholder="Mitglieder auswählen …"
                                                    multiple>
                                                {% for member in users %}
                                                    <option value="{{ member.id }}">{{ member|person_name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </section>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="create-template-content_html">Inhalt</label>
                                    <textarea class="form-control tinymce-editor"
                                              id="create-template-content_html"
                                              name="content_html"
                                              data-placeholder-source="/newsletters/placeholders"
                                              required></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">Abbrechen</button>
                            <button type="submit" class="btn btn-primary">Vorlage erstellen</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade"
             id="newsletterActionModal"
             tabindex="-1"
             aria-labelledby="newsletterActionModalLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content border-0 shadow rounded-3">
                    <div class="modal-header">
                        <h5 class="modal-title" id="newsletterActionModalLabel">Newsletter</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-2 p-md-3">
                        <div id="newsletterActionContent" class="container-fluid px-0"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
{% endblock styles %}

{% block scripts %}
    <script src="/js/newsletters.js"></script>
    {# Für die Empfängerquellen im Erstellen-Dialog. tom-select-init.js hängt sich an
       shown.bs.modal, die Felder werden also beim Öffnen des Dialogs aufgebaut. #}
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="{{ asset_path('/js/tom-select-init.js') }}"></script>
{% endblock scripts %}
