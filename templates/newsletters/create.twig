{% extends is_modal|default(false) ? 'layout_modal.twig' : 'layout.twig' %}
{% block editor_scripts %}
    <script src="/vendor/tinymce/tinymce/tinymce.min.js"></script>
{% endblock editor_scripts %}

{% block title %}
    Newsletter erstellen - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Neuer Newsletter</h1>
            <p class="text-muted mb-0">
                Projekt: <strong>{{ project.name|default("kein Projekt") }}</strong>
            </p>
        </div>
        <div class="page-actions">
            <a href="/newsletters?status=draft"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Zurück zur Übersicht
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="container-fluid px-0">
        <form id="create-newsletter-form"
              method="post"
              action="/newsletters"
              data-is-modal="{{ is_modal|default(false) ? '1' : '0' }}">
            {% if is_modal|default(false) %}<input type="hidden" name="modal" value="1">{% endif %}
            <div class="dashboard-shell">
                <section class="dashboard-section dashboard-section--actions"
                         aria-labelledby="newsletter-create-settings-title">
                    <div class="dashboard-section-head">
                        <h2 class="dashboard-section-title" id="newsletter-create-settings-title">Newsletter-Einstellungen</h2>
                        <p class="dashboard-section-lead mb-0">Projekt, Titel, Empfängerquellen und optionale Vorlage festlegen.</p>
                    </div>

                    <div class="surface-card form-surface card border-0">
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="project_id" class="form-label">Projekt (optional)</label>
                                <select class="form-select" id="project_id" name="project_id">
                                    <option value="">— kein Projekt —</option>
                                    {% for selectable_project in projects %}
                                        <option value="{{ selectable_project.id }}"
                                                {% if project and selectable_project.id == project.id %}selected{% endif %}>
                                            {{ selectable_project.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="title" class="form-label">
                                    Titel <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="title"
                                       name="title"
                                       placeholder="z.B. Januar Newsletter 2026"
                                       required>
                            </div>

                            <section class="mb-3"
                                     id="recipient-sources"
                                     aria-labelledby="recipient-sources-title">
                                <h3 class="group-label" id="recipient-sources-title">Empfänger</h3>
                                {{ include("newsletters/_audience.twig", {id_prefix: "create"}) }}

                                <div class="alert alert-info mb-0">
                                    <strong>Empfänger:</strong>
                                    <span class="badge text-bg-info" id="recipient-count-badge">0</span>
                                    <span class="small text-muted ms-2" id="recipient-count-status"></span>
                                </div>
                            </section>

                            <div class="mb-3">
                                <label for="template" class="form-label">Vorlage laden (optional)</label>
                                <select class="form-select" id="template" data-action="load-template">
                                    <option value="">-- Keine Vorlage --</option>
                                    {% for group in template_groups %}
                                        <optgroup label="{{ group.label }}">
                                            {% for template in group.templates %}
                                                <option value="{{ template.id }}">{{ template.name }}</option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="dashboard-section dashboard-section--actions"
                         aria-labelledby="newsletter-create-content-title">
                    <div class="dashboard-section-head">
                        <h2 class="dashboard-section-title" id="newsletter-create-content-title">Inhalt</h2>
                        <p class="dashboard-section-lead mb-0">Erstelle den Newsletter-Inhalt im Editor.</p>
                    </div>

                    <div class="surface-card form-surface card border-0">
                        <div class="card-body">
                            <textarea id="content_html"
                                      name="content_html"
                                      class="tinymce-editor"
                                      aria-label="Newsletter-Inhalt"
                                      data-placeholder-source="/newsletters/placeholders"></textarea>

                            <div class="mt-3">
                                <label for="newsletter-attachments" class="form-label">Dateien (optional)</label>
                                <input type="file"
                                       class="form-control"
                                       id="newsletter-attachments"
                                       name="attachments[]"
                                       multiple>
                                <div class="form-text">
                                    Kleine Dateien hängen an der Mail, große werden darin verlinkt.
                                    Den Zustellweg kannst du danach im Editor ändern.
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="form-action-bar">
                <a href="/newsletters?status=draft"
                   class="btn btn-outline-secondary">
                    Abbrechen
                </a>
                <button type="submit" class="btn btn-primary">
                    Erstellen als Entwurf
                </button>
            </div>
        </form>
    </div>

{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
{% endblock styles %}

{% block scripts %}
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="{{ asset_path('/js/tom-select-init.js') }}"></script>
    <script src="{{ asset_path('/js/audience-filter.js') }}"></script>
    <script src="{{ asset_path('/js/newsletters-create.js') }}"></script>
{% endblock scripts %}
