{% extends "layout.twig" %}

{% block title %}
    Newsletter-Archiv - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Newsletter-Archiv</h1>
            <p class="text-muted mb-0">Alle Newsletter, die an dich versendet wurden – auch wenn die Mail längst gelöscht ist.</p>
        </div>
        <div class="page-actions">
            <a href="/help/newsletter" class="btn btn-outline-secondary">
                <i class="bi bi-question-circle" aria-hidden="true"></i> Hilfe
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if total == 0 %}
        <div class="event-empty">
            <p class="mb-2">Noch keine Newsletter.</p>
            <p class="text-muted small mb-0">Sobald der Chor dir einen Newsletter schickt, findest du ihn hier.</p>
        </div>
    {% else %}
        {# Die Suche lohnt erst, wenn die Liste nicht mehr auf einen Blick zu überschauen ist. #}
        {% if total > 8 %}
            <div class="newsletter-archive__search">
                <label for="newsletterArchiveSearch" class="visually-hidden">Newsletter durchsuchen</label>
                <input type="search"
                       id="newsletterArchiveSearch"
                       class="form-control"
                       placeholder="Betreff, Projekt oder Absender suchen"
                       autocomplete="off">
            </div>
            <p class="newsletter-archive__no-match" data-archive-no-match hidden>
                Kein Newsletter passt zu deiner Suche.
            </p>
        {% endif %}

        <div id="newsletterArchiveList">
            {% for month in months %}
                <section class="event-plan__month" data-archive-month aria-labelledby="newsletter-month-{{ month.key }}">
                    <h2 class="event-plan__month-title" id="newsletter-month-{{ month.key }}">{{ month.label }}</h2>
                    <ol class="event-plan__list newsletter-archive">
                        {% for row in month.events %}
                            {% set _sent = row.sent_at|date("d.m.Y H:i") %}
                            {% set _meta = "Gesendet am " ~ _sent ~ (row.sender ? " · von " ~ row.sender : "") %}
                            <li class="event-plan__item newsletter-archive__item"
                                data-archive-item
                                data-search="{{ [row.subject, row.project, row.sender]|join(" ")|lower }}">
                                <div class="event-plan__date" aria-hidden="true">
                                    <span class="event-plan__weekday">{{ row.weekday }}</span>
                                    <span class="event-plan__day">{{ row.sent_at|date("j") }}</span>
                                </div>
                                <div class="event-plan__body">
                                    <h3 class="newsletter-archive__heading">
                                        <a href="/newsletters/{{ row.newsletter_id }}/preview?reader=1"
                                           class="event-plan__title stretched-link"
                                           data-newsletter-open
                                           data-newsletter-url="/newsletters/{{ row.newsletter_id }}/preview?modal=1&amp;reader=1"
                                           data-newsletter-subject="{{ row.subject }}"
                                           data-newsletter-meta="{{ _meta }}">{{ row.subject }}</a>
                                    </h3>
                                    <div class="event-plan__meta">{{ _meta }}</div>
                                </div>
                                {% if row.relative_label or row.project %}
                                    <div class="event-plan__aside">
                                        {% if row.relative_label %}
                                            <span class="event-relative">{{ row.relative_label }}</span>
                                        {% endif %}
                                        {% if row.project %}
                                            <span class="badge text-bg-secondary">{{ row.project }}</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                </section>
            {% endfor %}
        </div>

        <div class="modal fade newsletter-reader-modal"
             id="newsletterReaderModal"
             tabindex="-1"
             aria-labelledby="newsletterReaderTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="newsletter-reader-modal__head">
                            <h2 class="modal-title newsletter-reader-modal__title"
                                id="newsletterReaderTitle"
                                data-reader-title>Newsletter</h2>
                            <p class="newsletter-reader-modal__meta" data-reader-meta></p>
                        </div>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Schließen"></button>
                    </div>
                    <div class="modal-body" data-reader-content></div>
                    <div class="modal-footer newsletter-reader-modal__nav">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-reader-step="newer">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i> Neuer
                        </button>
                        <span class="newsletter-reader-modal__position" data-reader-position></span>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-reader-step="older">
                            Älter <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock content %}

{% block scripts %}
    <script src="{{ asset_path('/js/newsletter-archive.js') }}"></script>
{% endblock scripts %}
