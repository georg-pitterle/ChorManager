{% extends is_modal|default(false) ? 'layout_modal.twig' : 'layout.twig' %}
{% block editor_scripts %}
    <script src="/vendor/tinymce/tinymce/tinymce.min.js"></script>
{% endblock editor_scripts %}

{% block title %}
    Newsletter bearbeiten - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Kommunikation</p>
            <h1 class="h2 mb-1">Newsletter bearbeiten</h1>
            <p class="text-muted mb-0">
                Projekt: <strong>{{ project.name|default("kein Projekt") }}</strong>
            </p>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="container-fluid px-0">
        <!-- Lock Warning -->
        {% if newsletter.isLocked() and newsletter.locked_by != session.user_id %}
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Newsletter wird bearbeitet!</strong>
                Dieser Newsletter wird gerade von
                <strong>{{ newsletter.lockedBy|person_name }}</strong>
                bearbeitet. Aktualisierung alle 30 Sekunden.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        <form id="edit-newsletter-form"
              method="post"
              action="/newsletters/{{ newsletter.id }}"
              data-newsletter-id="{{ newsletter.id }}"
              data-is-modal="{{ is_modal|default(false) ? '1' : '0' }}">
            <div class="dashboard-shell">
                <section class="dashboard-section dashboard-section--actions"
                         aria-labelledby="newsletter-edit-settings-title">
                    <div class="dashboard-section-head">
                        <h2 class="dashboard-section-title" id="newsletter-edit-settings-title">Newsletter-Einstellungen</h2>
                        <p class="dashboard-section-lead mb-0">Projekt, Titel und Empfängerquellen anpassen.</p>
                    </div>

                    <div class="surface-card form-surface card border-0">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Newsletter-Einstellungen</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="project_id" class="form-label">Projekt (optional)</label>
                                <select class="form-select" id="project_id" name="project_id">
                                    <option value=""
                                            {% if not newsletter.project_id %}selected{% endif %}>
                                        — kein Projekt —
                                    </option>
                                    {% for selectable_project in projects %}
                                        <option value="{{ selectable_project.id }}"
                                                {% if newsletter.project_id == selectable_project.id %}selected{% endif %}>
                                            {{ selectable_project.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="title" class="form-label">
                                    Titel <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="title"
                                       name="title"
                                       value="{{ newsletter.title }}"
                                       required>
                            </div>

                            <section class="mb-3"
                                     id="recipient-sources"
                                     aria-labelledby="recipient-sources-title">
                                <h3 class="h6" id="recipient-sources-title">Empfänger</h3>
                                {{ include("newsletters/_audience.twig", {id_prefix: "edit"}) }}

                                <div class="alert alert-info mb-0">
                                    <strong>Empfänger:</strong>
                                    <span id="recipient-count-badge" class="badge bg-info">{{ newsletter.recipient_count }}</span>
                                    <span class="small text-muted ms-2" id="recipient-count-status"></span>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>

                <section class="dashboard-section dashboard-section--actions"
                         aria-labelledby="newsletter-edit-content-title">
                    <div class="dashboard-section-head">
                        <h2 class="dashboard-section-title" id="newsletter-edit-content-title">Inhalt</h2>
                        <p class="dashboard-section-lead mb-0">Inhalt prüfen, bearbeiten und versenden.</p>
                    </div>

                    <div class="surface-card form-surface card border-0">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Inhalt</h5>
                        </div>
                        <div class="card-body">
                            <textarea id="content_html"
                                      name="content_html"
                                      class="tinymce-editor"
                                      aria-label="Newsletter-Inhalt"
                                      data-placeholder-source="/newsletters/placeholders">{{ newsletter.content_html }}</textarea>
                        </div>
                    </div>

                    {# Die Dateien stehen direkt unter dem Editor, weil sie zum Inhalt
                       gehören: Wer den Text schreibt, entscheidet im selben Zug, was
                       mitgeht. Ihre Formulare liegen weiter unten außerhalb dieses
                       Formulars und sind über das form-Attribut angebunden -
                       verschachtelte Formulare erlaubt HTML nicht. Der Autosave baut sein
                       FormData aus dem Editor-Formular und lässt die Anhang-Felder damit
                       von selbst aus. #}
                    <div class="surface-card form-surface card border-0 mt-3">
                        <div class="card-header bg-light d-flex flex-wrap align-items-baseline gap-2">
                            <h5 class="mb-0" id="newsletter-attachments-title">Dateien</h5>
                            <small class="text-muted">
                                Kleine Dateien hängen an der Mail, große werden darin verlinkt.
                            </small>
                        </div>
                        <div class="card-body">
                            {% if attachments|length > 0 %}
                                <ul class="list-group list-group-flush mb-3">
                                    {% for attachment in attachments %}
                                        <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                            <span class="flex-grow-1">
                                                <i class="bi bi-paperclip"></i>
                                                {{ attachment.original_name }}
                                                <small class="text-muted">
                                                    {{ (attachment.file_size / 1024)|round(1) ~ " KB" }}
                                                </small>
                                            </span>
                                            <label class="visually-hidden"
                                                   for="delivery-mode-{{ attachment.id }}">Zustellweg</label>
                                            <select class="form-select form-select-sm w-auto"
                                                    id="delivery-mode-{{ attachment.id }}"
                                                    name="delivery_mode"
                                                    form="attachment-mode-form-{{ attachment.id }}">
                                                <option value="attach"
                                                        {{ attachment.delivery_mode == "attach" ? "selected" : "" }}>
                                                    An die Mail hängen
                                                </option>
                                                <option value="link"
                                                        {{ attachment.delivery_mode == "link" ? "selected" : "" }}>
                                                    In der Mail verlinken
                                                </option>
                                            </select>
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    form="attachment-mode-form-{{ attachment.id }}">
                                                Übernehmen
                                            </button>
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    form="attachment-delete-form-{{ attachment.id }}">
                                                <i class="bi bi-trash"></i>
                                                <span class="visually-hidden">Entfernen</span>
                                            </button>
                                        </li>
                                    {% endfor %}
                                </ul>

                                {% if attached_total > max_attached_total %}
                                    <div class="alert alert-warning">
                                        Die angehängten Dateien sind zusammen zu groß
                                        ({{ (max_attached_total / 1048576)|round ~ " MB" }} sind erlaubt).
                                        Der Versand wird abgelehnt, solange das so bleibt - stelle große
                                        Dateien auf "In der Mail verlinken" um.
                                    </div>
                                {% endif %}
                            {% else %}
                                <p class="text-muted mb-3">Noch keine Dateien.</p>
                            {% endif %}

                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <label class="visually-hidden" for="newsletter-attachments">Dateien wählen</label>
                                <input type="file"
                                       class="form-control w-auto"
                                       id="newsletter-attachments"
                                       name="attachments[]"
                                       form="attachment-upload-form"
                                       multiple>
                                <button type="submit"
                                        class="btn btn-outline-primary"
                                        form="attachment-upload-form">
                                    <i class="bi bi-upload"></i> Hochladen
                                </button>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            {# Eine Leiste statt zweier Knopfreihen: links, was den Entwurf verlässt oder
               verwirft, rechts die Arbeit am Inhalt bis zum Versand. Gefüllt ist nur der
               Versand - vorher trugen vier Knöpfe vier verschiedene Umrandungsfarben ohne
               erkennbare Rangfolge. #}
            <div class="form-action-bar d-flex flex-wrap align-items-center gap-2">
                <a href="/newsletters?status=draft" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Zurück
                </a>
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#saveTemplateModal">
                    <i class="bi bi-bookmark"></i> Als Vorlage speichern
                </button>
                <button type="submit" class="btn btn-outline-danger" form="newsletter-delete-form">
                    <i class="bi bi-trash"></i> Löschen
                </button>

                <div class="ms-md-auto d-flex flex-wrap align-items-center gap-2">
                    <div class="input-group w-auto">
                        <label class="visually-hidden" for="preview-recipient">Vorschau für</label>
                        <select id="preview-recipient" class="form-select" aria-label="Vorschau für">
                            <option value="">Vorschau mit eigenen Daten</option>
                            {% for recipient in preview_recipients %}
                                <option value="{{ recipient.id }}">{{ recipient|person_name }}</option>
                            {% endfor %}
                        </select>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="preview-btn"
                                {% if not is_modal|default(false) %}data-bs-toggle="modal" data-bs-target="#previewModal"{% endif %}>
                            <i class="bi bi-eye"></i> Vorschau
                        </button>
                    </div>
                    <button type="button" class="btn btn-outline-secondary" id="test-mail-btn">
                        <i class="bi bi-envelope-check"></i> Testmail
                    </button>
                    <button type="button" class="btn btn-outline-primary" id="save-draft-btn">
                        <i class="bi bi-floppy"></i> Speichern
                    </button>
                    <button type="button" class="btn btn-success" id="send-newsletter-btn">
                        <i class="bi bi-send"></i> Versenden
                    </button>
                </div>
            </div>

            <!-- Save Template Modal -->
            <div class="modal fade" id="saveTemplateModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Als Vorlage speichern</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted small">
                                Übernommen werden auch die Newsletter-Einstellungen dieses Entwurfs:
                                Titel, Projekt und Empfängerquellen - jeweils im zuletzt gespeicherten Stand.
                            </p>
                            <div class="mb-3">
                                <label for="template_name" class="form-label">Vorlagen-Name</label>
                                <input type="text"
                                       class="form-control"
                                       id="template_name"
                                       value="{{ newsletter.title }}">
                            </div>
                            <div class="mb-3">
                                <label for="template_description" class="form-label">Beschreibung</label>
                                <textarea class="form-control" id="template_description" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                            <button type="button" class="btn btn-primary" id="save-template-btn">Speichern</button>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary mt-4"
                    data-bs-toggle="modal"
                    data-bs-target="#saveTemplateModal">
                <i class="bi bi-bookmark"></i> Als Vorlage speichern
            </button>
        </form>

        {# Die Ziele der Knöpfe aus dem Editor-Formular: leere Formulare, angebunden über
           das form-Attribut. Sie stehen hier unten, weil HTML kein Formular in einem
           Formular erlaubt - der Anhang-Bereich und die Aktionsleiste liegen beide
           innerhalb des Editor-Formulars. #}
        <form id="newsletter-delete-form"
              method="post"
              action="/newsletters/{{ newsletter.id }}/delete"
              class="d-none"
              data-confirm="Diesen Newsletter-Entwurf wirklich löschen?"></form>

        <form id="attachment-upload-form"
              method="post"
              action="/newsletters/{{ newsletter.id }}/attachments"
              enctype="multipart/form-data"
              class="d-none"></form>

        {% for attachment in attachments %}
            <form id="attachment-mode-form-{{ attachment.id }}"
                  method="post"
                  action="/newsletters/{{ newsletter.id }}/attachments/{{ attachment.id }}/mode"
                  class="d-none"></form>
            <form id="attachment-delete-form-{{ attachment.id }}"
                  method="post"
                  action="/newsletters/{{ newsletter.id }}/attachments/{{ attachment.id }}/delete"
                  class="d-none"
                  data-confirm="Diese Datei wirklich entfernen?"></form>
        {% endfor %}

        <div class="modal fade"
             id="previewModal"
             tabindex="-1"
             aria-labelledby="previewModalLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="previewModalLabel">Newsletter-Vorschau</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe id="preview-modal-frame"
                                class="newsletter-preview-frame"
                                title="Newsletter-Vorschau"
                                sandbox="allow-popups allow-popups-to-escape-sandbox allow-downloads"></iframe>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
                    </div>
                </div>
            </div>
        </div>

        <form id="send-form"
              method="post"
              action="/newsletters/{{ newsletter.id }}/send"
              class="d-none">
        </form>
    </div>
{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
{% endblock styles %}

{% block scripts %}
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="{{ asset_path('/js/tom-select-init.js') }}"></script>
    <script src="{{ asset_path('/js/audience-filter.js') }}"></script>
    <script src="{{ asset_path('/js/newsletters-edit.js') }}"></script>
{% endblock scripts %}
