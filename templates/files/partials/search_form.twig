<form class="files-search-form" method="get" action="/files/search" role="search">
    <div class="input-group input-group-sm">
        <input class="form-control"
               type="search"
               name="q"
               value="{{ term }}"
               minlength="2"
               placeholder="Dateien suchen"
               aria-label="Dateien suchen">
        <button class="btn btn-outline-secondary" type="submit" aria-label="Suchen">
            <i class="bi bi-search" aria-hidden="true"></i>
        </button>
    </div>
</form>
