{% extends "layout.twig" %}
{% import "files/partials/macros.twig" as files_ui %}

{% block title %}
    {{ locked ? "Geschützte Datei" : file.name }} - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block content %}
    <div class="files-public-card card mx-auto">
        <div class="card-body text-center">
            {% if locked %}
                <i class="bi bi-lock fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
                <h1 class="h4">Diese Datei ist geschützt</h1>
                <p class="text-muted">Bitte das Passwort eingeben, das du mit dem Link bekommen hast.</p>
                {% if error %}
                    <div class="alert alert-danger">{{ error }}</div>
                {% endif %}
                <form method="post" action="/s/{{ token }}" class="text-start">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <label class="form-label" for="publicLinkPassword">Passwort</label>
                    <input class="form-control mb-3" id="publicLinkPassword" name="password" type="password" required autofocus>
                    <button class="btn btn-primary w-100" type="submit">Öffnen</button>
                </form>
            {% else %}
                <i class="bi {{ files_ui.icon(file.mime_type) }} fs-1 d-block mb-2" aria-hidden="true"></i>
                <h1 class="h4 text-break">{{ file.name }}</h1>
                <p class="text-muted">{{ files_ui.size(file.size) }}</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-primary" href="/s/{{ token }}/download">
                        <i class="bi bi-download me-1" aria-hidden="true"></i> Herunterladen
                    </a>
                    {% if previewable %}
                        <a class="btn btn-outline-secondary" href="/s/{{ token }}/view" target="_blank" rel="noopener">
                            <i class="bi bi-eye me-1" aria-hidden="true"></i> Im Browser ansehen
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock content %}
