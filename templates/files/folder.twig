{% extends "layout.twig" %}
{% import "files/partials/macros.twig" as files_ui %}

{% set can_upload = level >= 2 %}
{% set can_edit = level >= 3 %}
{% set can_manage = level >= 4 %}
{% set is_root = folder.parent_id is null %}
{% set current_url = "/files/folders/" ~ folder.id %}

{% block title %}
    {{ folder.name }} - Dateien - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div class="files-header-main">
            <nav aria-label="Ordnerpfad">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/files">Dateien</a></li>
                    {% for node in breadcrumb|slice(0, -1) %}
                        <li class="breadcrumb-item">
                            {% if node.linkable %}
                                <a href="/files/folders/{{ node.id }}">{{ node.name }}</a>
                            {% else %}
                                {{ node.name }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </nav>
            <h1 class="h2 mb-1">
                <i class="bi bi-folder2-open text-warning me-1" aria-hidden="true"></i>{{ folder.name }}
            </h1>
            <p class="text-muted mb-0 small">Deine Stufe: {{ level_labels[level] }}</p>
        </div>
        <div class="page-actions">
            {{ include("files/partials/search_form.twig", {term: ""}, false) }}
            {% if can_upload %}
                <button type="button" class="btn btn-primary btn-sm" data-files-pick>
                    <i class="bi bi-upload me-1" aria-hidden="true"></i> Hochladen
                </button>
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#filesNewFolderModal">
                    <i class="bi bi-folder-plus me-1" aria-hidden="true"></i> Neuer Ordner
                </button>
            {% endif %}
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    Ordner
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="/files/folders/{{ folder.id }}/zip">
                            <i class="bi bi-file-earmark-zip me-2" aria-hidden="true"></i>Als ZIP herunterladen
                        </a>
                    </li>
                    <li>
                        <form method="post" action="/files/favorites">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="type" value="folder">
                            <input type="hidden" name="id" value="{{ folder.id }}">
                            <input type="hidden" name="back" value="{{ current_url }}">
                            <button type="submit" class="dropdown-item">
                                {% if folder.id in favorite_folder_ids %}
                                    <i class="bi bi-star-fill text-warning me-2" aria-hidden="true"></i>Favorit entfernen
                                {% else %}
                                    <i class="bi bi-star me-2" aria-hidden="true"></i>Als Favorit anheften
                                {% endif %}
                            </button>
                        </form>
                    </li>
                    {% if can_manage %}
                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    data-bs-toggle="modal"
                                    data-bs-target="#filesSharesModal">
                                <i class="bi bi-people me-2" aria-hidden="true"></i>Freigaben
                            </button>
                        </li>
                    {% endif %}
                    {% if is_root and is_file_admin %}
                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    data-bs-toggle="modal"
                                    data-bs-target="#filesQuotaModal">
                                <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>Kontingent
                            </button>
                        </li>
                    {% endif %}
                    {% set _may_rename_folder = can_edit and (not is_root or is_file_admin) %}
                    {% if _may_rename_folder %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    data-files-rename
                                    data-action="/files/folders/{{ folder.id }}/rename"
                                    data-name="{{ folder.name }}">
                                <i class="bi bi-pencil me-2" aria-hidden="true"></i>Umbenennen
                            </button>
                        </li>
                        {% if not is_root %}
                            <li>
                                <button type="button"
                                        class="dropdown-item"
                                        data-files-move
                                        data-action="/files/folders/{{ folder.id }}/move">
                                    <i class="bi bi-arrow-right-square me-2" aria-hidden="true"></i>Verschieben
                                </button>
                            </li>
                        {% endif %}
                        <li>
                            <form method="post"
                                  action="/files/folders/{{ folder.id }}/delete"
                                  data-confirm="Ordner „{{ folder.name }}“ samt Inhalt in den Papierkorb legen?">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-trash3 me-2" aria-hidden="true"></i>In den Papierkorb
                                </button>
                            </form>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if is_root or root.quota_bytes %}
        <div class="mb-3">
            {{ files_ui.quota_bar(root_used_bytes, root.quota_bytes) }}
        </div>
    {% endif %}

    {% if subfolders is empty and files is empty %}
        <div class="alert alert-light border">Dieser Ordner ist leer.</div>
    {% endif %}

    {# Ordner stehen getrennt und immer alphabetisch über der Tabelle: Die
       Table-Engine sortiert alle Zeilen gemeinsam, nach Größe oder Datum
       landeten Ordner sonst mitten zwischen den Dateien. #}
    {% if subfolders is not empty %}
        <div class="files-folder-grid mb-3" aria-label="Unterordner">
            {% for child in subfolders %}
                <a class="files-folder-tile" href="/files/folders/{{ child.id }}">
                    <i class="bi bi-folder-fill text-warning" aria-hidden="true"></i>
                    <span class="files-folder-tile-name">{{ child.name }}</span>
                    {% if child.id in favorite_folder_ids %}
                        <i class="bi bi-star-fill text-warning" aria-label="Favorit"></i>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {% if files is not empty %}
        <div class="surface-card card border-0 table-shell"
             data-table-engine="true"
             data-table-id="files.folder"
             data-default-view="auto"
             data-default-page-size="50"
             data-page-size-options="25,50,100"
             data-default-sort-key="name"
             data-default-sort-dir="asc">
            {{ include("partials/table_toolbar.twig") }}
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-responsive-cards files-table">
                        <thead class="table-dark">
                            <tr>
                                <th data-sort-key="name" data-sort-type="text">Name</th>
                                <th data-sort-key="size" data-sort-type="number" class="text-end">Größe</th>
                                <th data-sort-key="changed" data-sort-type="date">Geändert</th>
                                <th class="text-end"><span class="visually-hidden">Aktionen</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for file in files %}
                                {% set _previewable = attachment_previewable(file.mime_type) %}
                                {% set _is_favorite = file.id in favorite_file_ids %}
                                <tr data-sort-name="{{ file.name|lower }}"
                                    data-sort-size="{{ file.size }}"
                                    data-sort-changed="{{ file.updated_at|date("Y-m-d H:i:s") }}">
                                    <td data-label="Name">
                                        {% if _previewable %}
                                            <button type="button"
                                                    class="btn btn-link p-0 text-start files-name"
                                                    data-attachment-preview
                                                    data-attachment-id="{{ file.id }}"
                                                    data-attachment-name="{{ file.name }}"
                                                    data-attachment-mime="{{ file.mime_type }}"
                                                    data-attachment-size="{{ file.size }}"
                                                    data-preview-url="/files/{{ file.id }}/preview"
                                                    data-download-url="/files/{{ file.id }}/download">
                                                <i class="bi {{ files_ui.icon(file.mime_type) }} me-2"
                                                   aria-hidden="true"></i>{{ file.name }}
                                            </button>
                                        {% else %}
                                            <a class="files-name" href="/files/{{ file.id }}/download">
                                                <i class="bi {{ files_ui.icon(file.mime_type) }} me-2"
                                                   aria-hidden="true"></i>{{ file.name }}
                                            </a>
                                        {% endif %}
                                        {% if _is_favorite %}
                                            <i class="bi bi-star-fill text-warning ms-1" aria-label="Favorit"></i>
                                        {% endif %}
                                    </td>
                                    <td data-label="Größe" class="text-end text-nowrap">{{ files_ui.size(file.size) }}</td>
                                    <td data-label="Geändert" class="small">
                                        {{ file.updated_at|date("d.m.Y H:i") }}
                                        {% if file.updater %}
                                            <span class="text-muted">· {{ file.updater|person_name }}</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Aktionen" class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    data-files-row-menu
                                                    aria-expanded="false"
                                                    aria-label="Aktionen für {{ file.name }}">
                                                <i class="bi bi-three-dots" aria-hidden="true"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" href="/files/{{ file.id }}">
                                                        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                                                        {{- can_manage ? "Details & Freigaben" : "Details" -}}
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="/files/{{ file.id }}/download">
                                                        <i class="bi bi-download me-2" aria-hidden="true"></i>Herunterladen
                                                    </a>
                                                </li>
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            data-files-versions
                                                            data-versions-url="/files/{{ file.id }}/versions"
                                                            data-name="{{ file.name }}"
                                                            data-can-restore="{{ can_edit ? "1" : "0" }}">
                                                        <i class="bi bi-clock-history me-2" aria-hidden="true"></i>Versionen
                                                    </button>
                                                </li>
                                                <li>
                                                    <form method="post" action="/files/favorites">
                                                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                        <input type="hidden" name="type" value="file">
                                                        <input type="hidden" name="id" value="{{ file.id }}">
                                                        <input type="hidden" name="back" value="{{ current_url }}">
                                                        <button type="submit" class="dropdown-item">
                                                            {% if _is_favorite %}
                                                                <i class="bi bi-star-fill text-warning me-2"
                                                                   aria-hidden="true"></i>Favorit entfernen
                                                            {% else %}
                                                                <i class="bi bi-star me-2"
                                                                   aria-hidden="true"></i>Als Favorit anheften
                                                            {% endif %}
                                                        </button>
                                                    </form>
                                                </li>
                                                {% if can_edit %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <button type="button"
                                                                class="dropdown-item"
                                                                data-files-rename
                                                                data-action="/files/{{ file.id }}/rename"
                                                                data-name="{{ file.name }}">
                                                            <i class="bi bi-pencil me-2" aria-hidden="true"></i>Umbenennen
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button"
                                                                class="dropdown-item"
                                                                data-files-move
                                                                data-action="/files/{{ file.id }}/move">
                                                            <i class="bi bi-arrow-right-square me-2"
                                                               aria-hidden="true"></i>Verschieben
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <form method="post"
                                                              action="/files/{{ file.id }}/delete"
                                                              data-confirm="„{{ file.name }}“ in den Papierkorb legen?">
                                                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                <i class="bi bi-trash3 me-2"
                                                                   aria-hidden="true"></i>In den Papierkorb
                                                            </button>
                                                        </form>
                                                    </li>
                                                {% endif %}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    {% if can_upload %}
        <div class="files-dropzone mt-3"
             data-files-dropzone
             data-upload-url="/files/folders/{{ folder.id }}/upload"
             data-max-bytes="{{ max_upload_bytes }}"
             data-can-replace="{{ can_edit ? "1" : "0" }}">
            <input type="file" class="visually-hidden" multiple data-files-input aria-label="Dateien auswählen">
            <i class="bi bi-cloud-arrow-up fs-3 d-block mb-1" aria-hidden="true"></i>
            <span>
                Dateien hierher ziehen oder
                <button type="button" class="btn btn-link p-0 align-baseline" data-files-pick>auswählen</button>
            </span>
            <small class="d-block text-muted">Höchstens {{ files_ui.size(max_upload_bytes) }} je Datei.</small>
            <ul class="list-unstyled files-upload-list mt-2 mb-0" data-files-progress></ul>
        </div>
    {% endif %}

    {{ include("files/partials/folder_modals.twig") }}
{% endblock content %}

{% block scripts %}
    <script src="{{ asset_path("/js/file-manager.js") }}"></script>
{% endblock scripts %}
