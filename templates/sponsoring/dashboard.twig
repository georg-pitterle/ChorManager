{% extends "layout.twig" %}

{% import "macros/help.twig" as help %}

{% block title %}
    Sponsoring - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Sponsoring</h1>
            {# Die Lage in einem Satz statt in vier Kennzahl-Karten: wer die Seite
               öffnet, will wissen, was zu tun ist, nicht eine Kachelwand lesen. #}
            <p class="text-muted mb-0 sponsoring-summary">
                {{ total_active }} {{ total_active == 1 ? "Zusage" : "Zusagen" }}
                {% if sees_totals %}
                    über <strong>{{ total_amount|number_format(2, ",", ".") }} €</strong>,
                    davon {{ unpaid_amount|number_format(2, ",", ".") }} € noch nicht bezahlt.
                    Angefragt: {{ requested_amount|number_format(2, ",", ".") }} €.
                {% else %}
                    im Verein. Beträge sieht die Sponsoring-Verwaltung.
                {% endif %}
            </p>
        </div>
        <div class="page-actions">
            {{ help.button("sponsoring", "Sponsoring") }}
            <a href="/sponsoring/sponsors" class="btn btn-primary">Sponsor suchen oder anlegen</a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {{ include("sponsoring/partials/subnav.twig", {subnav_active: "overview"}) }}

    <div class="sponsoring-board">
        <section class="sponsoring-panel" aria-labelledby="sponsoring-followups-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-followups-title">Wiedervorlagen</h2>
                <span class="sponsoring-panel-count">{{ upcoming_follow_ups|length }}</span>
            </header>
            <p class="sponsoring-panel-lead">
                {% if shows_own_only %}
                    Deine Wiedervorlagen und die deiner Vereinbarungen, fällig in den nächsten 7 Tagen.
                {% else %}
                    Alles, was in den nächsten 7 Tagen fällig ist - Überfälliges zuerst.
                {% endif %}
            </p>
            {% if upcoming_follow_ups|length > 0 %}
                <ul class="work-list">
                    {% for contact in upcoming_follow_ups %}
                        <li class="work-item">
                            <div class="work-item-main">
                                <div class="work-item-title">
                                    {% if contact.sponsor_url %}
                                        <a href="{{ contact.sponsor_url }}">{{ contact.sponsor_name }}</a>
                                    {% else %}
                                        {{ contact.sponsor_name }}
                                    {% endif %}
                                    <span class="due-chip due-chip--{{ contact.due_state }}">{{ contact.due_label }}</span>
                                </div>
                                {% if contact.summary %}
                                    <p class="work-item-text">{{ contact.summary }}</p>
                                {% endif %}
                                <p class="work-item-meta">
                                    {{ contact.follow_up_date_display }}
                                    {% if contact.agreement_package_name != "-" %}
                                        · {{ contact.project_name ?? "Ohne Projekt" }}, {{ contact.agreement_package_name }},
                                        {{ contact.agreement_status_label }}
                                        {% if contact.agreement_amount_display != "-" %}
                                            · {{ contact.agreement_amount_display }}
                                        {% endif %}
                                    {% endif %}
                                    · {{ contact.owner_name }}
                                </p>
                            </div>
                            <form method="post" action="{{ contact.mark_done_url }}" class="work-item-action">
                                <button type="submit" class="btn btn-sm btn-outline-success">Erledigt</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Keine Wiedervorlagen in den nächsten 7 Tagen vorhanden.</p>
            {% endif %}
        </section>

        <section class="sponsoring-panel" aria-labelledby="sponsoring-benefits-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-benefits-title">Offene Gegenleistungen</h2>
                <span class="sponsoring-panel-count">{{ open_benefits|reduce((carry, row) => carry + row.benefits|length, 0) }}</span>
            </header>
            <p class="sponsoring-panel-lead">
                Was der Verein zugesagten Sponsoren noch schuldet - zuerst, was bald endet.
            </p>
            {% if open_benefits|length > 0 %}
                <ul class="work-list">
                    {% for row in open_benefits %}
                        <li class="work-item work-item--stacked">
                            <div class="work-item-title">
                                <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                {% if row.package_name %}
                                    <span class="badge {{ row.package_badge }}">{{ row.package_name }}</span>
                                {% endif %}
                            </div>
                            <p class="work-item-meta">
                                {{ row.project_name }}{% if row.end_date_display %} · bis {{ row.end_date_display }}{% endif %}
                            </p>
                            {{ include("sponsoring/partials/benefit_list.twig", {benefits: row.benefits}) }}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Alle zugesagten Gegenleistungen sind erbracht.</p>
            {% endif %}
        </section>

        {% if sees_totals %}
            <section class="sponsoring-panel" aria-labelledby="sponsoring-unpaid-title">
                <header class="sponsoring-panel-head">
                    <h2 class="sponsoring-panel-title" id="sponsoring-unpaid-title">Zahlung offen</h2>
                    <span class="sponsoring-panel-count">{{ unpaid|length }}</span>
                </header>
                <p class="sponsoring-panel-lead">Zusagen, bei denen das Geld noch nicht eingegangen ist.</p>
                {% if unpaid|length > 0 %}
                    <ul class="work-list">
                        {% for row in unpaid %}
                            <li class="work-item">
                                <div class="work-item-main">
                                    <div class="work-item-title">
                                        <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                    </div>
                                    <p class="work-item-meta">{{ row.project_name }}</p>
                                </div>
                                <span class="work-item-amount">{{ row.amount|number_format(2, ",", ".") }} €</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="sponsoring-panel-empty">Alle Zusagen sind bezahlt.</p>
                {% endif %}
            </section>
        {% endif %}

        <section class="sponsoring-panel" aria-labelledby="sponsoring-contacts-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-contacts-title">Letzte Kontakte</h2>
            </header>
            <p class="sponsoring-panel-lead">
                {% if shows_own_only %}
                    Deine zuletzt protokollierten Gespräche.
                {% else %}
                    Die zuletzt protokollierten Gespräche mit Sponsoren.
                {% endif %}
            </p>
            {% if recent_contacts|length > 0 %}
                <ul class="work-list">
                    {% for contact in recent_contacts %}
                        <li class="work-item work-item--stacked">
                            <div class="work-item-title">
                                {% if contact.sponsor_url %}
                                    <a href="{{ contact.sponsor_url }}">{{ contact.sponsor_name }}</a>
                                {% else %}
                                    {{ contact.sponsor_name }}
                                {% endif %}
                            </div>
                            {% if contact.summary %}
                                <p class="work-item-text">{{ contact.summary }}</p>
                            {% endif %}
                            <p class="work-item-meta">
                                {{ contact.contact_date_display }} · {{ contact.contact_type_label }} · {{ contact.owner_name }}
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Noch keine Kontakte protokolliert.</p>
            {% endif %}
        </section>
    </div>
{% endblock content %}
