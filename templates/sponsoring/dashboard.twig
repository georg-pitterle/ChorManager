{% extends "layout.twig" %}

{% import "macros/help.twig" as help %}

{% block title %}
    Sponsoring - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Sponsoring</h1>
            {# Die Lage in einem Satz statt in vier Kennzahl-Karten: wer die Seite
               öffnet, will wissen, was zu tun ist, nicht eine Kachelwand lesen. #}
            <p class="text-muted mb-0 sponsoring-summary">
                {{ total_active }} {{ total_active == 1 ? "Zusage" : "Zusagen" }}
                {% if sees_totals %}
                    über <strong>{{ total_amount|number_format(2, ",", ".") }} €</strong>,
                    davon {{ unpaid_amount|number_format(2, ",", ".") }} € noch nicht bezahlt.
                    Angefragt: {{ requested_amount|number_format(2, ",", ".") }} €.
                {% else %}
                    im Verein. Beträge sieht die Sponsoring-Verwaltung.
                {% endif %}
            </p>
        </div>
        <div class="page-actions">
            {{ help.button("sponsoring", "Sponsoring") }}
            <a href="/sponsoring/sponsors" class="btn btn-primary">Sponsor suchen oder anlegen</a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {{ include("sponsoring/partials/subnav.twig", {subnav_active: "overview"}) }}

    <div class="sponsoring-board">
        {% if can_manage_all %}
            {# Die Personen stehen in jeder Zeile: einmal bauen statt je Zeile neu. #}
            {% set _assignee_options %}
                <option value="">Person wählen</option>
                {% for person in assignable_users %}
                    <option value="{{ person.id }}">{{ person|person_name }}</option>
                {% endfor %}
            {% endset %}
            <section class="sponsoring-panel" aria-labelledby="sponsoring-unassigned-title">
                <header class="sponsoring-panel-head">
                    <h2 class="sponsoring-panel-title" id="sponsoring-unassigned-title">Ohne Zuständigkeit</h2>
                    <span class="sponsoring-panel-count">{{ unassigned|length }}</span>
                </header>
                <p class="sponsoring-panel-lead">
                    Laufende Vorgänge, um die sich niemand kümmert - Zusagen zuerst.
                </p>
                {% if unassigned|length > 0 %}
                    <ul class="work-list">
                        {% for row in unassigned %}
                            <li class="work-item work-item--assign">
                                <div class="work-item-main">
                                    <div class="work-item-title">
                                        <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                        <span class="badge {{ row.status_badge }}">{{ row.status_label }}</span>
                                    </div>
                                    <p class="work-item-meta">
                                        {{ row.project_name }}{% if row.package_name %} · {{ row.package_name }}{% endif %}
                                        {% if row.former_assignee_name %}
                                            · bisher {{ row.former_assignee_name }}, nicht mehr aktiv
                                        {% endif %}
                                    </p>
                                </div>
                                <form method="post" action="{{ row.assign_url }}" class="work-item-assign">
                                    <label class="visually-hidden" for="assignee-{{ loop.index }}">
                                        Zuständige Person für {{ row.sponsor_name }}
                                    </label>
                                    <select name="assigned_user_id"
                                            class="form-select form-select-sm"
                                            required
                                            id="assignee-{{ loop.index }}">{{ _assignee_options }}</select>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Zuweisen</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="sponsoring-panel-empty">Jeder laufende Vorgang hat eine zuständige Person.</p>
                {% endif %}
            </section>
        {% endif %}

        <section class="sponsoring-panel" aria-labelledby="sponsoring-logos-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-logos-title">Logo fehlt</h2>
                <span class="sponsoring-panel-count">{{ missing_logos|length }}</span>
            </header>
            <p class="sponsoring-panel-lead">
                Zugesagte Sponsoren, deren Logo für Druck oder online noch fehlt - zuerst, was am frühesten gebraucht wird.
            </p>
            {% if missing_logos|length > 0 %}
                <ul class="work-list">
                    {% for row in missing_logos %}
                        <li class="work-item work-item--stacked logo-deadline-{{ row.urgency }}">
                            <div class="work-item-title">
                                <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                <span class="badge text-bg-light border">{{ row.kind == "print" ? "Druck" : "online" }}</span>
                            </div>
                            <p class="work-item-meta">
                                {% if row.deadline %}
                                    bis {{ row.deadline }}
                                    {% if row.urgency == "overdue" %}<span class="due-chip due-chip--overdue">überfällig</span>{% endif %}
                                    {% if row.urgency == "soon" %}<span class="due-chip due-chip--soon">bald</span>{% endif %}
                                {% else %}
                                    ohne Frist
                                {% endif %}
                                · {{ row.project_name|default("Ohne Projekt") }}
                                · Zuständig: {{ row.assignees ? row.assignees|join(", ") : "niemand" }}
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Von allen zugesagten Sponsoren mit Logo-Bedarf liegt das Logo vor.</p>
            {% endif %}

            {% if logo_deadline_projects|length > 0 %}
                <details class="logo-deadline-settings">
                    <summary>Logo-Fristen der Projekte</summary>
                    {% for project in logo_deadline_projects %}
                        <form method="post" action="/sponsoring/projects/{{ project.id }}/logo-deadlines" class="logo-deadline-form">
                            <h3 class="group-label">{{ project.name }}</h3>
                            <div class="row g-2 align-items-end">
                                <div class="col-sm-5">
                                    <label for="logo-deadline-print-{{ project.id }}" class="form-label">Druck</label>
                                    <input type="date"
                                           name="logo_deadline_print"
                                           class="form-control form-control-sm"
                                           value="{{ project.logo_deadline_print ? project.logo_deadline_print.format("Y-m-d") : "" }}"
                                           id="logo-deadline-print-{{ project.id }}">
                                </div>
                                <div class="col-sm-5">
                                    <label for="logo-deadline-online-{{ project.id }}" class="form-label">Online</label>
                                    <input type="date"
                                           name="logo_deadline_online"
                                           class="form-control form-control-sm"
                                           value="{{ project.logo_deadline_online ? project.logo_deadline_online.format("Y-m-d") : "" }}"
                                           id="logo-deadline-online-{{ project.id }}">
                                </div>
                                <div class="col-sm-2">
                                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">Speichern</button>
                                </div>
                            </div>
                        </form>
                    {% endfor %}
                </details>
            {% endif %}
        </section>

        <section class="sponsoring-panel" aria-labelledby="sponsoring-followups-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-followups-title">Wiedervorlagen</h2>
                <span class="sponsoring-panel-count">{{ upcoming_follow_ups|length }}</span>
            </header>
            <p class="sponsoring-panel-lead">
                {% if shows_own_only %}
                    Deine Wiedervorlagen und die deiner Vorgänge, fällig in den nächsten 7 Tagen.
                {% else %}
                    Alles, was in den nächsten 7 Tagen fällig ist - Überfälliges zuerst.
                {% endif %}
            </p>
            {% if upcoming_follow_ups|length > 0 %}
                <ul class="work-list">
                    {% for contact in upcoming_follow_ups %}
                        <li class="work-item">
                            <div class="work-item-main">
                                <div class="work-item-title">
                                    {% if contact.sponsor_url %}
                                        <a href="{{ contact.sponsor_url }}">{{ contact.sponsor_name }}</a>
                                    {% else %}
                                        {{ contact.sponsor_name }}
                                    {% endif %}
                                    <span class="due-chip due-chip--{{ contact.due_state }}">{{ contact.due_label }}</span>
                                </div>
                                {% if contact.summary %}
                                    <p class="work-item-text">{{ contact.summary }}</p>
                                {% endif %}
                                <p class="work-item-meta">
                                    {{ contact.follow_up_date_display }}
                                    {% if contact.agreement_package_name != "-" %}
                                        · {{ contact.project_name ?? "Ohne Projekt" }}, {{ contact.agreement_package_name }},
                                        {{ contact.agreement_status_label }}
                                        {% if contact.agreement_amount_display != "-" %}
                                            · {{ contact.agreement_amount_display }}
                                        {% endif %}
                                        · Zuständig: {{ contact.assignee_name ?? "niemand" }}
                                    {% endif %}
                                    · von {{ contact.owner_name }}
                                </p>
                            </div>
                            <form method="post" action="{{ contact.mark_done_url }}" class="work-item-action">
                                <button type="submit" class="btn btn-sm btn-outline-success">Erledigt</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Keine Wiedervorlagen in den nächsten 7 Tagen vorhanden.</p>
            {% endif %}
        </section>

        <section class="sponsoring-panel" aria-labelledby="sponsoring-benefits-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-benefits-title">Offene Gegenleistungen</h2>
                <span class="sponsoring-panel-count">{{ open_benefits|reduce((carry, row) => carry + row.benefits|length, 0) }}</span>
            </header>
            <p class="sponsoring-panel-lead">
                Was der Verein zugesagten Sponsoren noch schuldet - zuerst, was bald endet.
            </p>
            {% if open_benefits|length > 0 %}
                <ul class="work-list">
                    {% for row in open_benefits %}
                        <li class="work-item work-item--stacked">
                            <div class="work-item-title">
                                <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                {% if row.package_name %}
                                    <span class="badge {{ row.package_badge }}">{{ row.package_name }}</span>
                                {% endif %}
                            </div>
                            <p class="work-item-meta">
                                {{ row.project_name }}{% if row.end_date_display %} · bis {{ row.end_date_display }}{% endif %}
                                · Zuständig: {{ row.assignee_name ?? "niemand" }}
                            </p>
                            {{ include("sponsoring/partials/benefit_list.twig", {benefits: row.benefits}) }}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Alle zugesagten Gegenleistungen sind erbracht.</p>
            {% endif %}
        </section>

        <section class="sponsoring-panel" aria-labelledby="sponsoring-deliverables-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-deliverables-title">Offene Leistungen des Sponsors</h2>
                <span class="sponsoring-panel-count">{{ open_deliverables|reduce((carry, row) => carry + row.benefits|length, 0) }}</span>
            </header>
            <p class="sponsoring-panel-lead">
                Was zugesagte Sponsoren noch liefern - Banner, Vertrag, Sachleistung.
            </p>
            {% if open_deliverables|length > 0 %}
                <ul class="work-list">
                    {% for row in open_deliverables %}
                        <li class="work-item work-item--stacked">
                            <div class="work-item-title">
                                <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                {% if row.package_name %}
                                    <span class="badge {{ row.package_badge }}">{{ row.package_name }}</span>
                                {% endif %}
                            </div>
                            <p class="work-item-meta">
                                {{ row.project_name }}{% if row.end_date_display %} · bis {{ row.end_date_display }}{% endif %}
                                · Zuständig: {{ row.assignee_name ?? "niemand" }}
                            </p>
                            {{ include("sponsoring/partials/benefit_list.twig", {benefits: row.benefits, field: "received", done_word: "erhalten"}) }}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Von den zugesagten Sponsoren steht nichts mehr aus.</p>
            {% endif %}
        </section>

        {% if sees_totals %}
            <section class="sponsoring-panel" aria-labelledby="sponsoring-unpaid-title">
                <header class="sponsoring-panel-head">
                    <h2 class="sponsoring-panel-title" id="sponsoring-unpaid-title">Zahlung offen</h2>
                    <span class="sponsoring-panel-count">{{ unpaid|length }}</span>
                </header>
                <p class="sponsoring-panel-lead">Zusagen, bei denen das Geld noch nicht eingegangen ist.</p>
                {% if unpaid|length > 0 %}
                    <ul class="work-list">
                        {% for row in unpaid %}
                            <li class="work-item">
                                <div class="work-item-main">
                                    <div class="work-item-title">
                                        <a href="{{ row.sponsor_url }}">{{ row.sponsor_name }}</a>
                                    </div>
                                    <p class="work-item-meta">
                                        {{ row.project_name }} · Zuständig: {{ row.assignee_name ?? "niemand" }}
                                    </p>
                                </div>
                                <span class="work-item-amount">{{ row.amount|number_format(2, ",", ".") }} €</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="sponsoring-panel-empty">Alle Zusagen sind bezahlt.</p>
                {% endif %}
            </section>
        {% endif %}

        <section class="sponsoring-panel" aria-labelledby="sponsoring-contacts-title">
            <header class="sponsoring-panel-head">
                <h2 class="sponsoring-panel-title" id="sponsoring-contacts-title">Letzte Kontakte</h2>
            </header>
            <p class="sponsoring-panel-lead">
                {% if shows_own_only %}
                    Deine zuletzt protokollierten Gespräche.
                {% else %}
                    Die zuletzt protokollierten Gespräche mit Sponsoren.
                {% endif %}
            </p>
            {% if recent_contacts|length > 0 %}
                <ul class="work-list">
                    {% for contact in recent_contacts %}
                        <li class="work-item work-item--stacked">
                            <div class="work-item-title">
                                {% if contact.sponsor_url %}
                                    <a href="{{ contact.sponsor_url }}">{{ contact.sponsor_name }}</a>
                                {% else %}
                                    {{ contact.sponsor_name }}
                                {% endif %}
                            </div>
                            {% if contact.summary %}
                                <p class="work-item-text">{{ contact.summary }}</p>
                            {% endif %}
                            <p class="work-item-meta">
                                {{ contact.contact_date_display }} · {{ contact.contact_type_label }} · {{ contact.owner_name }}
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="sponsoring-panel-empty">Noch keine Kontakte protokolliert.</p>
            {% endif %}
        </section>
    </div>
{% endblock content %}
