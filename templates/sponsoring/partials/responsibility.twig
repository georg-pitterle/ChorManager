{# Wer sich um einen Sponsor kümmert, aus SponsorResponsibility: die Personen der
   laufenden Vorgänge, dahinter die Lücke. Neben einer Person sagt die Lücke, wie
   viel fehlt - ein bloßes "niemand" stünde dort im Widerspruch zum Namen.

   Parameter:
     responsibility  {assignees: list<User>, unassigned: int} #}
{% set _unassigned = responsibility.unassigned %}
{% set _has_people = responsibility.assignees|length > 0 %}
{% if _has_people %}
    {{ responsibility.assignees|map(person => person|person_name)|join(", ") }}
{% endif %}
{% if _unassigned > 0 and _has_people %}
    <span class="badge text-bg-warning">{{ _unassigned }} {{ _unassigned == 1 ? "Vorgang" : "Vorgänge" }} ohne</span>
{% elseif _unassigned > 0 %}
    <span class="badge text-bg-warning">niemand</span>
{% elseif not _has_people %}
    <span class="text-muted">–</span>
{% endif %}
