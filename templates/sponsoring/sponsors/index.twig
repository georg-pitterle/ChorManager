{% extends "layout.twig" %}

{% import "macros/help.twig" as help %}

{% block title %}
    Sponsoren - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">
                Sponsoren
            </h1>
            <p class="text-muted mb-0">Vor einer Anfrage nachsehen, ob schon jemand an der Firma dran ist.</p>
        </div>
        <div class="page-actions">
            {{ help.button("sponsoring-sponsors", "Sponsoren verwalten") }}
            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#createSponsorModal">
                Neuer Sponsor
            </button>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {{ include("sponsoring/partials/subnav.twig", {subnav_active: "sponsors"}) }}

    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Schließen"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Schließen"></button>
        </div>
    {% endif %}

    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context"
                 aria-labelledby="sponsor-list-title">
            <div class="dashboard-section-head">
                <h2 class="dashboard-section-title" id="sponsor-list-title">Sponsorenübersicht</h2>
                <p class="dashboard-section-lead mb-0">
                    {{ sponsors|length }} {{ sponsors|length == 1 ? "Sponsor" : "Sponsoren" }}. Der Zustandsfilter steht in der Tabellenleiste.
                </p>
            </div>

            <div class="surface-card table-shell"
                 data-table-engine="true"
                 data-table-id="sponsoring.sponsors.index"
                 data-table-plugins="sponsorState"
                 data-state-options="{{ state_options|json_encode|e('html_attr') }}"
                 data-default-view="auto"
                 data-default-page-size="100"
                 data-page-size-options="25,50,100,200"
                 data-default-sort-key="sponsor_name">
                {{ include('partials/table_toolbar.twig') }}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-responsive-cards"
                           id="sponsorsTable">
                        <thead class="table-light">
                            <tr>
                                <th data-sort-key="sponsor_name" data-sort-type="text">Name</th>
                                <th data-sort-key="state" data-sort-type="text">Zustand</th>
                                <th data-sort-key="package" data-sort-type="text">Paket</th>
                                {% if sees_totals %}
                                    <th data-sort-key="accepted_amount" data-sort-type="number" class="text-end">Zugesagt</th>
                                {% endif %}
                                <th data-sort-key="next_follow_up" data-sort-type="date">Nächste Frist</th>
                                <th>Kontakt</th>
                                <th data-sort-key="sponsorship_count" data-sort-type="number">Vereinbarungen</th>
                                <th class="text-end">Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for sponsor in sponsors %}
                                {% set sponsor_state = sponsor_states[sponsor.id] %}
                                {% set row = sponsor_rows[sponsor.id] %}
                                <tr data-sort-sponsor_name="{{ sponsor.name|lower }}"
                                    data-sort-package="{{ row.package_name|default("")|lower }}"
                                    data-sort-accepted_amount="{{ row.accepted_amount|default(0) }}"
                                    data-sort-next_follow_up="{{ row.next_follow_up_sort }}"
                                    data-sort-state="{{ sponsor_state }}"
                                    data-state="{{ sponsor_state }}"
                                    data-sort-sponsorship_count="{{ sponsor.sponsorships|length }}">
                                    <td data-label="Name" data-card-title>
                                        <a href="/sponsoring/sponsors/{{ sponsor.id }}"
                                           class="text-decoration-none">{{ sponsor.name }}</a>
                                        <div class="text-muted small">
                                            {{ sponsor.type == "organization" ? "Organisation" : "Einzelperson" }}{% if sponsor.contact_person %} · {{ sponsor.contact_person }}{% endif %}
                                        </div>
                                    </td>
                                    <td data-label="Zustand">
                                        <span class="badge {{ state_badges[sponsor_state] }}">{{ state_labels[sponsor_state] }}</span>
                                    </td>
                                    <td data-label="Paket">
                                        {% if row.package_name %}
                                            <span class="badge {{ row.package_badge }}">{{ row.package_name }}</span>
                                        {% else %}
                                            <span class="text-muted">–</span>
                                        {% endif %}
                                    </td>
                                    {% if sees_totals %}
                                        <td data-label="Zugesagt" class="text-end text-nowrap amount-cell">
                                            {{ row.accepted_amount > 0 ? row.accepted_amount|number_format(2, ",", ".") ~ " €" : "–" }}
                                        </td>
                                    {% endif %}
                                    <td data-label="Nächste Frist" class="text-nowrap">
                                        {% if row.next_follow_up_display %}
                                            {{ row.next_follow_up_display }}
                                            {% if row.next_follow_up_overdue %}<span class="due-chip due-chip--overdue">überfällig</span>{% endif %}
                                        {% else %}
                                            <span class="text-muted">–</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Kontakt" class="small">
                                        {% if sponsor.phone %}<a href="tel:{{ sponsor.phone|replace({" ": "", "/": "", "-": ""}) }}" class="d-block text-nowrap">{{ sponsor.phone }}</a>{% endif %}
                                        {% if sponsor.email %}<a href="mailto:{{ sponsor.email }}" class="d-block text-truncate">{{ sponsor.email }}</a>{% endif %}
                                        {% if not sponsor.phone and not sponsor.email %}<span class="text-muted">–</span>{% endif %}
                                    </td>
                                    <td data-label="Vereinbarungen"
                                        data-sort-key="sponsorship_count"
                                        data-sort-value="{{ sponsor.sponsorships|length }}">
                                        <span class="badge text-bg-light border">{{ sponsor.sponsorships|length }}</span>
                                    </td>
                                    <td data-label="Aktionen" class="text-end text-nowrap">
                                        <div class="btn-group"
                                             role="group"
                                             aria-label="Aktionen für Sponsor {{ sponsor.name }}">
                                            <a href="/sponsoring/sponsors/{{ sponsor.id }}"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Öffnen">
                                                Öffnen
                                            </a>
                                            {% if can_manage_all %}
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false"
                                                        data-bs-boundary="viewport">
                                                    <span class="visually-hidden">Weitere Aktionen</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <form method="post"
                                                              action="/sponsoring/sponsors/{{ sponsor.id }}/delete"
                                                              data-confirm="Sponsor {{ sponsor.name }} wirklich löschen? Alle verknüpften Daten werden ebenfalls gelöscht.">
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                <i class="bi bi-trash me-2" aria-hidden="true"></i> Löschen
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ sees_totals ? 8 : 7 }}" class="text-center text-muted py-4">
                                        Noch keine Sponsoren. Mit „Neuer Sponsor“ legst du den ersten an.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    {# Modal: Neuer Sponsor #}
    <div class="modal fade"
         id="createSponsorModal"
         tabindex="-1"
         aria-labelledby="createSponsorModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <form method="post" action="/sponsoring/sponsors">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <h5 class="modal-title" id="createSponsorModalLabel">Neuer Sponsor</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Schließen"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="sponsors-index-type" class="form-label">Typ</label>
                                <select name="type" class="form-select" id="sponsors-index-type">
                                    <option value="organization">Organisation oder Firma</option>
                                    <option value="person">Einzelperson</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="create_sponsor_requests_blocked"
                                           name="requests_blocked"
                                           value="1"
                                           data-reveals="#create-sponsor-blocked-note-field">
                                    <label class="form-check-label" for="create_sponsor_requests_blocked">Keine Anfragen erwünscht</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label for="sponsors-index-name" class="form-label">
                                    Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" name="name" class="form-control" required id="sponsors-index-name">
                            </div>
                            <div class="col-md-6">
                                <label for="sponsors-index-contact-person" class="form-label">Kontaktperson</label>
                                <input type="text" name="contact_person" class="form-control" id="sponsors-index-contact-person">
                            </div>
                            <div class="col-md-6">
                                <label for="sponsors-index-email" class="form-label">E-Mail</label>
                                <input type="email" name="email" class="form-control" id="sponsors-index-email">
                            </div>
                            <div class="col-md-6">
                                <label for="sponsors-index-phone" class="form-label">Telefon</label>
                                <input type="tel" name="phone" class="form-control" id="sponsors-index-phone">
                            </div>
                            <div class="col-md-6">
                                <label for="sponsors-index-website" class="form-label">Website</label>
                                <input type="url"
                                       name="website"
                                       class="form-control"
                                       placeholder="https://..."
                                       id="sponsors-index-website">
                            </div>
                            <div class="col-12">
                                <label for="sponsors-index-address" class="form-label">Adresse</label>
                                <textarea name="address" class="form-control" rows="2" id="sponsors-index-address"></textarea>
                            </div>
                            <div class="col-12 d-none" id="create-sponsor-blocked-note-field">
                                <label for="sponsors-index-requests-blocked-note" class="form-label">Warum keine Anfragen mehr?</label>
                                <textarea name="requests_blocked_note"
                                          class="form-control"
                                          rows="2"
                                          id="sponsors-index-requests-blocked-note"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-primary">
                            Anlegen
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock content %}

{% block scripts %}
    {{ parent() }}
    <script src="/js/table-plugins/sponsors-state-plugin.js"></script>
    <script src="/js/sponsorship-form.js"></script>
{% endblock scripts %}
