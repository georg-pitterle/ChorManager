<!DOCTYPE html>
<html lang="de" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#1f3a5f">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="default">
        <meta name="csrf-token" content="{{ csrf_token }}">
        {# Setzt den gemerkten Zustand der Seitenleiste, bevor gezeichnet wird - sonst springt die Leiste beim Laden. #}
        <script src="{{ asset_path('/js/navigation-state.js') }}"></script>
        {% if upload_limits is defined %}
            <meta name="upload-limits" content="{{ upload_limits|json_encode }}">
        {% endif %}
        <meta name="description"
              content="{{ app_settings.app_description|default('Chor-Manager – Verwaltung von Mitgliedern, Terminen und Projekten.') }}">
        <meta name="keywords"
              content="{{ app_settings.app_keywords|default('chor, chorverwaltung, mitglieder, termine, projekte, newsletter') }}">
        <title>
            {% block title %}
                {{ app_settings.app_name|default('Chor-Manager') }}
            {% endblock title %}
        </title>
        <link rel="manifest" href="/manifest.webmanifest">
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
        <!-- Bootstrap CSS -->
        <link rel="stylesheet" href="/vendor/bootstrap/dist/css/bootstrap.min.css">
        <!-- Bootstrap Icons -->
        <link rel="stylesheet"
              href="/vendor/bootstrap-icons/font/bootstrap-icons.css">
        <link rel="stylesheet" href="{{ asset_path('/css/style.css') }}">
        <link rel="stylesheet" href="{{ asset_path('/theme.css') }}">
        <link rel="stylesheet" href="{{ asset_path('/css/table-engine.css') }}">
        {% block styles %}
        {% endblock styles %}
    </head>
    {% set _sidebar_class = session.user_id ? " app-shell--with-sidebar" : "" %}
    <body class="app-shell{{ _sidebar_class }}">
        {% if session.user_id %}
            {% set navigation = navigation(active_nav|default("")) %}
            <header class="navbar navbar-dark bg-dark fixed-top app-topbar">
                <div class="container-fluid app-topbar__inner">
                    <button type="button"
                            class="app-topbar__menu-toggle"
                            data-nav-toggle
                            aria-controls="app-sidebar"
                            aria-expanded="true"
                            aria-label="Menü ein- und ausklappen">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <a class="navbar-brand d-flex align-items-center" href="/dashboard">
                        <img src="/logo"
                             alt="Logo"
                             width="200"
                             height="64"
                             class="me-2 navbar-logo">
                        <span class="app-topbar__brand-name">{{ app_settings.app_name|default("Chor-Manager") }}</span></a>
                    <div class="app-topbar__actions">
                        <button type="button"
                                class="app-topbar__search"
                                data-nav-search-open
                                aria-haspopup="dialog"
                                aria-controls="nav-search-modal"
                                title="Seite suchen (Strg+K)">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <span class="app-topbar__search-label">Seite suchen …</span>
                            <kbd class="app-topbar__search-kbd">Strg K</kbd>
                        </button>
                        {{ include("partials/navigation/user_menu.twig", [], false) }}
                    </div>
                </div>
            </header>
            {{ include("partials/navigation/sidebar.twig", {navigation: navigation}, false) }}
            {{ include("partials/navigation/search_modal.twig", [], false) }}
        {% endif %}
        <main class="app-main container-fluid">
            {% block page_header %}
            {% endblock page_header %}
            <div class="app-content container-xl">
                {{ include("partials/flash.twig", [], false) }}
                {% block content %}
                {% endblock content %}
            </div>
        </main>
        {{ include("partials/attachment_preview_modal.twig", [], false) }}
        <!-- Bootstrap JS Bundle -->
        <script src="/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ asset_path('/js/table-preferences.js') }}"></script>
        <script src="{{ asset_path('/js/table-engine.js') }}"></script>
        <script src="{{ asset_path('/js/table-plugins/users-manage-plugin.js') }}"></script>
        <script src="{{ asset_path('/js/table-plugins/users-group-plugin.js') }}"></script>
        <script src="{{ asset_path('/js/common.js') }}"></script>
        <script src="{{ asset_path('/js/upload-helper.js') }}"></script>
        <script src="{{ asset_path('/js/attachment-preview.js') }}"></script>
        {% if session.user_id %}
            <script src="{{ asset_path('/js/mail-badge.js') }}"></script>
            <script src="{{ asset_path('/js/navigation.js') }}"></script>
            <script src="{{ asset_path('/js/navigation-search-rank.js') }}"></script>
            <script src="{{ asset_path('/js/navigation-search.js') }}"></script>
        {% endif %}
        <script src="/vendor/tinymce/tinymce/tinymce.min.js"></script>
        <script src="{{ asset_path('/js/tinymce-init.js') }}"></script>
        {% block scripts %}
        {% endblock scripts %}
    </body>
</html>
