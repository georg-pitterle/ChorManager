{% extends "layout.twig" %}

{% block title %}
    Backups - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Backups</h1>
            <p class="text-muted mb-0">
                Backups der Datenbank und der Dateiverwaltung erstellen, herunterladen und wiederherstellen.
            </p>
        </div>
        <div class="page-actions">
            <form method="post" action="/backups">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button type="submit" class="btn btn-primary">
                    Backup erstellen
                </button>
            </form>
        </div>
    </section>
{% endblock page_header %}

{% block content %}

    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Eine Wiederherstellung überschreibt die gesamte Datenbank und beendet alle aktiven Sitzungen, auch Ihre eigene.
        Gesicherte Dateien der Dateiverwaltung werden dabei zurückgeschrieben.
        Zum Umzug in eine andere Installation: Backup herunterladen, die ZIP-Datei in deren Backup-Ordner legen
        und dort „php bin/import_backup.php“ ausführen.
    </div>

    {% if pending_packages.waiting is not empty %}
        <div class="alert alert-info">
            Im Backup-Ordner liegen Pakete, die noch nicht übernommen sind:
            <ul class="mb-1">
                {% for name in pending_packages.waiting %}
                    <li><code>{{ name }}</code></li>
                {% endfor %}
            </ul>
            Übernehmen mit „php bin/import_backup.php“.
        </div>
    {% endif %}
    {% if pending_packages.failed is not empty %}
        <div class="alert alert-warning">
            Diese Pakete konnten nicht übernommen werden:
            <ul class="mb-1">
                {% for name in pending_packages.failed %}
                    <li><code>{{ name }}</code></li>
                {% endfor %}
            </ul>
            Den Grund nennt das Protokoll; die Dateien bitte von Hand aus dem Backup-Ordner entfernen.
        </div>
    {% endif %}

    <div class="surface-card card border-0 table-shell"
         data-table-engine="true"
         data-table-id="backups.index"
         data-default-view="auto"
         data-default-page-size="50"
         data-page-size-options="25,50,100"
         data-default-sort-key="created"
         data-default-sort-dir="desc">
        {{ include("partials/table_toolbar.twig") }}
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-responsive-cards">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Typ</th>
                            <th scope="col" data-sort-key="created" data-sort-type="date">Erstellt am</th>
                            <th scope="col">Größe</th>
                            <th scope="col">Dateien</th>
                            <th scope="col">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set _pool_where = "Jede Datei liegt nur einmal im Backup-Ordner," %}
                        {% set pool_hint = _pool_where ~ " egal wie viele Backups sie enthalten." %}
                        {% for backup in backups %}
                            {% set _mismatch = backup.mail_key_mismatch|default(false) %}
                            {% set _files_mb = (backup.files_bytes|default(0) / 1024 / 1024)|round(1) %}
                            <tr data-sort-created="{{ backup.created_at }}">
                                <td data-label="Typ">
                                    {% if backup.type == "manual" %}
                                        <span class="badge text-bg-secondary">Manuell</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">Automatisch</span>
                                    {% endif %}
                                    {% if _mismatch %}
                                        <span class="badge text-bg-warning">anderer Mail-Schlüssel</span>
                                    {% endif %}
                                </td>
                                <td data-label="Erstellt am">{{ backup.created_at|date("d.m.Y H:i") }}</td>
                                <td data-label="Größe">{{ (backup.size / 1024 / 1024)|round(2) }} MB</td>
                                <td data-label="Dateien">
                                    {% if backup.files_count is defined %}
                                        <span title="{{ pool_hint }}">
                                            {{ backup.files_count }} Dateien ({{ _files_mb }} MB)
                                            <small class="text-muted d-block">im gemeinsamen Pool</small>
                                        </span>
                                        {% if backup.files_missing|default(0) > 0 %}
                                            <span class="badge text-bg-warning" title="Beim Sichern nicht gefunden">
                                                {{ backup.files_missing }} fehlend
                                            </span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">nur Datenbank</span>
                                    {% endif %}
                                </td>
                                <td data-label="Aktionen">
                                    <div class="btn-group" role="group" aria-label="Backup-Aktionen">
                                        <a class="btn btn-sm btn-outline-secondary" href="/backups/{{ backup.id }}/download">
                                            <i class="bi bi-download"></i> Download
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger restore-backup-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#restoreBackupModal"
                                                data-id="{{ backup.id }}"
                                                data-mail-key-mismatch="{{ _mismatch ? "1" : "0" }}">
                                            <i class="bi bi-arrow-counterclockwise"></i> Wiederherstellen
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger delete-backup-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteBackupModal"
                                                data-id="{{ backup.id }}">
                                            <i class="bi bi-trash"></i> Löschen
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Keine Backups vorhanden.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="restoreBackupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" id="restoreBackupForm">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <div class="modal-header">
                        <h5 class="modal-title">Backup wiederherstellen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>
                            Diese Aktion überschreibt die gesamte Datenbank mit dem Inhalt dieses Backups und beendet
                            <strong>alle</strong> aktiven Sitzungen, einschließlich Ihrer eigenen.
                            Diese Aktion kann nicht widerrufen werden.
                        </p>
                        <div class="alert alert-warning d-none" id="restoreMailKeyWarning">
                            Dieses Backup stammt von einem anderen Mail-Schlüssel. Gespeicherte Mail-Zugangsdaten lassen sich
                            danach nicht mehr entschlüsseln und müssen neu eingegeben werden.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-warning">Wiederherstellen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteBackupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" id="deleteBackupForm">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <div class="modal-header">
                        <h5 class="modal-title">Backup löschen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Soll dieses Backup endgültig gelöscht werden?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-danger">Löschen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

{% endblock content %}

{% block scripts %}
    <script src="/js/backups.js"></script>
{% endblock scripts %}
