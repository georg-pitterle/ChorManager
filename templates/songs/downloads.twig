{% extends "layout.twig" %}

{% block title %}
    Probenmaterial - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Probenmaterial</h1>
            <p class="text-muted mb-0">
                Noten, Übe-Audio und Links zu den Projekten, in denen du mitsingst.
                Öffne ein Projekt, um die Dateien zu sehen.
            </p>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    <div class="downloads-shell">
        {% if current_projects|length == 0 and past_projects|length == 0 %}
            <article class="surface-card dashboard-panel dashboard-panel--empty">
                <div class="dashboard-panel__body">
                    <h2 class="dashboard-panel__title">
                        <i class="bi bi-folder-x" aria-hidden="true"></i>Noch kein Probenmaterial
                    </h2>
                    <p class="dashboard-panel__text mb-0">Du bist derzeit keinem Projekt zugeordnet.</p>
                </div>
            </article>
        {% endif %}

        {% if current_projects|length > 0 %}
            <div class="accordion downloads-accordion" id="downloadsCurrentAccordion">
                {% for project in current_projects %}
                    {{ include("partials/downloads_project.twig", {
                        project: project,
                        accordion_id: "downloadsCurrentAccordion",
                        expanded: loop.first,
                        midi_mime_types: midi_mime_types,
                    }, false) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if past_projects|length > 0 %}
            <section class="downloads-past" aria-labelledby="downloads-past-label">
                <p class="group-label" id="downloads-past-label">Frühere Projekte</p>
                <div class="accordion downloads-accordion" id="downloadsPastAccordion">
                    {% for project in past_projects %}
                        {{ include("partials/downloads_project.twig", {
                            project: project,
                            accordion_id: "downloadsPastAccordion",
                            expanded: false,
                            midi_mime_types: midi_mime_types,
                        }, false) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if webdav %}
            <details class="downloads-webdav"{% if webdav.token %} open{% endif %}>
                <summary class="downloads-webdav__summary">
                    <i class="bi bi-tablet" aria-hidden="true"></i>
                    <span>Noten aufs Tablet - Projektordner in einer Noten-App einbinden</span>
                </summary>

                <div class="downloads-webdav__body">
                    <p class="text-muted small">
                        Noten-Apps wie forScore oder MobileSheets binden deine Projekte als Ordner ein.
                        Der Ordner ist schreibgeschützt und zeigt genau die Projekte, in denen du mitsingst.
                    </p>

                    <dl class="row mb-3 downloads-webdav-data small">
                        <dt class="col-sm-3">Adresse</dt>
                        <dd class="col-sm-9 downloads-webdav__value">
                            <code id="webdav-url">{{ webdav.url }}</code>
                            <button type="button"
                                    class="btn btn-sm btn-link p-0 downloads-webdav__copy"
                                    data-copy-target="#webdav-url"
                                    aria-label="Adresse kopieren"
                                    title="Adresse kopieren"><i class="bi bi-clipboard"></i></button>
                        </dd>
                        <dt class="col-sm-3">Benutzername</dt>
                        <dd class="col-sm-9 downloads-webdav__value">
                            <code id="webdav-user">{{ webdav.user }}</code>
                            <button type="button"
                                    class="btn btn-sm btn-link p-0 downloads-webdav__copy"
                                    data-copy-target="#webdav-user"
                                    aria-label="Benutzernamen kopieren"
                                    title="Benutzernamen kopieren"><i class="bi bi-clipboard"></i></button>
                        </dd>
                        <dt class="col-sm-3">Zugangswort</dt>
                        <dd class="col-sm-9">
                            {% if webdav.token %}
                                <span class="downloads-webdav__value">
                                    <code class="downloads-webdav-token" id="webdav-token">{{ webdav.token }}</code>
                                    <button type="button"
                                            class="btn btn-sm btn-link p-0 downloads-webdav__copy"
                                            data-copy-target="#webdav-token"
                                            aria-label="Zugangswort kopieren"
                                            title="Zugangswort kopieren"><i class="bi bi-clipboard"></i></button>
                                </span>
                                <div class="alert alert-warning py-2 px-3 small mb-0 mt-2" role="status">
                                    Jetzt in die App eintragen - danach lässt es sich nicht mehr anzeigen,
                                    nur neu erzeugen.
                                </div>
                            {% elseif webdav.exists %}
                                <span class="text-muted">Vergeben. Anzeigen geht nicht mehr, nur neu erzeugen.</span>
                            {% else %}
                                <span class="text-muted">Noch keines erzeugt.</span>
                            {% endif %}
                        </dd>
                    </dl>

                    {% set _renew_confirm = "Neues Zugangswort erzeugen? Jedes Gerät, auf dem noch das bisherige steht, kommt danach nicht mehr an die Noten." %}
                    <form method="post"
                          action="/downloads/webdav-token"
                          class="d-inline"
                          {% if webdav.exists %}data-confirm="{{ _renew_confirm }}"{% endif %}>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-key" aria-hidden="true"></i>
                            {{ webdav.exists ? "Neues Zugangswort erzeugen" : "Zugangswort erzeugen" }}
                        </button>
                    </form>
                    {% if webdav.exists %}
                        <p class="text-muted small mb-0 mt-2">
                            Ein neues Zugangswort sperrt jedes Gerät aus, auf dem noch das bisherige steht.
                        </p>
                    {% endif %}

                    <a href="/help/repertoire-webdav" class="small d-inline-flex align-items-center gap-2 mt-3">
                        <i class="bi bi-book" aria-hidden="true"></i>
                        <span>Einrichtung in forScore, MobileSheets und Co.</span>
                    </a>
                </div>
            </details>
        {% endif %}
    </div>
{% endblock content %}

{% block scripts %}
    {% if has_midi %}
        <script src="/vendor/tone/Tone.js"></script>
        <script src="/vendor/magenta-music/core.js"></script>
        <script src="/vendor/html-midi-player/dist/midi-player.min.js"></script>
    {% endif %}
    <script src="{{ asset_path("/js/downloads.js") }}"></script>
{% endblock scripts %}
