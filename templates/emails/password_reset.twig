{% extends "emails/_layout.twig" %}
{% import "emails/_components.twig" as ui %}

{% block mail_title %}Passwort zurücksetzen{% endblock %}

{% block preheader %}Neues Passwort festlegen — der Link gilt 2 Stunden.{% endblock %}

{% block eyebrow %}Sicherheit{% endblock %}

{% block heading %}Passwort zurücksetzen{% endblock %}

{% block content %}
    <p class="cm-text" style="margin:0 0 26px 0; color:#1f2937">
        für dein Konto bei <strong class="cm-strong">{{ app_name|default("Chor-Manager") }}</strong> wurde ein neues
        Passwort angefordert. Über den Button legst du es fest.
    </p>

    {{ ui.action_button(reset_link, "Neues Passwort festlegen", brand_color, 270) }}

    {# Neutrale Toenung statt Alarmfarbe: der Vorgang ist Routine, keine Stoerung. #}
    {% embed "emails/_hint_box.twig" with {"tone": "neutral"} %}
        {% block body %}
            Der Link gilt <strong class="cm-strong">2 Stunden</strong>.
            <br>
            Wenn die Anfrage nicht von dir kam, ignoriere diese Nachricht — dein Passwort bleibt unverändert.
        {% endblock body %}
    {% endembed %}

    {{ ui.fallback_url(reset_link) }}
{% endblock %}
