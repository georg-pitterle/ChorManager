{% extends "emails/_notification_layout.twig" %}
{% import "emails/_components.twig" as ui %}

{% block mail_title %}Neuer Kommentar: {{ task.name }}{% endblock %}

{% block preheader %}{{ actor_name }} hat „{{ task.name }}“ kommentiert.{% endblock %}

{% block eyebrow %}Kommentar{% endblock %}

{% block heading %}Neuer Kommentar zu einer Aufgabe{% endblock %}

{% block content %}
    <p class="cm-text" style="margin:0 0 24px 0; color:#1f2937">
        {{ actor_name|default("Jemand") }} hat die Aufgabe „{{ task.name }}“ kommentiert:
    </p>

    {# Der Kommentar selbst ist der Grund der Mail und steht deshalb vor den Eckdaten. #}
    <table role="presentation"
           width="100%"
           cellpadding="0"
           cellspacing="0"
           border="0"
           style="background-color:#f5f7fa;
                  border:1px solid #d9dee7;
                  border-left:3px solid {{ brand_color }};
                  border-radius:8px;
                  margin:0 0 26px 0">
        <tr>
            <td style="padding:18px 20px;
                       font-family:{{ font_stack }};
                       font-size:16px;
                       line-height:1.6;
                       color:#1f2937">{{ comment_text }}</td>
        </tr>
    </table>

    {{ ui.action_button(link, "Antworten", brand_color, 170) }}

    {{ ui.fallback_url(link) }}
{% endblock %}
