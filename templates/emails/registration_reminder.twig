{% extends "emails/_layout.twig" %}
{% import "emails/_components.twig" as ui %}

{% block mail_title %}Erinnerung: Anmeldung zu {{ event.title }}{% endblock %}

{% block preheader %}{{ event.title }} — deine Rückmeldung fehlt noch.{% endblock %}

{% block eyebrow %}Erinnerung{% endblock %}

{% block heading %}Deine Rückmeldung fehlt noch{% endblock %}

{% block content %}
    <p class="cm-text" style="margin:0 0 24px 0; color:#1f2937">zu diesem Termin hast du dich noch nicht eingetragen:</p>

    {# Die Detail-Liste traegt die eigentliche Information, deshalb steht sie vor dem Button. #}
    <table role="presentation"
           width="100%"
           cellpadding="0"
           cellspacing="0"
           border="0"
           class="cm-details"
           style="background-color:#f5f7fa;
                  border:1px solid #d9dee7;
                  border-radius:8px;
                  margin:0 0 26px 0">
        <tr>
            <td style="padding:18px 20px 6px 20px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {{ ui.detail_row("Termin", event.title, true) }}
                    {{ ui.detail_row("Beginn", event.starts_at|date("d.m.Y H:i") ~ " Uhr", false) }}
                    {% if event.location is not empty %}
                        {{ ui.detail_row("Ort", event.location, false) }}
                    {% endif %}
                </table>
            </td>
        </tr>
        {# Anmeldeschluss ist der handlungsrelevante Wert und bekommt die Akzentlinie als Marker. #}
        <tr>
            <td style="padding:0 20px 18px 20px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td width="3"
                            bgcolor="{{ brand_color }}"
                            style="width:3px;
                                   background-color:{{ brand_color }};
                                   font-size:0;
                                   line-height:0">&nbsp;</td>
                        <td style="padding:2px 0 2px 14px">
                            <div class="cm-row-label"
                                 style="font-family:{{ font_stack }};
                                        font-size:13px;
                                        line-height:1.5;
                                        color:#667085">Anmeldeschluss</div>
                            <div class="cm-row-value"
                                 style="font-family:{{ font_stack }};
                                        font-size:18px;
                                        line-height:1.4;
                                        font-weight:700;
                                        color:#1f2937">{{ deadline }} Uhr</div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    {{ ui.action_button(link, "Jetzt eintragen", brand_color, 210) }}

    {{ ui.fallback_url(link) }}
{% endblock %}
