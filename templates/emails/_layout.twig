{# Gemeinsame Huelle aller Systemmails. Der Kopfbereich entspricht der Topbar der Anwendung:
   dunkles Anthrazit mit Akzentlinie in der Markenfarbe. Die Markenfarbe bleibt Akzent und
   Aktionsfarbe, nie Flaeche hinter weisser Schrift.

   Inline-Styles sind hier Pflicht: E-Mail-Clients laden keine externen Stylesheets und
   entfernen den <style>-Block teilweise. Der Block ist nur progressive Verbesserung. #}
{% set brand_color = primary_color|default("#E8A817") %}
{% set brand_name = app_name|default("Chor-Manager") %}
{% set font_stack = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif" %}
{% set mono_stack = "ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace" %}
<!DOCTYPE html>
<html lang="de"
      xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="x-apple-disable-message-reformatting">
        <meta name="color-scheme" content="light dark">
        <meta name="supported-color-schemes" content="light dark">
        <meta name="description" content="{% block preheader %}{% endblock %}">
        <title>{% block mail_title %}{% endblock %}</title>
        <style>
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table { border-collapse: collapse !important; }
        img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
        a { text-decoration: none; }

        @media screen and (max-width: 600px) {
            .cm-card { width: 100% !important; border-radius: 0 !important; }
            .cm-header { padding: 24px 20px 20px 20px !important; }
            .cm-body { padding: 24px 20px !important; }
            .cm-footer { padding: 18px 20px !important; }
            .cm-h1 { font-size: 20px !important; }
            .cm-cta, .cm-cta-link { width: 100% !important; display: block !important; }
            .cm-row-label, .cm-row-value { display: block !important; width: auto !important; }
            .cm-row-label { padding-bottom: 1px !important; }
            .cm-row-value { padding-bottom: 14px !important; }
        }

        @media (prefers-color-scheme: dark) {
            .cm-ground { background-color: #0d1319 !important; }
            .cm-card { background-color: #1e2836 !important; }
            .cm-body, .cm-text { color: #e6e9ee !important; }
            .cm-muted, .cm-row-label { color: #9aa4b2 !important; }
            .cm-strong, .cm-row-value { color: #ffffff !important; }
            .cm-footer { background-color: #151d27 !important; border-top-color: #2c3644 !important; }
            .cm-hint, .cm-details { background-color: #232e3c !important; border-color: #3a4a57 !important; }
            .cm-hint-text { color: #e6e9ee !important; }
            .cm-fallback { background-color: #151d27 !important; border-color: #2c3644 !important; }
            .cm-fallback-url { color: #9aa4b2 !important; }
            .cm-linkaccent { color: {{ brand_color }} !important; }
        }
        </style>
    </head>
    <body class="cm-ground" style="margin:0; padding:0; background-color:#eef1f5;">
        {# Vorschauzeile im Postfach. Sichtbar nur dort, nicht in der geoeffneten Mail. #}
        <div style="display:none;
                    font-size:1px;
                    color:#eef1f5;
                    line-height:1px;
                    max-height:0;
                    max-width:0;
                    opacity:0;
                    overflow:hidden">{{ block("preheader") }}</div>
        <table role="presentation"
               width="100%"
               cellpadding="0"
               cellspacing="0"
               border="0"
               class="cm-ground"
               style="background-color:#eef1f5">
            <tr>
                <td align="center" style="padding:32px 12px">
                    <table role="presentation"
                           width="600"
                           cellpadding="0"
                           cellspacing="0"
                           border="0"
                           class="cm-card"
                           style="width:600px;
                                  max-width:600px;
                                  background-color:#ffffff;
                                  border-radius:10px;
                                  overflow:hidden">
                        <tr>
                            <td class="cm-header"
                                bgcolor="#1d2836"
                                style="background-color:#1d2836;
                                       background-image:linear-gradient(135deg,#243244 0%,#18212b 100%);
                                       padding:30px 40px 26px 40px">
                                {% if logo_src is defined and logo_src is not empty %}
                                    <img src="{{ logo_src }}"
                                         alt="{{ brand_name }}"
                                         width="56"
                                         height="56"
                                         style="display:block;
                                                width:56px;
                                                height:56px;
                                                margin:0 0 16px 0;
                                                border-radius:8px">
                                {% endif %}
                                <div style="font-family:{{ font_stack }};
                                            font-size:11px;
                                            font-weight:700;
                                            letter-spacing:0.09em;
                                            text-transform:uppercase;
                                            color:{{ brand_color }};
                                            padding-bottom:8px">{% block eyebrow %}{% endblock %}</div>
                                <h1 class="cm-h1"
                                    style="margin:0;
                                           font-family:{{ font_stack }};
                                           font-size:23px;
                                           line-height:1.3;
                                           font-weight:700;
                                           letter-spacing:-0.01em;
                                           color:#ffffff">{% block heading %}{% endblock %}</h1>
                            </td>
                        </tr>
                        {# Akzentlinie: entspricht --header-accent-line der Anwendung. #}
                        <tr>
                            <td bgcolor="{{ brand_color }}"
                                height="4"
                                style="background-color:{{ brand_color }};
                                       height:4px;
                                       line-height:4px;
                                       font-size:0">&nbsp;</td>
                        </tr>
                        <tr>
                            <td class="cm-body"
                                style="padding:32px 40px;
                                       font-family:{{ font_stack }};
                                       font-size:16px;
                                       line-height:1.65;
                                       color:#1f2937">
                                {% block greeting %}
                                    <p class="cm-text" style="margin:0 0 18px 0; color:#1f2937">Hallo {{ user.first_name }},</p>
                                {% endblock %}
                                {% block content %}{% endblock %}
                                {% block closing %}
                                    <p class="cm-text" style="margin:0; color:#1f2937">
                                        Viele Grüße
                                        <br>
                                        dein {{ brand_name }}
                                    </p>
                                {% endblock %}
                            </td>
                        </tr>
                        <tr>
                            <td class="cm-footer"
                                bgcolor="#f5f7fa"
                                style="background-color:#f5f7fa; border-top:1px solid #d9dee7; padding:20px 40px">
                                <p class="cm-muted"
                                   style="margin:0;
                                          font-family:{{ font_stack }};
                                          font-size:12px;
                                          line-height:1.6;
                                          color:#667085">
                                    {% block footer_note %}
                                        Automatisch versendet von {{ brand_name }}. Antworten auf diese Adresse werden nicht gelesen.
                                    {% endblock %}
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
