{% extends "emails/_notification_layout.twig" %}
{% import "emails/_components.twig" as ui %}

{% block mail_title %}Du bist jetzt bei {{ project.name }} dabei{% endblock %}

{% block preheader %}{{ project.name }} — du wurdest dem Projekt zugeordnet.{% endblock %}

{% block eyebrow %}Projekt{% endblock %}

{% block heading %}Du bist einem Projekt zugeordnet{% endblock %}

{% block content %}
    <p class="cm-text" style="margin:0 0 24px 0; color:#1f2937">
        du gehörst ab sofort zu diesem Projekt:
    </p>

    <table role="presentation"
           width="100%"
           cellpadding="0"
           cellspacing="0"
           border="0"
           class="cm-details"
           style="background-color:#f5f7fa;
                  border:1px solid #d9dee7;
                  border-radius:8px;
                  margin:0 0 26px 0">
        <tr>
            <td style="padding:18px 20px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {{ ui.detail_row("Projekt", project.name, true) }}
                    {% if project.start_date or project.end_date %}
                        {% set _from = project.start_date ? project.start_date|date("d.m.Y") : "offen" %}
                        {% set _to = project.end_date ? project.end_date|date("d.m.Y") : "offen" %}
                        {{ ui.detail_row("Zeitraum", _from ~ " bis " ~ _to, false) }}
                    {% endif %}
                    {% if project.description is not empty %}
                        {{ ui.detail_row("Beschreibung", project.description, false) }}
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    {{ ui.action_button(link, "Projekt ansehen", brand_color, 200) }}

    {{ ui.fallback_url(link) }}
{% endblock %}
