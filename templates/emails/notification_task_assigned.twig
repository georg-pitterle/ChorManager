{% extends "emails/_notification_layout.twig" %}
{% import "emails/_components.twig" as ui %}

{% block mail_title %}Neue Aufgabe: {{ task.name }}{% endblock %}

{% block preheader %}{{ task.name }} — du bist jetzt dafür eingetragen.{% endblock %}

{% block eyebrow %}Aufgabe{% endblock %}

{% block heading %}Du bist für eine Aufgabe eingetragen{% endblock %}

{% block content %}
    <p class="cm-text" style="margin:0 0 24px 0; color:#1f2937">
        {{ actor_name ? actor_name ~ " hat dich" : "Du wurdest" }} für diese Aufgabe eingetragen:
    </p>

    <table role="presentation"
           width="100%"
           cellpadding="0"
           cellspacing="0"
           border="0"
           class="cm-details"
           style="background-color:#f5f7fa;
                  border:1px solid #d9dee7;
                  border-radius:8px;
                  margin:0 0 26px 0">
        <tr>
            <td style="padding:18px 20px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {{ ui.detail_row("Aufgabe", task.name, true) }}
                    {% if task.project %}
                        {{ ui.detail_row("Projekt", task.project.name, false) }}
                    {% endif %}
                    {% if task.end_date %}
                        {{ ui.detail_row("Fällig am", task.end_date|date("d.m.Y"), false) }}
                    {% endif %}
                    {{ ui.detail_row("Priorität", task.priority|default("Mittel"), false) }}
                    {% if co_assignees|default([])|length > 0 %}
                        {{ ui.detail_row("Gemeinsam mit", co_assignees|join(", "), false) }}
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    {{ ui.action_button(link, "Aufgabe ansehen", brand_color, 200) }}

    {{ ui.fallback_url(link) }}
{% endblock %}
