{# Hinweisbox fuer Gueltigkeitsdauer und Sicherheitshinweise.
   tone "brand" fuer Einladungen, tone "neutral" im Sicherheitskontext. Bewusst kein Rot:
   eine Systemmail ist keine Stoerung. Einbinden per {% embed %} mit Block "body". #}
{% set is_brand_tone = tone|default("neutral") == "brand" %}
{% set surface = surface_override|default(is_brand_tone ? "#fdf8ec" : "#f2f4f7") %}
{% set edge = edge_override|default(is_brand_tone ? "#f8e5b9" : "#d9dee7") %}
{% set hint_font = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif" %}
<table role="presentation"
       width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       class="cm-hint"
       style="background-color:{{ surface }};
              border:1px solid {{ edge }};
              border-radius:6px;
              margin:0 0 26px 0">
    <tr>
        <td class="cm-hint-text"
            style="padding:12px 16px;
                   font-family:{{ hint_font }};
                   font-size:14px;
                   line-height:1.55;
                   color:#1f2937">{% block body %}{% endblock %}</td>
    </tr>
</table>
