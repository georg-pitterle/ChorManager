{% extends "emails/_layout.twig" %}
{% import "emails/_components.twig" as ui %}

{% block mail_title %}Einladung zu {{ app_name|default("Chor-Manager") }}{% endblock %}

{% block preheader %}Dein Zugang wartet — Passwort festlegen und loslegen.{% endblock %}

{% block eyebrow %}Einladung{% endblock %}

{% block heading %}Willkommen bei {{ app_name|default("Chor-Manager") }}{% endblock %}

{% block content %}
    <p class="cm-text" style="margin:0 0 26px 0; color:#1f2937">
        du wurdest eingeladen, <strong class="cm-strong">{{ app_name|default("Chor-Manager") }}</strong> zu nutzen.
        Lege dein Passwort fest, dann ist dein Konto aktiv und du siehst Termine, Anmeldungen und Noten deines Chores.
    </p>

    {{ ui.action_button(invite_link, "Konto aktivieren", brand_color, 250) }}

    {% set hint_tint = primary_tint|default(null) %}
    {% set hint_edge = primary_edge|default(null) %}
    {% set hint_options = {"tone": "brand", "surface_override": hint_tint, "edge_override": hint_edge} %}
    {% embed "emails/_hint_box.twig" with hint_options %}
        {% block body %}
            Die Einladung gilt <strong class="cm-strong">7 Tage</strong>.
            Danach kannst du dir eine neue schicken lassen.
        {% endblock %}
    {% endembed %}

    {% if handoff_url is defined and handoff_url is not empty %}
        <p class="cm-text" style="margin:0 0 26px 0; color:#1f2937">
            Erste Schritte und Antworten auf häufige Fragen:
            <a href="{{ handoff_url }}"
               class="cm-linkaccent"
               style="color:{{ primary_strong|default('#c48e0f') }};
                      font-weight:600;
                      text-decoration:underline">{{ handoff_label }}</a>
        </p>
    {% endif %}

    {{ ui.fallback_url(invite_link) }}
{% endblock %}
