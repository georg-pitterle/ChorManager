{% extends "layout.twig" %}

{% block title %}
    Mein Profil - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block content %}
    <div class="row mt-4 mb-3">
        <div class="col-12">
            <h1>Mein Profil</h1>
        </div>
    </div>

    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}

    <ul class="nav nav-tabs mb-0" id="profileTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="tab-personal"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-personal"
                    type="button"
                    role="tab"
                    aria-controls="pane-personal"
                    aria-selected="true">
                <i class="bi bi-person me-1"></i>Persönliche Informationen
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-projects"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-projects"
                    type="button"
                    role="tab"
                    aria-controls="pane-projects"
                    aria-selected="false">
                <i class="bi bi-music-note-list me-1"></i>Meine Projekte
                <span class="badge bg-secondary ms-1">{{ projects|length }}</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-calendar"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-calendar"
                    type="button"
                    role="tab"
                    aria-controls="pane-calendar"
                    aria-selected="false">
                <i class="bi bi-calendar-week me-1"></i>Kalender
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-password"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-password"
                    type="button"
                    role="tab"
                    aria-controls="pane-password"
                    aria-selected="false">
                <i class="bi bi-key me-1"></i>Passwort ändern
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-mailbox"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-mailbox"
                    type="button"
                    role="tab"
                    aria-controls="pane-mailbox"
                    aria-selected="false">
                <i class="bi bi-envelope me-1"></i>Mailbox / Webmail
            </button>
        </li>
    </ul>

    <div class="tab-content pt-3 mb-4" id="profileTabContent">
        <!-- Persönliche Informationen -->
        <div class="tab-pane fade show active"
             id="pane-personal"
             role="tabpanel"
             aria-labelledby="tab-personal"
             tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form action="/profile" method="post">
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="first_name"
                                       class="form-label text-muted small fw-bold text-uppercase">Vorname</label>
                                <input type="text"
                                       class="form-control"
                                       id="first_name"
                                       name="first_name"
                                       value="{{ user.first_name }}"
                                       required>
                            </div>
                            <div class="col-6 mb-3">
                                <label for="last_name"
                                       class="form-label text-muted small fw-bold text-uppercase">Nachname</label>
                                <input type="text"
                                       class="form-control"
                                       id="last_name"
                                       name="last_name"
                                       value="{{ user.last_name }}"
                                       required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="email"
                                   class="form-label text-muted small fw-bold text-uppercase">E-Mail Adresse</label>
                            <input type="email"
                                   class="form-control"
                                   id="email"
                                   name="email"
                                   value="{{ user.email }}"
                                   required>
                        </div>

                        <div class="d-grid justify-content-md-end mb-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-person-check"></i> Profil speichern
                            </button>
                        </div>
                    </form>

                    <hr>

                    <div class="row mt-4">
                        <div class="col-6 mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Rolle(n)</label>
                            <p class="fs-5 mb-0">
                                {% for role in user.roles %}
                                    <span class="badge bg-primary">{{ role.name }}</span>
                                {% else %}
                                    -
                                {% endfor %}
                            </p>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Stimmgruppe(n)</label>
                            <p class="fs-5 mb-0">
                                {% if user.voice_group_ids|length > 0 %}
                                    {% for group_id in user.voice_group_ids %}
                                        {% for g in voice_groups %}
                                            {% if g.id == group_id %}
                                                <span class="d-inline-block border p-1 rounded mb-1 text-nowrap fs-6">
                                                    {{ g.name }}
                                                    {% set sv_id = user.voice_group_pivots[group_id] %}
                                                    {% if sv_id %}
                                                        {% for sv in sub_voices %}
                                                            {% if sv.id == sv_id %}<small class="text-muted">({{ sv.name }})</small>{% endif %}
                                                        {% endfor %}
                                                    {% endif %}
                                                </span>
                                                <br>
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                {% else %}
                                    -
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meine Projekte -->
        <div class="tab-pane fade"
             id="pane-projects"
             role="tabpanel"
             aria-labelledby="tab-projects"
             tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    {% if projects|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for project in projects %}
                                <li class="list-group-item px-0">
                                    <div class="fw-bold">{{ project.name }}</div>
                                    {% if project.start_date or project.end_date %}
                                        <small class="text-muted">
                                            {{ project.start_date ? project.start_date|date("d.m.Y") : "?" }}
                                            bis
                                            {{ project.end_date ? project.end_date|date("d.m.Y") : "?" }}
                                        </small>
                                    {% endif %}
                                    {% if project.description %}
                                        <div class="text-muted small">{{ project.description }}</div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Du nimmst derzeit an keinem Projekt teil.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Kalender -->
        <div class="tab-pane fade"
             id="pane-calendar"
             role="tabpanel"
             aria-labelledby="tab-calendar"
             tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted">
                        Der abonnierte Kalender zeigt deine Termine. Hier legst du fest, ob deine
                        Aufgaben mitkommen. Aufgenommen werden Aufgaben, die dir zugewiesen sind,
                        ein Enddatum haben und noch nicht abgeschlossen sind.
                    </p>

                    <form action="/profile/calendar" method="post">
                        <div class="mb-4">
                            <label for="calendar_task_feed" class="form-label">Aufgaben im Kalender</label>
                            <select class="form-select" id="calendar_task_feed" name="calendar_task_feed">
                                <option value="combined"
                                        {{ user.calendar_task_feed == "combined" ? "selected" : "" }}>
                                    Zusammen mit den Terminen in einem Abo
                                </option>
                                <option value="separate"
                                        {{ user.calendar_task_feed == "separate" ? "selected" : "" }}>
                                    In einem eigenen Abo
                                </option>
                                <option value="none"
                                        {{ user.calendar_task_feed == "none" ? "selected" : "" }}>
                                    Gar nicht
                                </option>
                            </select>
                            <div class="form-text">
                                Bei einem eigenen Abo findest du den zweiten Link im Abo-Fenster
                                auf der Terminseite. Beide Links nutzen denselben Zugang: Wer ihn
                                erneuert, zieht damit auch das Aufgaben-Abo zurück.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="calendar_task_format" class="form-label">Darstellung</label>
                            <select class="form-select" id="calendar_task_format" name="calendar_task_format">
                                <option value="event"
                                        {{ user.calendar_task_format == "event" ? "selected" : "" }}>
                                    Als ganztägiger Termin am Enddatum
                                </option>
                                <option value="todo"
                                        {{ user.calendar_task_format == "todo" ? "selected" : "" }}>
                                    Als Aufgabe mit Fälligkeit
                                </option>
                            </select>
                            <div class="form-text">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Apple Kalender und Google Kalender zeigen Aufgaben aus abonnierten
                                Kalendern nicht an. Wer einen dieser beiden nutzt, bleibt besser
                                beim ganztägigen Termin.
                            </div>
                        </div>

                        <div class="d-grid justify-content-md-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Speichern
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Passwort ändern -->
        <div class="tab-pane fade"
             id="pane-password"
             role="tabpanel"
             aria-labelledby="tab-password"
             tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form action="/profile/password" method="post">
                        <div class="mb-4">
                            <label for="old_password" class="form-label">Aktuelles Passwort</label>
                            <input type="password"
                                   class="form-control"
                                   id="old_password"
                                   name="old_password"
                                   required>
                        </div>
                        <hr>

                        <div class="mb-3">
                            <label for="new_password" class="form-label">Neues Passwort</label>
                            <input type="password"
                                   class="form-control"
                                   id="new_password"
                                   name="new_password"
                                   required
                                   minlength="6">
                            <div class="form-text">Das Passwort muss aus mindestens 6 Zeichen bestehen.</div>
                        </div>

                        <div class="mb-4">
                            <label for="new_password_confirm" class="form-label">Neues Passwort bestätigen</label>
                            <input type="password"
                                   class="form-control"
                                   id="new_password_confirm"
                                   name="new_password_confirm"
                                   required
                                   minlength="6">
                        </div>

                        <div class="d-grid justify-content-md-end">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-arrow-repeat"></i> Passwort aktualisieren
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Mailbox / Webmail -->
        <div class="tab-pane fade"
             id="pane-mailbox"
             role="tabpanel"
             aria-labelledby="tab-mailbox"
             tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form action="/profile/mailbox" method="post" id="mailboxForm">
                        <div id="mailboxFormFeedback" class="alert d-none" role="alert"></div>
                        <div class="mb-3">
                            <label for="imap_host" class="form-label text-muted small fw-bold text-uppercase">Host</label>
                            <input type="text"
                                   class="form-control"
                                   id="imap_host"
                                   name="imap_host"
                                   value="{{ mail_account.imap_host|default('') }}"
                                   maxlength="255"
                                   required>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="imap_port"
                                       class="form-label text-muted small fw-bold text-uppercase">Port</label>
                                <input type="number"
                                       class="form-control"
                                       id="imap_port"
                                       name="imap_port"
                                       value="{{ mail_account.imap_port|default('') }}"
                                       placeholder="993"
                                       min="1"
                                       max="65535"
                                       required>
                            </div>
                            <div class="col-6 mb-3">
                                <label for="imap_encryption"
                                       class="form-label text-muted small fw-bold text-uppercase">Verschlüsselung</label>
                                {% set _encryption = mail_account.imap_encryption|default('ssl') %}
                                <select class="form-select" id="imap_encryption" name="imap_encryption" required>
                                    <option value="ssl" {{ _encryption == 'ssl' ? 'selected' : '' }}>SSL</option>
                                    <option value="tls" {{ _encryption == 'tls' ? 'selected' : '' }}>TLS</option>
                                    <option value="none" {{ _encryption == 'none' ? 'selected' : '' }}>Keine</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="imap_username"
                                   class="form-label text-muted small fw-bold text-uppercase">Benutzername</label>
                            <input type="text"
                                   class="form-control"
                                   id="imap_username"
                                   name="imap_username"
                                   value="{{ mail_account.imap_username|default('') }}"
                                   maxlength="255"
                                   required>
                        </div>
                        <div class="mb-3">
                            <label for="imap_password" class="form-label">Passwort</label>
                            <input type="password" class="form-control" id="imap_password" name="imap_password">
                            {% if has_saved_account %}
                                <div class="form-text">Gespeichert – leer lassen, um aktuelles Passwort zu behalten.</div>
                            {% endif %}
                        </div>
                        <hr class="my-3">
                        <p class="text-muted small fw-bold text-uppercase mb-2">SMTP (optional, zum Versenden)</p>
                        <div class="mb-3">
                            <label for="smtp_host" class="form-label text-muted small fw-bold text-uppercase">SMTP-Host</label>
                            <input type="text"
                                   class="form-control"
                                   id="smtp_host"
                                   name="smtp_host"
                                   value="{{ mail_account.smtp_host|default('') }}"
                                   maxlength="255"
                                   placeholder="z. B. send.one.com">
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="smtp_port" class="form-label text-muted small fw-bold text-uppercase">SMTP-Port</label>
                                <input type="number"
                                       class="form-control"
                                       id="smtp_port"
                                       name="smtp_port"
                                       value="{{ mail_account.smtp_port|default('') }}"
                                       placeholder="587"
                                       min="1"
                                       max="65535">
                            </div>
                            <div class="col-6">
                                <label for="smtp_encryption" class="form-label text-muted small fw-bold text-uppercase">Verschlüsselung</label>
                                {% set _smtp_enc = mail_account.smtp_encryption|default('tls') %}
                                <select class="form-select" id="smtp_encryption" name="smtp_encryption">
                                    <option value="ssl" {{ _smtp_enc == 'ssl' ? 'selected' : '' }}>SSL</option>
                                    <option value="tls" {{ _smtp_enc == 'tls' ? 'selected' : '' }}>TLS</option>
                                    <option value="none" {{ _smtp_enc == 'none' ? 'selected' : '' }}>Keine</option>
                                </select>
                            </div>
                        </div>
                        <hr class="my-3">
                        <div class="form-check mb-2">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="imap_enabled"
                                   name="imap_enabled"
                                   {{ mail_account.imap_enabled ? 'checked' : '' }}>
                            <label class="form-check-label" for="imap_enabled">Aktiv</label>
                        </div>
                        <div class="form-check mb-4">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="mail_badge_enabled"
                                   name="mail_badge_enabled"
                                   {{ mail_account.mail_badge_enabled ? 'checked' : '' }}>
                            <label class="form-check-label" for="mail_badge_enabled">Badge anzeigen</label>
                        </div>

                        {% if not settings.modules.webmail %}
                            <div class="mb-4">
                                <label for="external_webmail_url"
                                       class="form-label text-muted small fw-bold text-uppercase">
                                    Externe Webmail-URL (optional)
                                </label>
                                <input type="url"
                                       class="form-control"
                                       id="external_webmail_url"
                                       name="external_webmail_url"
                                       value="{{ mail_account.external_webmail_url|default("") }}"
                                       maxlength="255"
                                       placeholder="https://webmail.example.org">
                                <div class="form-text">
                                    Wird gesetzt, verlinkt das Mail-Badge in der Navigation auf diese Adresse.
                                </div>
                            </div>
                        {% endif %}

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit"
                                    class="btn btn-outline-secondary"
                                    formaction="/profile/mailbox/test">
                                <i class="bi bi-plug"></i> Verbindung testen
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-envelope-check"></i> Mailbox speichern
                            </button>
                        </div>
                    </form>

                    {% if has_saved_account %}
                        <form action="/profile/mailbox/delete"
                              method="post"
                              class="mt-3"
                              data-confirm="Mailbox-Zugang wirklich entfernen? Nicht rückgängig zu machen.">
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Zugang entfernen
                                </button>
                            </div>
                        </form>
                    {% endif %}

                    {% if settings.modules.webmail and webmail_available %}
                        <hr>
                        <form action="/profile/webmail/start" method="post" target="_blank" rel="noopener noreferrer">
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-box-arrow-up-right"></i> Webmail öffnen
                                </button>
                            </div>
                        </form>
                    {% endif %}
                    {% set _external_url = mail_account.external_webmail_url|default("") %}
                    {% if not settings.modules.webmail and _external_url != "" %}
                        <hr>
                        <div class="d-flex justify-content-end">
                            <a href="{{ _external_url }}"
                               class="btn btn-success"
                               target="_blank"
                               rel="noopener noreferrer">
                                <i class="bi bi-box-arrow-up-right"></i> Webmail öffnen
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock content %}

{% block scripts %}
    <script src="/js/profile-mailbox.js"></script>
{% endblock scripts %}
