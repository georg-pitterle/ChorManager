{% extends "layout.twig" %}
{% block editor_scripts %}
    <script src="/vendor/tinymce/tinymce/tinymce.min.js"></script>
{% endblock editor_scripts %}

{% block title %}
    Aufgabe: {{ task.name }} - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/projects">Projekte</a></li>
                    <li class="breadcrumb-item"><a href="/projects/{{ project.id }}/tasks">{{ project.name }}</a></li>
                    <li class="breadcrumb-item active">{{ task.name }}</li>
                </ol>
            </nav>
            <h1 class="h2 mb-1">{{ task.name }}</h1>
            <p class="text-muted mb-0">
                Erstellt von {{ task.createdBy|person_name }} am {{ task.created_at|date("d.m.Y") }}
            </p>
        </div>
        <div class="page-actions">
            {# Häufigste Handlung zuerst: ein Tipp setzt den Status, ohne das Bearbeiten-Fenster #}
            {% if task.status == "Abgeschlossen" %}
                <form action="/tasks/{{ task.id }}/status" method="post">
                    <input type="hidden" name="status" value="Offen">
                    <input type="hidden" name="return_to" value="task">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Wieder öffnen
                    </button>
                </form>
            {% else %}
                <form action="/tasks/{{ task.id }}/status" method="post">
                    <input type="hidden" name="status" value="Abgeschlossen">
                    <input type="hidden" name="return_to" value="task">
                    <button type="submit" class="btn btn-primary">
                        Als erledigt markieren
                    </button>
                </form>
            {% endif %}
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#editTaskModal">
                <i class="bi bi-pencil"></i> Bearbeiten
            </button>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% set _status_labels = {"Offen": "Offen", "In Bearbeitung": "In Arbeit", "Abgeschlossen": "Erledigt"} %}
    {% set _status_badges = {
        "Offen": "text-bg-secondary",
        "In Bearbeitung": "text-bg-info",
        "Abgeschlossen": "text-bg-success",
    } %}
    {% set _priority_badges = {"Niedrig": "text-bg-secondary", "Mittel": "text-bg-warning", "Hoch": "text-bg-danger"} %}
    {% set _due_ymd = task.end_date ? task.end_date|date("Y-m-d") : "" %}
    {% set _is_open = task.status != "Abgeschlossen" %}
    {% set _is_overdue = _is_open and _due_ymd != "" and _due_ymd < "now"|date("Y-m-d") %}
    {% set _me = session.user_id|default(0) %}
    {% set _assignee_names = [] %}
    {% for _assignee in task.assignees|sort((a, b) => a.last_name <=> b.last_name) %}
        {% set _self_mark = _assignee.id == _me ? " (du)" : "" %}
        {% set _assignee_names = _assignee_names|merge([(_assignee|person_name) ~ _self_mark]) %}
    {% endfor %}

    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Schließen"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Schließen"></button>
        </div>
    {% endif %}

    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context" aria-label="Eckdaten der Aufgabe">
            <div class="surface-card card border-0">
                <div class="card-body">
                    <dl class="task-facts mb-0">
                        <div class="task-fact">
                            <dt>Status</dt>
                            <dd>
                                <span class="badge {{ _status_badges[task.status]|default("text-bg-secondary") }}">
                                    {{ _status_labels[task.status]|default(task.status) }}
                                </span>
                            </dd>
                        </div>
                        <div class="task-fact">
                            <dt>Fällig bis</dt>
                            <dd>
                                {% if task.end_date %}
                                    <span class="{{ _is_overdue ? "text-danger fw-semibold" : "" }}">
                                        {{ task.end_date|date("d.m.Y") }}
                                    </span>
                                    {% if _is_overdue %}
                                        <span class="badge text-bg-danger ms-1">Überfällig</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted">Kein Datum</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="task-fact">
                            <dt>Zuständig</dt>
                            <dd>
                                {% if _assignee_names|length > 0 %}
                                    {{ _assignee_names|join(", ") }}
                                {% else %}
                                    <span class="text-muted">Niemand zugewiesen</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="task-fact">
                            <dt>Priorität</dt>
                            <dd>
                                {% if _priority_badges[task.priority] is defined %}
                                    <span class="badge {{ _priority_badges[task.priority] }}">{{ task.priority }}</span>
                                {% else %}
                                    <span class="text-muted">Nicht festgelegt</span>
                                {% endif %}
                            </dd>
                        </div>
                        {% if task.start_date %}
                            <div class="task-fact">
                                <dt>Beginn</dt>
                                <dd>{{ task.start_date|date("d.m.Y") }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </section>

        <section class="dashboard-section dashboard-section--context" aria-labelledby="task-description-title">
            <div class="surface-card card border-0">
                <div class="card-body">
                    <h2 class="h6 mb-2" id="task-description-title">Beschreibung</h2>
                    <div class="task-description-html">
                        {% if task.description %}
                            {{ task.description|raw }}
                        {% else %}
                            <span class="text-muted fst-italic">Keine Beschreibung angegeben.</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <section class="dashboard-section dashboard-section--context" aria-label="Kommentare">
            {{ include("partials/comments.twig", {
            comments: task.comments,
            submit_url: "/tasks/" ~ task.id ~ "/comments",
            }) }}
        </section>

        <section class="dashboard-section dashboard-section--context" aria-label="Dateien und Verlauf">
            <div class="row">
                <div class="col-lg-8">
                    {{ include("partials/attachments.twig", {
                    attachments: task.attachments,
                    upload_url: "/tasks/" ~ task.id ~ "/attachments",
                    delete_url: "/tasks/" ~ task.id ~ "/attachments",
                    }) }}
                </div>
                <div class="col-lg-4">
                    <details class="task-history">
                        <summary class="task-history-toggle">Verlauf einblenden</summary>
                        {{ include("partials/history.twig", {
                        activities: task.activities|reverse,
                        }) }}
                    </details>
                </div>
            </div>
        </section>
    </div>

    {# Eigenes Formular, weil das Bearbeiten-Fenster selbst ein Formular ist; der Knopf dort verweist per form-Attribut hierher #}
    <form id="deleteTaskForm"
          action="/tasks/{{ task.id }}/delete"
          method="post"
          class="d-none"
          data-confirm="Möchten Sie diese Aufgabe wirklich löschen? Kommentare, Anhänge und Verlauf gehen dabei verloren."></form>

    <div class="modal fade"
         id="editTaskModal"
         tabindex="-1"
         aria-labelledby="editTaskModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <form action="/tasks/{{ task.id }}/update"
                  method="post"
                  class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editTaskModalLabel">Aufgabe bearbeiten</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Schließen"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editTaskTitle" class="form-label">Titel der Aufgabe *</label>
                        <input type="text"
                               class="form-control"
                               id="editTaskTitle"
                               name="title"
                               value="{{ task.name }}"
                               required>
                    </div>

                    <div class="mb-3">
                        <label for="editTaskAssignees" class="form-label">Zuständig (optional)</label>
                        {% set _assigned_ids = task.assignees|map(a => a.id) %}
                        <select class="form-select"
                                id="editTaskAssignees"
                                name="assigned_user_ids[]"
                                data-tom-select
                                data-placeholder="Personen wählen …"
                                multiple>
                            {% for u in projectUsers %}
                                <option value="{{ u.id }}" {{ u.id in _assigned_ids ? "selected" : "" }}>
                                    {{ u|person_name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editTaskPriority" class="form-label">Priorität</label>
                            <select class="form-select" id="editTaskPriority" name="priority">
                                {% for _priority in ["Niedrig", "Mittel", "Hoch"] %}
                                    <option value="{{ _priority }}" {{ task.priority == _priority ? "selected" : "" }}>
                                        {{ _priority }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editTaskStatus" class="form-label">Status</label>
                            <select class="form-select" id="editTaskStatus" name="status">
                                {% for _value, _label in _status_labels %}
                                    <option value="{{ _value }}" {{ task.status == _value ? "selected" : "" }}>
                                        {{ _label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editTaskStartDate" class="form-label">Beginn</label>
                            <input type="date"
                                   class="form-control"
                                   id="editTaskStartDate"
                                   name="start_date"
                                   value="{{ task.start_date ? task.start_date|date("Y-m-d") : "" }}">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editTaskDueDate" class="form-label">Fällig bis</label>
                            <input type="date"
                                   class="form-control"
                                   id="editTaskDueDate"
                                   name="due_date"
                                   value="{{ _due_ymd }}">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editTaskDescription" class="form-label">Beschreibung</label>
                        <textarea class="form-control tinymce-editor"
                                  id="editTaskDescription"
                                  name="description"
                                  rows="5">{{ task.description|raw }}</textarea>
                    </div>

                    <div class="task-delete-zone">
                        <p class="text-muted small mb-2">
                            Löschen entfernt die Aufgabe samt Kommentaren, Anhängen und Verlauf.
                            Nicht gespeicherte Änderungen hier gehen dabei verloren.
                        </p>
                        <button type="submit" form="deleteTaskForm" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i> Aufgabe löschen
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">Änderungen speichern</button>
                </div>
            </form>
        </div>
    </div>
{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
{% endblock styles %}

{% block scripts %}
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="{{ asset_path('/js/tom-select-init.js') }}"></script>
{% endblock scripts %}
