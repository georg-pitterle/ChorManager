{% extends "layout.twig" %}

{% import "macros/help.twig" as help %}

{% block editor_scripts %}
    <script src="/vendor/tinymce/tinymce/tinymce.min.js"></script>
{% endblock editor_scripts %}

{% block title %}
    Aufgaben - {{ project.name }} - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/projects">Projekte</a></li>
                    <li class="breadcrumb-item active">{{ project.name }}</li>
                </ol>
            </nav>
            <h1 class="h2 mb-1">Projektplanung (Aufgaben)</h1>
            <p class="text-muted mb-0">Zuweisungen und Statusberichte für das Projekt.</p>
        </div>
        <div class="page-actions">
            {{ help.button("projects-planning", "Projektplanung (Aufgaben)") }}
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addTaskModal">
                Neue Aufgabe
            </button>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context"
                 aria-labelledby="project-tasks-title">
            <div class="dashboard-section-head">
                <div>
                    <h2 class="dashboard-section-title" id="project-tasks-title">Aufgabenübersicht</h2>
                    <p class="dashboard-section-lead mb-0">{{ tasks|length }} Aufgaben im aktuellen Ergebnis.</p>
                </div>
                <div class="btn-group" role="group" aria-label="Ansicht umschalten">
                    <button type="button"
                            id="btn-view-list"
                            class="btn btn-sm btn-outline-secondary active"
                            aria-pressed="true">
                        <i class="bi bi-list-ul"></i> Liste
                    </button>
                    <button type="button"
                            id="btn-view-kanban"
                            class="btn btn-sm btn-outline-secondary"
                            aria-pressed="false">
                        <i class="bi bi-kanban"></i> Kanban
                    </button>
                </div>
            </div>

            {# ── LIST VIEW ── #}
            <div id="list-view">
                <div class="surface-card card border-0 table-shell"
                     data-table-engine="true"
                     data-table-id="tasks.index"
                     data-default-view="auto"
                     data-default-page-size="100"
                     data-page-size-options="25,50,100,200"
                     data-default-sort-key="due_date">
                    {{ include('partials/table_toolbar.twig') }}
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 table-responsive-cards"
                                   id="tasksTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th data-sort-key="task_title" data-sort-type="text">Titel</th>
                                        <th data-sort-key="assignee_name" data-sort-type="text">Verantwortlich</th>
                                        <th data-sort-key="due_date" data-sort-type="date">Fällig am</th>
                                        <th>Priorität</th>
                                        <th data-sort-key="task_status" data-sort-type="text">Status</th>
                                        <th class="text-end">Aktionen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for task in tasks %}
                                        <tr data-sort-task_title="{{ task.name|lower }}"
                                            data-sort-assignee_name="{{ task.assignees|length > 0 ? task.assignees|map(u => u|person_name)|sort|first|lower : "" }}"
                                            data-sort-due_date="{{ task.end_date ? task.end_date|date('Y-m-d') : '9999-12-31' }}"
                                            data-sort-task_status="{{ task.status|lower }}">
                                            <td data-label="Titel" data-card-title>
                                                {{ task.name }}
                                                {% if task.comments_count > 0 %}
                                                    <span class="badge text-bg-light ms-2"
                                                          title="{{ task.comments_count }} Kommentare"><i class="bi bi-chat"></i> {{ task.comments_count }}</span>
                                                {% endif %}
                                            </td>
                                            <td data-label="Verantwortlich">
                                                {% if task.assignees|length > 0 %}
                                                    {{ task.assignees|map(u => u|person_name)|sort|join(", ") }}
                                                {% else %}
                                                    <span class="text-muted fst-italic">Nicht zugewiesen</span>
                                                {% endif %}
                                            </td>
                                            <td data-label="Fällig am">
                                                {% if task.end_date %}
                                                    {% set due = task.end_date|date('Y-m-d') %}
                                                    {% set today = 'now'|date('Y-m-d') %}
                                                    <span class="{{ due < today and task.status != "done" ? "text-danger fw-bold" : "" }}">
                                                        {{ task.end_date|date('d.m.Y') }}
                                                    </span>
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                            <td data-label="Priorität">
                                                <span class="badge {{ priority_badges[task.priority]|default("text-bg-secondary") }}">
                                                    {{ priority_labels[task.priority]|default(task.priority) }}
                                                </span>
                                            </td>
                                            <td data-label="Status">
                                                <span class="badge {{ status_badges[task.status]|default("text-bg-secondary") }}">
                                                    <i class="bi {{ status_icons[task.status]|default("bi-circle") }}"></i>
                                                    {{ status_labels[task.status]|default(task.status) }}
                                                </span>
                                            </td>
                                            <td data-label="Aktionen" class="text-end">
                                                <div class="btn-group"
                                                     role="group"
                                                     aria-label="Aktionen für Aufgabe {{ task.name }}">
                                                    <a href="/tasks/{{ task.id }}" class="btn btn-sm btn-outline-secondary text-nowrap">
                                                        Details <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">Bisher wurden keine Aufgaben für dieses Projekt angelegt.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            {# ── KANBAN VIEW ── #}
            <div id="kanban-view" hidden>
                <div class="kanban-container">
                    <div class="row g-3" id="kanban-board">

                        {# Eine Spalte je Zustand, in der Reihenfolge von Task::STATUSES.
                           Vorher stand dieser Block viermal fast wortgleich da - verschieden
                           waren nur Zustand, Beschriftung, Sinnbild, Abzeichen-Klasse und der
                           Hinweis in der leeren Spalte. Alle fünf kommen jetzt aus den
                           Zuordnungen am Modell. #}
                        {% for status in statuses %}
                            {% set column_tasks = tasks|filter(task => task.status == status) %}
                            <div class="col-12 col-md-6 col-xl-3">
                                <div class="kanban-column" data-status="{{ status }}">
                                    <div class="kanban-column-header">
                                        <h3>
                                            <i class="bi {{ status_icons[status] }} {{ status_icon_colors[status] }} me-2"></i>{{ status_labels[status] }}
                                            <span class="badge {{ status_badges[status] }} ms-2"
                                                  id="count-{{ status }}">{{ column_tasks|length }}</span>
                                        </h3>
                                    </div>
                                    <div class="kanban-cards-container"
                                         data-drop-zone="{{ status }}"
                                         data-empty-text="{{ status_empty_texts[status] }}">
                                        {% for task in column_tasks %}
                                            <div class="kanban-card"
                                                 data-task-id="{{ task.id }}"
                                                 data-task-status="{{ task.status }}"
                                                 draggable="true">
                                                <div class="kanban-card-title">
                                                    <a href="/tasks/{{ task.id }}">{{ task.name }}</a>
                                                    {% if task.comments_count > 0 %}
                                                        <span class="badge text-bg-light ms-1"
                                                              title="{{ task.comments_count }} Kommentare"><i class="bi bi-chat"></i> {{ task.comments_count }}</span>
                                                    {% endif %}
                                                </div>
                                                <div class="kanban-card-meta">
                                                    <span>
                                                        <span class="kanban-card-badge badge {{ priority_badges[task.priority]|default("text-bg-secondary") }}">
                                                            {{ priority_labels[task.priority]|default(task.priority) }}
                                                        </span>
                                                    </span>
                                                    <span>
                                                        {% if task.end_date %}
                                                            {% set due = task.end_date|date("Y-m-d") %}
                                                            {% set today = "now"|date("Y-m-d") %}
                                                            <i class="bi bi-calendar3"></i>
                                                            {# Rot nur bei offener Arbeit - wie in der Listenansicht.
                                                               data-past-due lässt das Board die Warnung nach einem
                                                               Zug anpassen (kanban-sortable-init.js). #}
                                                            {% set _past_due = due < today %}
                                                            {% set _warn = _past_due and task.status != "done" %}
                                                            <span class="{{ _warn ? "kanban-date-warning" : "" }}"{% if _past_due %} data-past-due{% endif %}>
                                                                {{- task.end_date|date("d.m.Y") -}}
                                                            </span>
                                                        {% endif %}
                                                        {% for assignee in task.assignees %}
                                                            <span class="avatar-initials ms-1"
                                                                  title="{{ assignee|person_name }}">{{ assignee.first_name|slice(0, 1) }}{{ assignee.last_name|slice(0, 1) }}</span>
                                                        {% endfor %}
                                                    </span>
                                                </div>
                                            </div>
                                        {% endfor %}
                                        {% if column_tasks is empty %}
                                            <div class="kanban-empty-placeholder">
                                                <i class="bi bi-inbox"></i>
                                                <span>{{ status_empty_texts[status] }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}

                    </div>
                </div>
            </div>

        </section>
    </div>

    <!-- Add Task Modal -->
    <div class="modal fade"
         id="addTaskModal"
         tabindex="-1"
         aria-labelledby="addTaskModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <form action="/projects/{{ project.id }}/tasks"
                  method="post"
                  class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTaskModalLabel">Neue Aufgabe anlegen</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="title" class="form-label">Titel der Aufgabe *</label>
                        <input type="text" class="form-control" id="title" name="title" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="assigned_user_ids" class="form-label">Zugewiesen an (optional)</label>
                            <select class="form-select"
                                    id="assigned_user_ids"
                                    name="assigned_user_ids[]"
                                    data-tom-select
                                    data-placeholder="Personen wählen …"
                                    multiple>
                                {% for u in projectUsers %}<option value="{{ u.id }}">{{ u|person_name }}</option>{% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="priority" class="form-label">Priorität</label>
                            <select class="form-select" id="priority" name="priority">
                                {% for priority in priorities %}
                                    <option value="{{ priority }}"
                                            {{ priority == "medium" ? "selected" : "" }}>{{ priority_labels[priority] }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="status" class="form-label">Status</label>
                            {# Alle vier Zustände, auch "blockiert": Das Auswahlfeld kannte
                               nur drei, obwohl das Board eine Spalte dafür hat und
                               TaskController::validateStatus() den Wert längst annimmt. #}
                            <select class="form-select" id="status" name="status">
                                {% for status in statuses %}
                                    <option value="{{ status }}"
                                            {{ status == "open" ? "selected" : "" }}>{{ status_labels[status] }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="start_date" class="form-label">Startdatum</label>
                            <input type="date" class="form-control" id="start_date" name="start_date">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="due_date" class="form-label">Fälligkeitsdatum</label>
                            <input type="date" class="form-control" id="due_date" name="due_date">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Beschreibung</label>
                        <textarea class="form-control tinymce-editor"
                                  id="description"
                                  name="description"
                                  rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">Aufgabe Speichern</button>
                </div>
            </form>
        </div>
    </div>
{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
{% endblock styles %}

{% block scripts %}
    <script src="/js/vendor/sortable.min.js"></script>
    <script src="/js/kanban-sortable-init.js"></script>
    <script src="{{ asset_path('/js/tasks-kanban.js') }}"></script>
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="{{ asset_path('/js/tom-select-init.js') }}"></script>
{% endblock scripts %}
