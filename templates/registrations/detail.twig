{% extends "layout.twig" %}

{% import "macros/help.twig" as help %}

{% block title %}
    {{ event.title }} – Anmeldung - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">{{ event.title }}</h1>
            <p class="text-muted mb-0">
                {{ schedule.weekday }} {{ event.starts_at|date("d.m.Y") }},
                {{ event.starts_at|date("H:i") }}–{{ event.ends_at|date("H:i") }} Uhr
                {% if event.location %} · {{ event.location }}{% endif %}
                · <span class="badge text-bg-{{ schedule.type_color }}">{{ schedule.type_name }}</span>
            </p>
            <p class="text-muted small mb-0">{{ include("registrations/partials/deadline.twig") }}</p>
        </div>
        <div class="page-actions">
            {{ help.button("events-registrations", "Anmeldungen (Zu-/Absagen)") }}
            <a href="/registrations" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Zurück
            </a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% set answer_labels = {yes: "Zusage", maybe: "Vielleicht", no: "Absage"} %}
    {% set own_status = own_registration ? own_registration.status : null %}

    {{ include("registrations/partials/flash.twig") }}

    <div class="card mb-3">
        <div class="card-body registration-overview">
            {{ include("registrations/partials/counts.twig", {
                yes: counts.yes, no: counts.no, maybe: counts.maybe, open: counts.open
            }) }}
            <span class="text-muted small">
                Rücklauf: {{ answered }} von {{ total_eligible }} ({{ response_rate }} %)
            </span>
        </div>
    </div>

    {% if registration_open %}
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0">Meine Antwort</h2>
            </div>
            <div class="card-body">
                <form method="post" action="/registrations/{{ event.id }}" class="registration-own-form">
                    <div class="btn-group w-100 mb-3 attendance-status-group registration-answer__group"
                         role="group"
                         aria-label="Eigener Anmeldestatus">
                        <input type="radio"
                               class="btn-check"
                               name="status"
                               id="status-yes"
                               value="yes"
                               required
                               {% if own_status == "yes" %}checked{% endif %}>
                        <label class="btn btn-outline-success" for="status-yes">
                            <i class="bi bi-check-circle" aria-hidden="true"></i> Zusage
                        </label>
                        <input type="radio"
                               class="btn-check"
                               name="status"
                               id="status-maybe"
                               value="maybe"
                               {% if own_status == "maybe" %}checked{% endif %}>
                        <label class="btn btn-outline-warning" for="status-maybe">
                            <i class="bi bi-question-circle" aria-hidden="true"></i> Vielleicht
                        </label>
                        <input type="radio"
                               class="btn-check"
                               name="status"
                               id="status-no"
                               value="no"
                               {% if own_status == "no" %}checked{% endif %}>
                        <label class="btn btn-outline-danger" for="status-no">
                            <i class="bi bi-x-circle" aria-hidden="true"></i> Absage
                        </label>
                    </div>
                    <div class="mb-3 registration-note-field">
                        <label class="form-label" for="registration-note">
                            Begründung <span class="text-muted">(optional, hilfreich bei einer Absage)</span>
                        </label>
                        <input type="text"
                               class="form-control"
                               id="registration-note"
                               name="note"
                               maxlength="255"
                               value="{{ own_registration ? own_registration.note : "" }}">
                    </div>
                    <div class="form-action-bar">
                        <button type="submit" class="btn btn-primary">Antwort speichern</button>
                        {% if own_registration %}
                            <button type="submit"
                                    name="status"
                                    value="open"
                                    class="btn btn-link registration-answer__reset"
                                    formnovalidate>
                                Antwort zurücknehmen
                            </button>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            Der Anmeldeschluss ist vorbei – Änderungen sind nicht mehr möglich.
            {% if own_status %}
                Deine Antwort: <strong>{{ answer_labels[own_status] }}</strong>.
            {% else %}
                Du hast nicht geantwortet.
            {% endif %}
        </div>
    {% endif %}

    {% set proxy_mode = can_manage_others and registration_open %}

    {% if proxy_mode %}
        <form method="post" action="/registrations/{{ event.id }}/proxy">
            <input type="hidden" name="state_hash" value="{{ state_hash|default("") }}">
    {% endif %}

    <div class="row">
        {% for group_name, members in voice_groups %}
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ group_name }}</h2>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for member in members %}
                            {% set is_self = member.user_id == session.user_id %}
                            {% set _proxy_ok = proxy_mode and member.editable %}
                            {% set proxy_editable = _proxy_ok and not is_self %}
                            <li class="list-group-item">
                                <div class="fw-bold mb-1">
                                    {{ member|person_name }}
                                    {% if not proxy_editable %}
                                        {% if member.status == "yes" %}
                                            <span class="badge registration-badge-yes">Zusage</span>
                                        {% elseif member.status == "no" %}
                                            <span class="badge registration-badge-no">Absage</span>
                                        {% elseif member.status == "maybe" %}
                                            <span class="badge registration-badge-maybe">Vielleicht</span>
                                        {% else %}
                                            <span class="badge registration-badge-open">Ohne Antwort</span>
                                        {% endif %}
                                    {% endif %}
                                    {% if is_self and _proxy_ok %}
                                        <small class="text-muted fw-normal">(du – oben unter „Meine Antwort“)</small>
                                    {% endif %}
                                    {% if member.updated_by_name %}
                                        <small class="text-muted fw-normal">(eingetragen von {{ member.updated_by_name }})</small>
                                    {% endif %}
                                </div>

                                {% if proxy_editable %}
                                    <div class="btn-group w-100 mb-2 attendance-status-group"
                                         role="group" aria-label="Anmeldestatus von {{ member|person_name }}">
                                        {# "Offen" ist der Ausgangszustand und macht ihn wieder
                                           herstellbar; ohne ihn ließe sich ein einmal gesetzter
                                           Eintrag nie mehr zurücknehmen. #}
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_open"
                                               value="open"
                                               {% if member.status not in ["yes", "no", "maybe"] %}checked{% endif %}>
                                        <label class="btn btn-outline-secondary" for="reg_{{ member.user_id }}_open">
                                            <i class="bi bi-dash-circle" aria-hidden="true"></i> Offen
                                        </label>
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_yes"
                                               value="yes"
                                               {% if member.status == "yes" %}checked{% endif %}>
                                        <label class="btn btn-outline-success" for="reg_{{ member.user_id }}_yes">
                                            <i class="bi bi-check-circle" aria-hidden="true"></i> Zusage
                                        </label>
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_maybe"
                                               value="maybe"
                                               {% if member.status == "maybe" %}checked{% endif %}>
                                        <label class="btn btn-outline-warning" for="reg_{{ member.user_id }}_maybe">
                                            <i class="bi bi-question-circle" aria-hidden="true"></i> Vielleicht
                                        </label>
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_no"
                                               value="no"
                                               {% if member.status == "no" %}checked{% endif %}>
                                        <label class="btn btn-outline-danger" for="reg_{{ member.user_id }}_no">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i> Absage
                                        </label>
                                    </div>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           name="note[{{ member.user_id }}]"
                                           maxlength="255"
                                           placeholder="Begründung (optional)"
                                           value="{{ member.note }}"
                                           aria-label="Begründung zu {{ member|person_name }}">
                                {% elseif member.note %}
                                    <div class="text-muted small">{{ member.note }}</div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if proxy_mode %}
            <div class="form-action-bar">
                <button type="submit" class="btn btn-primary">
                    Einträge für andere speichern
                </button>
            </div>
        </form>
    {% endif %}
{% endblock %}
