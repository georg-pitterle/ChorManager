{% extends "layout.twig" %}

{% block title %}
    Anmeldung - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Anmeldung</p>
            <h1 class="h2 mb-1">{{ event.title }}</h1>
            <p class="text-muted mb-0">
                {{ event.starts_at|date("d.m.Y H:i") }}
                {% if event.location %} &middot; {{ event.location }}{% endif %}
                &middot; Anmeldeschluss: {{ event.registrationDeadlineAt()|date("d.m.Y H:i") }}
            </p>
        </div>
        <div class="page-actions">
            <a href="/registrations" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Zurück</a>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

    <div class="card mb-3">
        <div class="card-body">
            <span class="badge registration-badge-yes">{{ counts.yes }} Zusagen</span>
            <span class="badge registration-badge-no">{{ counts.no }} Absagen</span>
            <span class="badge registration-badge-maybe">{{ counts.maybe }} Vielleicht</span>
            <span class="badge registration-badge-open">{{ counts.open }} Offen</span>
            <span class="ms-2 text-muted small">
                Rücklauf: {{ answered }} von {{ total_eligible }} ({{ response_rate }} %)
            </span>
        </div>
    </div>

    {% if registration_open %}
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Meine Anmeldung</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/registrations/{{ event.id }}" class="registration-own-form">
                    {% set own_status = own_registration ? own_registration.status : null %}
                    <div class="btn-group w-100 mb-2 attendance-status-group"
                         role="group"
                         aria-label="Eigener Anmeldestatus">
                        <input type="radio"
                               class="btn-check"
                               name="status"
                               id="status-yes"
                               value="yes"
                               {% if own_status == "yes" %}checked{% endif %}>
                        <label class="btn btn-outline-success" for="status-yes">
                            <i class="bi bi-check-circle"></i> Zusage
                        </label>
                        <input type="radio"
                               class="btn-check"
                               name="status"
                               id="status-maybe"
                               value="maybe"
                               {% if own_status == "maybe" %}checked{% endif %}>
                        <label class="btn btn-outline-warning" for="status-maybe">
                            <i class="bi bi-question-circle"></i> Vielleicht
                        </label>
                        <input type="radio"
                               class="btn-check"
                               name="status"
                               id="status-no"
                               value="no"
                               {% if own_status == "no" %}checked{% endif %}>
                        <label class="btn btn-outline-danger" for="status-no">
                            <i class="bi bi-x-circle"></i> Absage
                        </label>
                    </div>
                    <div class="mb-2 registration-note-field">
                        <label class="form-label" for="registration-note">Begründung (optional, v. a. bei Absage)</label>
                        <input type="text"
                               class="form-control"
                               id="registration-note"
                               name="note"
                               maxlength="255"
                               value="{{ own_registration ? own_registration.note : "" }}">
                    </div>
                    <button type="submit" class="btn btn-primary">Speichern</button>
                </form>
            </div>
        </div>
    {% else %}
        <div class="alert alert-secondary">Der Anmeldeschluss ist vorbei — Änderungen sind nicht mehr möglich.</div>
    {% endif %}

    {% set proxy_mode = can_manage_others and registration_open %}

    {% if proxy_mode %}
        <form method="post" action="/registrations/{{ event.id }}/proxy">
    {% endif %}

    <div class="row">
        {% for group_name, members in voice_groups %}
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">{{ group_name }}</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for member in members %}
                            {% set is_self = member.user_id == session.user_id %}
                            {% set _proxy_ok = proxy_mode and member.editable %}
                            {% set proxy_editable = _proxy_ok and not is_self %}
                            <li class="list-group-item">
                                <div class="fw-bold mb-1">
                                    {{ member.last_name }}, {{ member.first_name }}
                                    {% if not proxy_editable %}
                                        {% if member.status == "yes" %}
                                            <span class="badge registration-badge-yes">Zusage</span>
                                        {% elseif member.status == "no" %}
                                            <span class="badge registration-badge-no">Absage</span>
                                        {% elseif member.status == "maybe" %}
                                            <span class="badge registration-badge-maybe">Vielleicht</span>
                                        {% else %}
                                            <span class="badge registration-badge-open">Offen</span>
                                        {% endif %}
                                    {% endif %}
                                    {% if member.updated_by_name %}
                                        <small class="text-muted fw-normal">(eingetragen von {{ member.updated_by_name }})</small>
                                    {% endif %}
                                </div>

                                {% if proxy_editable %}
                                    <div class="btn-group w-100 mb-2 attendance-status-group" role="group">
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_yes"
                                               value="yes"
                                               {% if member.status == "yes" %}checked{% endif %}>
                                        <label class="btn btn-outline-success" for="reg_{{ member.user_id }}_yes">
                                            <i class="bi bi-check-circle"></i> Zusage
                                        </label>
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_maybe"
                                               value="maybe"
                                               {% if member.status == "maybe" %}checked{% endif %}>
                                        <label class="btn btn-outline-warning" for="reg_{{ member.user_id }}_maybe">
                                            <i class="bi bi-question-circle"></i> Vielleicht
                                        </label>
                                        <input type="radio"
                                               class="btn-check"
                                               name="registration[{{ member.user_id }}]"
                                               id="reg_{{ member.user_id }}_no"
                                               value="no"
                                               {% if member.status == "no" %}checked{% endif %}>
                                        <label class="btn btn-outline-danger" for="reg_{{ member.user_id }}_no">
                                            <i class="bi bi-x-circle"></i> Absage
                                        </label>
                                    </div>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           name="note[{{ member.user_id }}]"
                                           maxlength="255"
                                           placeholder="Begründung (optional)"
                                           value="{{ member.note }}">
                                {% elseif member.note %}
                                    <div class="text-muted small">{{ member.note }}</div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if proxy_mode %}
            <div class="sticky-bottom bg-light p-3 border-top d-flex justify-content-end shadow">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check"></i> Vertretungseinträge speichern
                </button>
            </div>
        </form>
    {% endif %}
{% endblock %}
