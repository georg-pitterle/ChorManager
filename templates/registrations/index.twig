{% extends "layout.twig" %}

{% import "macros/help.twig" as help %}

{% block title %}
    Anmeldungen - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock %}

{% block page_header %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-1">Anmeldungen</h1>
            <p class="text-muted mb-0">Sag bis zum Anmeldeschluss Bescheid, ob du dabei bist.</p>
        </div>
        <div class="page-actions">
            {{ help.button("events-registrations", "Anmeldungen (Zu-/Absagen)") }}
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% set answer_labels = {yes: "Zusage", maybe: "Vielleicht", no: "Absage"} %}
    {% set final_labels = {yes: "Du hast zugesagt", maybe: "Du hast mit Vielleicht geantwortet", no: "Du hast abgesagt"} %}

    {{ include("registrations/partials/flash.twig") }}

    {% if rows is empty %}
        <div class="event-empty">
            <p class="mb-2">Gerade ist nichts zu beantworten.</p>
            <p class="text-muted small mb-3">Sobald ein Termin zur Anmeldung freigeschaltet wird, erscheint er hier.</p>
            <a href="/events" class="btn btn-outline-secondary">Zum Terminplan</a>
        </div>
    {% else %}
        <p class="registration-summary{{ unanswered_count > 0 ? " is-pending" : "" }}"
           data-registration-summary
           data-pending="{{ unanswered_count }}"
           role="status">
            {% if unanswered_count > 0 %}
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <span>
                    <strong>{{ unanswered_count }} {{ unanswered_count == 1 ? "Termin wartet" : "Termine warten" }}</strong>
                    auf deine Antwort.
                </span>
            {% else %}
                <i class="bi bi-check2-all" aria-hidden="true"></i>
                <span>Du hast auf alle Termine geantwortet – danke!</span>
            {% endif %}
        </p>
    {% endif %}

    {% for month in months %}
        <section class="event-plan__month" aria-labelledby="registration-month-{{ month.key }}">
            <h2 class="event-plan__month-title" id="registration-month-{{ month.key }}">{{ month.label }}</h2>
            <ol class="event-plan__list registration-plan">
                {% for row in month.events %}
                    {% set event = row.event %}
                    {% set _item_classes = ["event-plan__item", "registration-plan__item"] %}
                    {% if row.is_highlighted %}{% set _item_classes = _item_classes|merge(["is-highlighted"]) %}{% endif %}
                    {% if row.unanswered %}{% set _item_classes = _item_classes|merge(["is-unanswered"]) %}{% endif %}
                    <li class="{{ _item_classes|join(" ") }}"
                        data-registration-card
                        data-event-id="{{ event.id }}"
                        data-unanswered="{{ row.unanswered ? "1" : "0" }}">
                        <div class="event-plan__date" aria-hidden="true">
                            <span class="event-plan__weekday">{{ row.weekday }}</span>
                            <span class="event-plan__day">{{ event.starts_at|date("j") }}</span>
                        </div>
                        <div class="event-plan__body">
                            <h3 class="registration-plan__heading">
                                <a href="/registrations/{{ event.id }}" class="event-plan__title">
                                    <span class="visually-hidden">{{ row.weekday }} {{ event.starts_at|date("d.m.") }}:</span>
                                    {{ event.title }}
                                </a>
                            </h3>
                            <div class="event-plan__meta">
                                {{ event.starts_at|date("H:i") }}–{{ event.ends_at|date("H:i") }} Uhr
                                {% if event.location %} · {{ event.location }}{% endif %}
                            </div>
                            <div class="event-plan__meta">
                                {{ include("registrations/partials/deadline.twig", {schedule: row}) }}
                            </div>
                        </div>
                        <div class="event-plan__aside">
                            {% if row.relative_label %}
                                <span class="event-relative">{{ row.relative_label }}</span>
                            {% endif %}
                            {% if row.unanswered %}
                                <span class="registration-missing" data-missing-badge>Antwort fehlt</span>
                            {% endif %}
                            <span class="badge text-bg-{{ row.type_color }}">{{ row.type_name }}</span>
                        </div>
                        <div class="registration-plan__answer">
                            {% if row.open %}
                                <form method="post"
                                      action="/registrations/{{ event.id }}"
                                      class="registration-answer registration-self-form"
                                      data-event-id="{{ event.id }}">
                                    <div class="btn-group registration-answer__group"
                                         role="group" aria-label="Deine Antwort für {{ event.title }}">
                                        {{ include("registrations/partials/answer_button.twig", {
                                            status: "yes", color: "success", icon: "check-circle"
                                        }) }}
                                        {{ include("registrations/partials/answer_button.twig", {
                                            status: "maybe", color: "warning", icon: "question-circle"
                                        }) }}
                                        {{ include("registrations/partials/answer_button.twig", {
                                            status: "no", color: "danger", icon: "x-circle"
                                        }) }}
                                    </div>
                                    <div class="registration-answer__footer">
                                        <span class="registration-answer__status" data-answer-status>
                                            {% if row.own_status %}
                                                Deine Antwort: {{ answer_labels[row.own_status] }}
                                            {% else %}
                                                Noch keine Antwort
                                            {% endif %}
                                        </span>
                                        <button type="submit"
                                                name="status"
                                                value="open"
                                                data-status="open"
                                                class="btn btn-link registration-answer__reset"
                                                {% if not row.own_status %}hidden{% endif %}>
                                            Antwort zurücknehmen
                                        </button>
                                        <a href="/registrations/{{ event.id }}" class="registration-answer__more">
                                            Mit Begründung antworten
                                        </a>
                                    </div>
                                </form>
                            {% else %}
                                <div class="registration-answer is-closed">
                                    <span class="registration-final registration-final--{{ row.own_status ?: "open" }}">
                                        {{ final_labels[row.own_status] ?? "Du hast nicht geantwortet" }}
                                    </span>
                                    <span class="registration-answer__status">
                                        Anmeldeschluss vorbei – Änderungen sind nicht mehr möglich.
                                    </span>
                                </div>
                            {% endif %}
                            {{ include("registrations/partials/counts.twig", {
                                yes: row.yes_count, no: row.no_count, maybe: row.maybe_count, open: row.open_count
                            }) }}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        </section>
    {% endfor %}
{% endblock %}

{% block scripts %}
    <script src="/js/registrations.js"></script>
{% endblock scripts %}
