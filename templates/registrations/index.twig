{% extends "layout.twig" %}

{% block title %}
    Anmeldungen - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Termine</p>
            <h1 class="h2 mb-1">Anmeldungen</h1>
            <p class="text-muted mb-0">Zu- und Absagen für freigeschaltete Termine verwalten.</p>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

    {% if rows is empty %}
        <div class="alert alert-info">Aktuell sind keine Termine zur Anmeldung freigeschaltet.</div>
    {% endif %}

    <div class="registration-card-list">
        {% for row in rows %}
            <div class="card mb-2 registration-card" data-registration-card data-event-id="{{ row.event.id }}">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <div class="flex-grow-1">
                        <a href="/registrations/{{ row.event.id }}" class="fw-bold text-decoration-none">
                            {{ row.event.title }}
                        </a>
                        <div class="text-muted small">
                            {{ row.event.starts_at|date("d.m.Y H:i") }}
                            {% if row.event.location %} &middot; {{ row.event.location }}{% endif %}
                            &middot; Anmeldeschluss: {{ row.event.registrationDeadlineAt()|date("d.m.Y H:i") }}
                        </div>
                    </div>
                    <div class="registration-counters small">
                        <span class="badge registration-badge-yes"><span data-count="yes">{{ row.yes_count }}</span> Zusagen</span>
                        <span class="badge registration-badge-no"><span data-count="no">{{ row.no_count }}</span> Absagen</span>
                        <span class="badge registration-badge-maybe"><span data-count="maybe">{{ row.maybe_count }}</span> Vielleicht</span>
                        <span class="badge registration-badge-open"><span data-count="open">{{ row.open_count }}</span> Offen</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        {% if row.open %}
                            {% set yes_active = row.own_status == "yes" %}
                            {% set maybe_active = row.own_status == "maybe" %}
                            {% set no_active = row.own_status == "no" %}
                            <form method="post"
                                  action="/registrations/{{ row.event.id }}"
                                  class="btn-group btn-group-sm registration-self-form"
                                  data-event-id="{{ row.event.id }}">
                                <button type="submit"
                                        name="status"
                                        value="yes"
                                        data-status="yes"
                                        class="btn {{ yes_active ? "btn-success" : "btn-outline-success" }}">
                                    <i class="bi bi-check-circle"></i> Zusage
                                </button>
                                <button type="submit"
                                        name="status"
                                        value="maybe"
                                        data-status="maybe"
                                        class="btn {{ maybe_active ? "btn-warning" : "btn-outline-warning" }}">
                                    <i class="bi bi-question-circle"></i> Vielleicht
                                </button>
                                <button type="submit"
                                        name="status"
                                        value="no"
                                        data-status="no"
                                        class="btn {{ no_active ? "btn-danger" : "btn-outline-danger" }}">
                                    <i class="bi bi-x-circle"></i> Absage
                                </button>
                            </form>
                            <a href="/registrations/{{ row.event.id }}" class="btn btn-sm btn-outline-secondary">Details</a>
                        {% else %}
                            <span class="badge text-bg-secondary">Anmeldeschluss vorbei</span>
                            <a href="/registrations/{{ row.event.id }}" class="btn btn-sm btn-outline-secondary">Details</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block scripts %}
    <script src="/js/registrations.js"></script>
{% endblock scripts %}
