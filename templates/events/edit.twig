{% extends "layout.twig" %}

{% block title %}
    Termin bearbeiten - {{ app_settings.app_name|default('Chor-Manager') }}
{% endblock title %}

{% block content %}
    {% set form = edit_form|default({}) %}
    <div class="row mt-4">
        <div class="col-12 mb-4">
            <h1>Termin bearbeiten</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/events">Termine</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">{{ event.title }}</li>
                </ol>
            </nav>
        </div>
    </div>

    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form action="/events/{{ event.id }}/update" method="post" class="event-audience-form">
                        <div class="mb-3">
                            <label for="title" class="form-label">Titel *</label>
                            <input type="text"
                                   class="form-control"
                                   id="title"
                                   name="title"
                                   value="{{ form.title|default(event.title) }}"
                                   required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="starts_at" class="form-label">Datum *</label>
                                <input type="date"
                                       class="form-control"
                                       id="starts_at"
                                       name="starts_at"
                                       value="{{ form.starts_at|default(event.starts_at|date('Y-m-d')) }}"
                                       required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="start_time" class="form-label">Von *</label>
                                <input type="time"
                                       class="form-control"
                                       id="start_time"
                                       name="start_time"
                                       value="{{ form.start_time|default(event.starts_at|date('H:i')) }}"
                                       required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="end_time" class="form-label">Bis *</label>
                                <input type="time"
                                       class="form-control"
                                       id="end_time"
                                       name="end_time"
                                       value="{{ form.end_time|default(event.ends_at|date('H:i')) }}"
                                       required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="event_type_id" class="form-label">Typ *</label>
                                <select class="form-select" id="event_type_id" name="event_type_id" required>
                                    {% for et in event_types %}
                                        <option value="{{ et.id }}"
                                                {% if form.event_type_id|default(event.event_type_id) == et.id %}selected{% endif %}>
                                            {{ et.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="location" class="form-label">Ort (Optional)</label>
                            <input type="text"
                                   class="form-control"
                                   id="location"
                                   name="location"
                                   value="{{ form.location|default(event.location) }}">
                        </div>

{% set _notify_default_checked = form.notify_members is not defined %}
                        {# Das versteckte Feld sagt dem Server, dass dieses Formular
                           die Frage ueberhaupt gestellt hat. Ohne es waere ein fehlendes
                           Haekchen nicht von einem alten Formular zu unterscheiden, das
                           die Frage gar nicht kennt - und dann entschiede der Zufall,
                           ob benachrichtigt wird. #}
                        <input type="hidden" name="notify_members_present" value="1">
                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="notify-members-edit"
                                   name="notify_members"
                                   value="1"
                                   {% if _notify_default_checked or form.notify_members %}checked{% endif %}>
                            <label class="form-check-label" for="notify-members-edit">Mitglieder benachrichtigen</label>
                            <div class="form-text">
                                Schickt der Zielgruppe eine Mail. Bei einer reinen Korrektur besser abwählen.
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="attendance-required"
                                   name="attendance_required"
                                   value="1"
                                   {% if form.attendance_required %}checked{% endif %}>
                            <label class="form-check-label" for="attendance-required">Anwesenheitsliste führen</label>
                        </div>
                        {% if settings.modules.registration %}
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="registration-enabled"
                                       name="registration_enabled"
                                       value="1"
                                       {% if form.registration_enabled %}checked{% endif %}>
                                <label class="form-check-label" for="registration-enabled">Anmeldung freischalten</label>
                            </div>
                            <div class="mb-3">
                                <label for="registration-deadline" class="form-label">
                                    Anmeldeschluss (optional, sonst Terminbeginn)
                                </label>
                                <input type="datetime-local"
                                       class="form-control"
                                       id="registration-deadline"
                                       name="registration_deadline"
                                       value="{{ form.registration_deadline|default('') }}"
                                       aria-describedby="registration-deadline-help">
                                {% if event.series_id %}
                                    <div id="registration-deadline-help" class="form-text">
                                        Bei „Änderungen auf zukünftige Termine der Serie anwenden“ wird der
                                        Anmeldeschluss als Vorlauf zum jeweiligen Terminbeginn übernommen.
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            {% if event.registration_enabled %}
                                <input type="hidden" name="registration_enabled" value="1">
                            {% endif %}
                            {% if event.registration_deadline %}
                                <input type="hidden"
                                       name="registration_deadline"
                                       value="{{ event.registration_deadline|date("Y-m-d\\TH:i") }}">
                            {% endif %}
                        {% endif %}

                        {% include "events/_audience_sources.twig" %}

                        {% if event.series_id %}
                            {% set series_fields = form.series_fields|default(["title", "location", "time", "registration", "attendance", "audience"]) %}
                            <div class="mb-3 form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="update_series"
                                       name="update_series"
                                       value="1"
                                       {% if form.update_series|default(false) %}checked{% endif %}>
                                <label class="form-check-label" for="update_series">Änderungen auf zukünftige Termine der Serie anwenden?</label>
                            </div>
                            <fieldset class="mb-3 ps-4">
                                <legend class="form-label h6 mb-1">Was wird übertragen?</legend>
                                <p class="form-text mt-0">
                                    Nicht angehakte Bereiche bleiben bei den Folgeterminen so, wie sie dort
                                    einzeln eingestellt wurden.
                                </p>
                                {% for group in series_field_groups %}
                                    <div class="form-check">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               id="series_field_{{ group.key }}"
                                               name="series_fields[]"
                                               value="{{ group.key }}"
                                               {% if group.key in series_fields %}checked{% endif %}>
                                        <label class="form-check-label" for="series_field_{{ group.key }}">{{ group.label }}</label>
                                    </div>
                                {% endfor %}
                            </fieldset>
                        {% endif %}

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/events" class="btn btn-secondary">Abbrechen</a>
                            <button type="submit" class="btn btn-primary">Änderungen speichern</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
{% endblock styles %}

{% block scripts %}
    {{ parent() }}
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="/js/tom-select-init.js"></script>
    <script src="/js/events-audience.js"></script>
{% endblock scripts %}
