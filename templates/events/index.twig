{% extends "layout.twig" %}

{% import "macros/modal_form.twig" as modal %}
{% import "macros/help.twig" as help %}

{% block title %}
    Termine - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    {% set _filter_query = {
        project_id: filters.project_id,
        event_type_id: filters.event_type_id,
        show_old_events: filters.show_old_events,
    }|filter(value => value) %}
    {% set _filter_suffix = _filter_query is empty ? "" : "&" ~ _filter_query|url_encode %}
    {% set _views = can_use_table ? [{key: "list", label: "Liste", icon: "bi-table"}] : [] %}
    {% set _views = _views|merge([
        {key: "plan", label: "Plan", icon: "bi-list-ul"},
        {key: "calendar", label: "Kalender", icon: "bi-calendar3"},
    ]) %}
    <section class="page-header">
        <div>
            <h1 class="h2 mb-0">Termine</h1>
        </div>
        <div class="page-actions">
            {{ help.button("events", "Termine") }}
            <div class="btn-group me-2" role="group" aria-label="Ansicht wählen">
                {% for _view in _views %}
                    {% set _active = view_mode == _view.key %}
                    <a href="/events?view={{ _view.key }}{{ _filter_suffix }}"
                       class="btn {{ _active ? "btn-secondary" : "btn-outline-secondary" }}"
                       {% if _active %}aria-current="page"{% endif %}>
                        <i class="bi {{ _view.icon }}" aria-hidden="true"></i> {{ _view.label }}
                    </a>
                {% endfor %}
            </div>
            {% if calendar_subscription %}
                <button type="button"
                        class="btn btn-outline-secondary me-2"
                        data-bs-toggle="modal"
                        data-bs-target="#calendarSubscriptionModal">
                    <i class="bi bi-calendar2-week me-1" aria-hidden="true"></i> Kalender abonnieren
                </button>
            {% endif %}
            {% if session.can_manage_events %}
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addEventModal">
                    Termin erstellen
                </button>
            {% endif %}
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Schließen"></button>
        </div>
    {% endif %}
    {% if error and not create_form.open_modal %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Schließen"></button>
        </div>
    {% endif %}

    {% if calendar_subscription %}
        {{ include("partials/calendar_subscription_modal.twig", {
            calendar_subscription: calendar_subscription,
            redirect_to: "/events",
        }, with_context: false) }}
    {% endif %}

    {% if view_mode != "list" %}
        <div class="event-filter-bar">
            {{ include("events/partials/filter_form.twig") }}
        </div>
    {% endif %}

    {% if view_mode == "plan" %}
        {{ include("events/partials/plan.twig") }}
    {% endif %}

    {% if view_mode == "list" %}
        <section aria-labelledby="events-list-title">
            <h2 class="visually-hidden" id="events-list-title">Terminliste</h2>
            <div class="surface-card card border-0 table-shell">
                <div class="card-body p-0"
                     data-table-engine="true"
                     data-table-id="events.index"
                     data-default-view="auto"
                     data-default-page-size="100"
                     data-page-size-options="25,50,100,200"
                     data-default-sort-key="starts_at"
                     data-default-sort-dir="asc">
                    {{ include("partials/table_toolbar.twig", {toolbar_filter_template: "events/partials/filter_form.twig"}) }}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 table-responsive-cards event-table"
                               id="eventsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th data-sort-key="starts_at" data-sort-type="date">Datum / Zeit</th>
                                    <th data-sort-key="title" data-sort-type="text">Titel</th>
                                    <th data-sort-key="location" data-sort-type="text">Ort</th>
                                    <th data-sort-key="type" data-sort-type="text">Typ</th>
                                    <th data-sort-type="text">Zielgruppe</th>
                                    <th class="text-end">Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set _can_attendance = session.can_manage_own_voice_group or session.can_manage_attendance_all %}
                                {% for event in events %}
                                    {% set _row_classes = [] %}
                                    {% if event.is_highlighted %}{% set _row_classes = _row_classes|merge(["is-highlighted"]) %}{% endif %}
                                    {% if event.is_past %}{% set _row_classes = _row_classes|merge(["is-past"]) %}{% endif %}
                                    {% if next_event and next_event.id == event.id %}
                                        {% set _row_classes = _row_classes|merge(["is-next"]) %}
                                    {% endif %}
                                    <tr class="{{ _row_classes|join(" ") }}"
                                        data-sort-starts_at="{{ event.starts_at|date("Y-m-d H:i") }}"
                                        data-sort-title="{{ event.title|lower }}"
                                        data-sort-location="{{ event.location|default("")|lower }}"
                                        data-sort-type="{{ event.type_name|lower }}">
                                        <td data-label="Datum / Zeit">
                                            <span>{{ event.weekday }} {{ event.starts_at|date("d.m.Y") }}</span>
                                            {% if event.relative_label %}
                                                <span class="event-relative">{{ event.relative_label }}</span>
                                            {% endif %}
                                            <br>
                                            <span class="text-muted small">{{ event.starts_at|date("H:i") }}–{{ event.ends_at|date("H:i") }}</span>
                                            {% if event.series_id %}
                                                <i class="bi bi-repeat text-muted ms-1" title="Serientermin" aria-label="Serientermin"></i>
                                            {% endif %}
                                        </td>
                                        <td data-label="Titel" data-card-title>
                                            <a href="/events/{{ event.id }}" class="event-title-link">
                                                {{ event.title }}
                                            </a>
                                            {{ include("events/partials/note_count.twig") }}
                                        </td>
                                        <td data-label="Ort">{{ event.location|default("-") }}</td>
                                        <td data-label="Typ">
                                            <span class="badge text-bg-{{ event.type_color }}">{{ event.type_name }}</span>
                                        </td>
                                        <td data-label="Zielgruppe">{{ event.audience_label|default("Alle") }}</td>
                                        <td data-label="Aktionen" class="text-end">
                                            <div class="d-inline-flex gap-1">
                                                {% if _can_attendance and event.attendance_required %}
                                                    <a href="/attendance/{{ event.id }}"
                                                       class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-person-check" aria-hidden="true"></i> Anwesenheit
                                                    </a>
                                                {% endif %}
                                                <div class="dropdown">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            data-bs-toggle="dropdown"
                                                            aria-expanded="false"
                                                            data-bs-boundary="viewport"
                                                            aria-label="Weitere Aktionen für {{ event.title }}">
                                                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a href="/events/{{ event.id }}/edit" class="dropdown-item">
                                                                <i class="bi bi-pencil me-2" aria-hidden="true"></i> Termin bearbeiten
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <form action="/events/{{ event.id }}/delete"
                                                                  method="post"
                                                                  data-confirm="Diesen Termin wirklich löschen? Anwesenheiten und Anmeldungen dieses Termins werden mitgelöscht.">
                                                                <button type="submit" class="dropdown-item text-danger">
                                                                    <i class="bi bi-trash me-2" aria-hidden="true"></i> Termin löschen
                                                                </button>
                                                            </form>
                                                        </li>
                                                        {% if event.series_id %}
                                                            <li>
                                                                <form action="/events/{{ event.id }}/delete-series"
                                                                      method="post"
                                                                      data-confirm="Alle Termine der Serie ab diesem Termin wirklich löschen? Anwesenheiten und Anmeldungen dieser Termine werden mitgelöscht.">
                                                                    <button type="submit" class="dropdown-item text-danger">
                                                                        <i class="bi bi-repeat me-2" aria-hidden="true"></i> Serie löschen
                                                                    </button>
                                                                </form>
                                                            </li>
                                                        {% endif %}
                                                    </ul>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            {{ include("events/partials/empty_state.twig") }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {% if view_mode == "calendar" %}
        <section aria-labelledby="events-calendar-title">
            <h2 class="visually-hidden" id="events-calendar-title">Kalender</h2>
            <div class="surface-card card border-0">
                <div class="card-body">
                    <div id="event-calendar"
                         data-calendar-events="{{ calendar_events|e("html_attr") }}"
                         {% if session.can_manage_events %}data-calendar-admin="1"{% endif %}></div>
                </div>
            </div>
        </section>
    {% endif %}

    {% if session.can_manage_events %}
        <!-- Add Event Modal -->
        <div class="modal fade"
             id="addEventModal"
             data-open-create-modal="{{ create_form.open_modal ? '1' : '0' }}"
             tabindex="-1"
             aria-labelledby="addEventModalLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <form action="/events" method="post" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addEventModalLabel">Neuen Termin anlegen</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Schließen"></button>
                    </div>
                    <div class="modal-body">
                        {{ modal.show_modal_error(error, create_form.error, 'event_create') }}

                        <div class="mb-3">
                            <label for="title" class="form-label">Titel *</label>
                            <input type="text"
                                   class="form-control"
                                   id="title"
                                   name="title"
                                   value="{{ create_form.form.title|default('') }}"
                                   required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="starts_at" class="form-label">Datum *</label>
                                <input type="date"
                                       class="form-control"
                                       id="starts_at"
                                       name="starts_at"
                                       value="{{ create_form.form.starts_at|default('') }}"
                                       required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="start_time" class="form-label">Von *</label>
                                <input type="time"
                                       class="form-control"
                                       id="start_time"
                                       name="start_time"
                                       value="{{ create_form.form.start_time|default('') }}"
                                       required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="end_time" class="form-label">Bis *</label>
                                <input type="time"
                                       class="form-control"
                                       id="end_time"
                                       name="end_time"
                                       value="{{ create_form.form.end_time|default('') }}"
                                       required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="event_type_id" class="form-label">Typ *</label>
                                <select class="form-select" id="event_type_id" name="event_type_id" required>
                                    {% for et in event_types %}
                                        <option value="{{ et.id }}"
                                                {% if create_form.form.event_type_id is not empty and create_form.form.event_type_id == et.id %}selected{% endif %}>
                                            {{ et.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label">Ort (optional)</label>
                            <input type="text"
                                   class="form-control"
                                   id="location"
                                   name="location"
                                   value="{{ create_form.form.location|default('') }}">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Zielgruppe</label>
                            {{ include("partials/audience/filter_rows.twig", {
                                prefix: "audience",
                                rows: audience_rows,
                                options: audience_options,
                            }) }}
                        </div>

                        {% set _notify_default_checked = create_form.form.notify_members is not defined %}
                        {% set _notify_checked = _notify_default_checked or create_form.form.notify_members %}
                        {# Das versteckte Feld sagt dem Server, dass dieses Formular
                           die Frage überhaupt gestellt hat. Ohne es wäre ein fehlendes
                           Häkchen nicht von einem alten Formular zu unterscheiden, das
                           die Frage gar nicht kennt - und dann entschiede der Zufall,
                           ob benachrichtigt wird. #}
                        <input type="hidden" name="notify_members_present" value="1">
                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="notify-members-create"
                                   name="notify_members"
                                   value="1"
                                   {% if _notify_checked %}checked{% endif %}>
                            <label class="form-check-label" for="notify-members-create">Mitglieder benachrichtigen</label>
                            <div class="form-text">
                                Schickt der Zielgruppe eine Mail. Bei einer reinen Korrektur besser abwählen.
                            </div>
                        </div>

                        {% set _attendance_default_checked = create_form.form.attendance_required is not defined %}
                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="attendance-required"
                                   name="attendance_required"
                                   value="1"
                                   {% if _attendance_default_checked or create_form.form.attendance_required %}checked{% endif %}>
                            <label class="form-check-label" for="attendance-required">Anwesenheitsliste führen</label>
                        </div>
                        {% if settings.modules.registration %}
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="registration-enabled"
                                       name="registration_enabled"
                                       value="1"
                                       {% if create_form.form.registration_enabled %}checked{% endif %}>
                                <label class="form-check-label" for="registration-enabled">Anmeldung freischalten</label>
                            </div>
                            <div class="mb-3"
                                 id="registration_deadline_field"
                                 {% if not create_form.form.registration_enabled %}hidden{% endif %}>
                                <label for="registration-deadline" class="form-label">
                                    Anmeldeschluss (optional, sonst Terminbeginn)
                                </label>
                                <input type="datetime-local"
                                       class="form-control"
                                       id="registration-deadline"
                                       name="registration_deadline"
                                       value="{{ create_form.form.registration_deadline|default('') }}">
                            </div>
                        {% endif %}

                        <hr class="my-4">

                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="repeat_event"
                                   name="repeat"
                                   value="1"
                                   {% if create_form.form.repeat %}checked{% endif %}>
                            <label class="form-check-label fw-bold" for="repeat_event">Termin wiederholen</label>
                        </div>

                        <div id="recurrence_options"
                             {% if not create_form.form.repeat %}hidden{% endif %}>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="events-index-recurrence-interval" class="form-label">Wiederhole jeden</label>
                                    <input type="number"
                                           class="form-control"
                                           name="recurrence_interval"
                                           value="{{ create_form.form.recurrence_interval|default('1') }}"
                                           min="1"
                                           id="events-index-recurrence-interval">
                                </div>
                                <div class="col-md-6">
                                    <label for="frequency" class="form-label"></label>
                                    <select class="form-select" name="frequency" id="frequency" aria-label="Zeiteinheit">
                                        <option value="daily"
                                                {% if create_form.form.frequency == 'daily' %}selected{% endif %}>
                                            Tag
                                        </option>
                                        <option value="weekly"
                                                {% if create_form.form.frequency == 'weekly' %}selected{% endif %}>
                                            Woche
                                        </option>
                                        <option value="monthly"
                                                {% if create_form.form.frequency == 'monthly' %}selected{% endif %}>
                                            Monat
                                        </option>
                                        <option value="yearly"
                                                {% if create_form.form.frequency == 'yearly' %}selected{% endif %}>
                                            Jahr
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div id="weekday_selector"
                                 class="mb-3"
                                 {% if create_form.form.frequency != 'weekly' %}hidden{% endif %}>
                                <label class="form-label">am</label>
                                <div class="d-flex flex-wrap gap-1">
                                    {% for day in ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'] %}
                                        <input type="checkbox"
                                               class="btn-check"
                                               id="day_{{ loop.index }}"
                                               name="weekdays[]"
                                               value="{{ loop.index }}"
                                               {% if loop.index in create_form.form.weekdays|default([1]) %}checked{% endif %}>
                                        <label class="btn btn-outline-primary btn-sm px-3"
                                               for="day_{{ loop.index }}">{{ day }}</label>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="series_end_date" class="form-label">Wiederholung beenden am</label>
                                <input type="date"
                                       class="form-control"
                                       id="series_end_date"
                                       name="series_end_date"
                                       value="{{ create_form.form.series_end_date|default('') }}"
                                       {% if create_form.form.repeat %}required{% endif %}>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        {# Wer speichert, soll sehen, dass dabei Mails rausgehen. #}
                        <button type="submit"
                                class="btn btn-primary"
                                id="addEventSubmit"
                                data-submit-label="Speichern"
                                data-notify-label="Speichern und benachrichtigen">
                            {{ _notify_checked ? "Speichern und benachrichtigen" : "Speichern" }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
{% endblock content %}

{% block styles %}
    <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
    {% if view_mode == 'calendar' %}
        <link rel="stylesheet" href="/vendor/fullcalendar/skeleton.css">
        <link rel="stylesheet" href="/vendor/fullcalendar/themes/classic.theme.css">
        <link rel="stylesheet" href="/vendor/fullcalendar/themes/classic.palette.css">
    {% endif %}
{% endblock styles %}

{% block scripts %}
    <script src="/js/events.js"></script>
    <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
    <script src="/js/tom-select-init.js"></script>
    <script src="/js/audience-filter.js"></script>
    {% if view_mode == 'calendar' %}
        <script src="/vendor/temporal-polyfill/global.js"></script>
        <script src="/vendor/fullcalendar/fullcalendar.global.js"></script>
        <script src="/vendor/fullcalendar/locales/de.global.js"></script>
        <script src="/vendor/fullcalendar/themes/classic.global.js"></script>
        <script src="/js/event-calendar.js"></script>
    {% endif %}
{% endblock scripts %}
