                                   type="checkbox"
                                   role="switch"
                                   id="edit_can_manage_sponsoring"
                                   name="can_manage_sponsoring"
                                   value="1">
                            <label class="form-check-label fw-bold text-info"
                                   for="edit_can_manage_sponsoring">Sponsoring verwalten</label>
                            <div class="form-text">
                                Wenn aktiv, darf diese Person das Sponsoring-Modul sehen und Sponsoren, Vereinbarungen und Kontakte verwalten.
                            </div>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="edit_can_create_own_sponsorships"
                                   name="can_create_own_sponsorships"
                                   value="1">
                            <label class="form-check-label fw-bold text-info"
                                   for="edit_can_create_own_sponsorships">Eigene Sponsoring-Vereinbarungen erfassen</label>
