{% extends "layout.twig" %}

{% block title %}
    Rollen &amp; Rechte - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Administration</p>
            <h1 class="h2 mb-1">Rollen &amp; Rechte</h1>
            <p class="text-muted mb-0">Berechtigungen und Hierarchien transparent steuern.</p>
        </div>
        <div class="page-actions">
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addRoleModal">
                <i class="bi bi-shield-plus"></i> Neue Rolle
            </button>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context"
                 aria-labelledby="roles-overview-title">
            <div class="dashboard-section-head">
                <h2 class="dashboard-section-title" id="roles-overview-title">Rollen und ihre Rechte</h2>
                <p class="dashboard-section-lead mb-0">
                    Rolle wählen, um ihre Rechte zu sehen. Ein Klick auf ein Recht zeigt, welche Rollen es haben.
                </p>
            </div>

            <div class="surface-card card border-0">
                <div class="card-body">
                    {{ include("roles/_overview.twig") }}
                </div>
            </div>
        </section>
    </div>

    {% for role in roles %}
        {% if role.assigned_users_count == 0 %}
            <div class="modal fade" id="deleteRoleModal{{ role.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" action="/roles/{{ role.id }}/delete">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">Rolle löschen</h5>
                                <button type="button"
                                        class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"
                                        aria-label="Schließen"></button>
                            </div>
                            <div class="modal-body">
                                Möchtest du die Rolle <strong>{{ role.name }}</strong> wirklich löschen?
                                Dieser Vorgang kann nicht rückgängig gemacht werden.
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                                <button type="submit" class="btn btn-danger">Löschen</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    <!-- Add Role Modal -->
    <div class="modal fade"
         id="addRoleModal"
         tabindex="-1"
         aria-labelledby="addRoleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog">
            <form action="{{ role_create_action }}" method="post" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Neue Rolle anlegen</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">Rollenname *</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>

                    <div class="mb-3">
                        <label for="hierarchy_level" class="form-label">Hierarchie-Level (0-100) *</label>
                        <input type="number"
                               class="form-control"
                               id="hierarchy_level"
                               name="hierarchy_level"
                               min="0"
                               max="100"
                               value="0"
                               required>
                        <div class="form-text">
                            Höhere Level (z.B. 80-100) stehen für den Vorstand und die Chorleitung. "Mitglied" hat oft Level 0.
                        </div>
                    </div>

                    <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Mitgliederverwaltung</h6>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_users"
                               name="can_manage_users"
                               value="1">
                        <label class="form-check-label fw-bold text-danger" for="can_manage_users">Mitgliederverwaltung erlauben</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Rolle Mitglieder anlegen, bearbeiten und archivieren sowie ihnen Rollen
                            bis zum eigenen Hierarchie-Level zuweisen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_roles"
                               name="can_manage_roles"
                               value="1">
                        <label class="form-check-label fw-bold text-danger" for="can_manage_roles">Rollen verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Rolle Rollen anlegen und bearbeiten - und damit jedes Recht vergeben,
                            auch an sich selbst. Nur an wenige, vertrauenswürdige Rollen vergeben.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_edit_users"
                               name="can_edit_users"
                               value="1">
                        <label class="form-check-label fw-bold text-warning" for="can_edit_users">Mitglieder editieren erlauben</label>
                        <div class="form-text">Wenn aktiv, darf diese Person die Zuweisungen anderer Mitglieder bearbeiten.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_project_members"
                               name="can_manage_project_members"
                               value="1">
                        <label class="form-check-label fw-bold text-info"
                               for="can_manage_project_members">Projektmitglieder verwalten</label>
                        <div class="form-text">Wenn aktiv, darf diese Person Benutzer Projekten zuordnen oder entfernen.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_assign_own_voice_group_to_project"
                               name="can_assign_own_voice_group_to_project"
                               value="1">
                        <label class="form-check-label fw-bold text-info"
                               for="can_assign_own_voice_group_to_project">Eigene Stimmgruppe ins Projekt zuweisen</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Person nur Mitglieder ihrer eigenen Stimmgruppe den eigenen
                            Projekten zuordnen oder daraus entfernen - ohne Zugriff auf andere Stimmgruppen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_events"
                               name="can_manage_events"
                               value="1">
                        <label class="form-check-label fw-bold text-secondary"
                               for="can_manage_events">Termine verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Person Termine anlegen, bearbeiten und löschen, öffentliche
                            Bemerkungen moderieren und die Termin-Typen pflegen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_attendance_all"
                               name="can_manage_attendance_all"
                               value="1">
                        <label class="form-check-label fw-bold text-secondary"
                               for="can_manage_attendance_all">Anwesenheit/Anmeldung verwalten (alle Mitglieder)</label>
                        <div class="form-text">Wenn aktiv, darf diese Person Anwesenheiten und Anmeldungen für alle Mitglieder erfassen und aktualisieren.</div>
                    </div>

                    {% if settings.modules.finance %}
                        <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Finanzen</h6>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_read_finances"
                                   name="can_read_finances"
                                   value="1">
                            <label class="form-check-label fw-bold text-success"
                                   for="can_read_finances">Finanzen nur lesen</label>
                            <div class="form-text">
                                Wenn aktiv, darf diese Person das Finanzmodul ansehen und Auswertungen sowie Anhänge öffnen.
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_manage_finances"
                                   name="can_manage_finances"
                                   value="1">
                            <label class="form-check-label fw-bold text-success"
                                   for="can_manage_finances">Finanzen lesen und schreiben</label>
                            <div class="form-text">
                                Wenn aktiv, darf diese Person Finanzeinträge und Konfigurationen bearbeiten sowie löschen.
                            </div>
                        </div>
                    {% endif %}

                          {% if settings.modules.budget %}
                           <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                type="checkbox"
                                role="switch"
                                id="can_manage_budget"
                                name="can_manage_budget"
                                value="1">
                            <label class="form-check-label fw-bold text-primary"
                                for="can_manage_budget">Budget verwalten</label>
                            <div class="form-text">Wenn aktiv, darf diese Person den Budget-Bereich sehen und bearbeiten.</div>
                           </div>
                          {% endif %}

                    <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Sponsoring &amp; Repertoire</h6>

                    {% if settings.modules.sponsoring %}
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_manage_sponsoring"
                                   name="can_manage_sponsoring"
                                   value="1">
                            <label class="form-check-label fw-bold text-info"
                                   for="can_manage_sponsoring">Sponsoring verwalten</label>
                            <div class="form-text">
                                Wenn aktiv, darf diese Person das Sponsoring-Modul sehen und Sponsoren, Vereinbarungen und Kontakte verwalten.
                            </div>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_create_own_sponsorships"
                                   name="can_create_own_sponsorships"
                                   value="1">
                            <label class="form-check-label fw-bold text-info"
                                   for="can_create_own_sponsorships">Eigene Sponsoring-Vereinbarungen erfassen</label>
                            <div class="form-text">
                                Wenn aktiv, sieht diese Person, welche Firmen bereits angefragt sind und wie es dort steht, und
                                darf eigene Vereinbarungen anlegen und bearbeiten. Beträge, Vertragsdateien und Gesprächsnotizen
                                fremder Vereinbarungen bleiben verborgen, ebenso das Löschen von Sponsoren und die Paketverwaltung.
                                Auf dem Dashboard erscheinen nur die eigenen Wiedervorlagen und Kontakte.
                            </div>
                        </div>
                    {% endif %}

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_song_library"
                               name="can_manage_song_library"
                               value="1">
                        <label class="form-check-label fw-bold text-primary"
                               for="can_manage_song_library">Repertoire verwalten</label>
                        <div class="form-text">Wenn aktiv, darf diese Person Lieder und zugehoerige Dateien pro Projekt verwalten.</div>
                    </div>

                    {% if settings.modules.sheet_archive %}
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_manage_sheet_archive"
                                   name="can_manage_sheet_archive"
                                   value="1">
                            <label class="form-check-label fw-bold text-primary"
                                   for="can_manage_sheet_archive">Notenarchiv verwalten</label>
                            <div class="form-text">Wenn aktiv, darf diese Person den Notenarchiv-Bereich im Repertoire sehen und bearbeiten.</div>
                        </div>
                    {% endif %}

                    <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Kommunikation &amp; Planung</h6>

                    {% if settings.modules.newsletter %}
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_manage_newsletters"
                                   name="can_manage_newsletters"
                                   value="1">
                            <label class="form-check-label fw-bold text-success"
                                   for="can_manage_newsletters">Newsletter verwalten</label>
                            <div class="form-text">Wenn aktiv, darf diese Person Newsletter erstellen, bearbeiten und verschicken.</div>
                        </div>
                    {% endif %}

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_mail_queue"
                               name="can_manage_mail_queue"
                               value="1">
                        <label class="form-check-label fw-bold text-primary"
                               for="can_manage_mail_queue">Mailversand verwalten</label>
                        <div class="form-text">Wenn aktiv, darf diese Person die Mail-Queue einsehen und Dead-Letter erneut senden.</div>
                    </div>

                    {% if settings.modules.tasks %}
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_manage_tasks"
                                   name="can_manage_tasks"
                                   value="1">
                            <label class="form-check-label fw-bold text-primary"
                                   for="can_manage_tasks">Projektplanung (Aufgaben)</label>
                            <div class="form-text">Wenn aktiv, darf diese Person Aufgaben (auch übergreifend) verwalten.</div>
                        </div>
                    {% endif %}

                    {% if settings.modules.files %}
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="can_manage_files"
                                   name="can_manage_files"
                                   value="1">
                            <label class="form-check-label fw-bold text-primary"
                                   for="can_manage_files">Dateiverwaltung verwalten</label>
                            <div class="form-text">
                                Wenn aktiv, darf diese Person Teamordner anlegen, Kontingente festlegen und alle Freigaben ändern.
                            </div>
                        </div>
                    {% endif %}

                    <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Stammdaten &amp; System</h6>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_master_data"
                               name="can_manage_master_data"
                               value="1">
                        <label class="form-check-label fw-bold text-primary"
                               for="can_manage_master_data">Stammdaten verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Person Projekte, Rollen, Stimmgruppen und App-Einstellungen bearbeiten.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_backups"
                               name="can_manage_backups"
                               value="1">
                        <label class="form-check-label fw-bold text-primary"
                               for="can_manage_backups">Backup-Verwaltung</label>
                        <div class="form-text">Wenn aktiv, darf diese Person Datenbank-Backups erstellen, herunterladen, löschen und wiederherstellen.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_storage"
                               name="can_manage_storage"
                               value="1">
                        <label class="form-check-label fw-bold text-primary"
                               for="can_manage_storage">Speicherplatz-Verwaltung</label>
                        <div class="form-text">Wenn aktiv, darf diese Person die Übersicht über den belegten Speicherplatz sehen.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_own_voice_group"
                               name="can_manage_own_voice_group"
                               value="1">
                        <label class="form-check-label fw-bold text-primary"
                               for="can_manage_own_voice_group">Eigene Stimmgruppe verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Person Anwesenheit und Anmeldungen ihrer eigenen Stimmgruppe
                            verwalten (Stimmvertretung), unabhängig vom Hierarchie-Level.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">Rolle Speichern</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit Role Modal -->
    <div class="modal fade"
         id="editRoleModal"
         tabindex="-1"
         aria-labelledby="editRoleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog">
            <form action="{{ role_edit_action }}"
                  method="post"
                  id="editRoleForm"
                  class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Rolle bearbeiten</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="edit_name" class="form-label">Rollenname *</label>
                        <input type="text" class="form-control" id="edit_name" name="name" required>
                    </div>

                    <div class="mb-3">
                        <label for="edit_hierarchy_level" class="form-label">Hierarchie-Level (0-100) *</label>
                        <input type="number"
                               class="form-control"
                               id="edit_hierarchy_level"
                               name="hierarchy_level"
                               min="0"
                               max="100"
                               required>
                        <div class="form-text">
                            Höhere Level (z.B. 80-100) stehen für den Vorstand und die Chorleitung. "Mitglied" hat oft Level 0.
                        </div>
                    </div>

                    <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Mitgliederverwaltung</h6>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_manage_users"
                               name="can_manage_users"
                               value="1">
                        <label class="form-check-label fw-bold text-danger"
                               for="edit_can_manage_users">Mitgliederverwaltung erlauben</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Rolle Mitglieder anlegen, bearbeiten und archivieren sowie ihnen Rollen
                            bis zum eigenen Hierarchie-Level zuweisen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_manage_roles"
                               name="can_manage_roles"
                               value="1">
                        <label class="form-check-label fw-bold text-danger"
                               for="edit_can_manage_roles">Rollen verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Rolle Rollen anlegen und bearbeiten - und damit jedes Recht vergeben,
                            auch an sich selbst. Nur an wenige, vertrauenswürdige Rollen vergeben.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_edit_users"
                               name="can_edit_users"
                               value="1">
                        <label class="form-check-label fw-bold text-warning"
                               for="edit_can_edit_users">Mitglieder editieren erlauben</label>
                        <div class="form-text">Wenn aktiv, darf diese Person die Zuweisungen anderer Mitglieder bearbeiten.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_manage_project_members"
                               name="can_manage_project_members"
                               value="1">
                        <label class="form-check-label fw-bold text-info"
                               for="edit_can_manage_project_members">Projektmitglieder verwalten</label>
                        <div class="form-text">Wenn aktiv, darf diese Person Benutzer Projekten zuordnen oder entfernen.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_assign_own_voice_group_to_project"
                               name="can_assign_own_voice_group_to_project"
                               value="1">
                        <label class="form-check-label fw-bold text-info"
                               for="edit_can_assign_own_voice_group_to_project">Eigene Stimmgruppe ins Projekt zuweisen</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Person nur Mitglieder ihrer eigenen Stimmgruppe den eigenen
                            Projekten zuordnen oder daraus entfernen - ohne Zugriff auf andere Stimmgruppen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_manage_events"
                               name="can_manage_events"
                               value="1">
                        <label class="form-check-label fw-bold text-secondary"
                               for="edit_can_manage_events">Termine verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Person Termine anlegen, bearbeiten und löschen, öffentliche
                            Bemerkungen moderieren und die Termin-Typen pflegen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="edit_can_manage_attendance_all"
                               name="can_manage_attendance_all"
                               value="1">
                        <label class="form-check-label fw-bold text-secondary"
                               for="edit_can_manage_attendance_all">Anwesenheit/Anmeldung verwalten (alle Mitglieder)</label>
                        <div class="form-text">Wenn aktiv, darf diese Person Anwesenheiten und Anmeldungen für alle Mitglieder erfassen und aktualisieren.</div>
                    </div>

                    {% if settings.modules.finance %}
                        <h6 class="group-label border-bottom pb-1 mt-4 mb-2">Finanzen</h6>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="edit_can_read_finances"
                                   name="can_read_finances"
                                   value="1">
                            <label class="form-check-label fw-bold text-success"
                                   for="edit_can_read_finances">Finanzen nur lesen</label>
                            <div class="form-text">
                                Wenn aktiv, darf diese Person das Finanzmodul ansehen und Auswertungen sowie Anhänge öffnen.
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
