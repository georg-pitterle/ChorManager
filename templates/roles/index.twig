{% extends "layout.twig" %}

{% block title %}
    Rollen verwalten - {{ app_settings.app_name|default("Chor-Manager") }}
{% endblock title %}

{% block page_header %}
    <section class="page-header">
        <div>
            <p class="text-uppercase text-muted small mb-1">Verwaltung</p>
            <h1 class="h2 mb-1">Rollen verwalten</h1>
            <p class="text-muted mb-0">Berechtigungen und Hierarchien transparent steuern.</p>
        </div>
        <div class="page-actions">
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addRoleModal">
                <i class="bi bi-shield-plus"></i> Neue Rolle
            </button>
        </div>
    </section>
{% endblock page_header %}

{% block content %}
    {% if success %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ success }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error }}
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="dashboard-shell">
        <section class="dashboard-section dashboard-section--context"
                 aria-labelledby="roles-matrix-title">
            <div class="dashboard-section-head">
                <h2 class="dashboard-section-title" id="roles-matrix-title">Berechtigungsmatrix</h2>
                <p class="dashboard-section-lead mb-0">Rollen, Rechte und Hierarchiestufen im direkten Vergleich.</p>
            </div>

            <div class="surface-card card border-0 table-shell"
                 data-table-engine="true"
                 data-table-id="roles.index"
                 data-default-view="auto"
                 data-default-sort-key=""
                 data-default-page-size="100"
                 data-page-size-options="25,50,100,200">
                {{ include('partials/table_toolbar.twig') }}
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 table-responsive-cards"
                               id="rolesTable">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col" class="text-nowrap">Berechtigung</th>
                                    {% for role in roles %}
                                        <th scope="col" class="text-nowrap">
                                            <div class="fw-semibold text-center align-middle">{{ role.name }}</div>
                                            <small class="text-body-secondary d-block text-center">Level {{ role.hierarchy_level }}</small>
                                        </th>
                                    {% else %}
                                        <th scope="col">Rollen</th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% if roles is not empty %}
                                    <tr class="table-secondary">
                                        <th colspan="{{ roles|length + 1 }}" class="small text-uppercase fw-bold">Mitgliederverwaltung</th>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Mitgliederverwaltung erlauben</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_users %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Rollen verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_roles %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Mitglieder editieren erlauben</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_edit_users %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Termine verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_events %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Anwesenheit/Anmeldung verwalten (eigene Stimmgruppe)</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_attendance %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Anwesenheit/Anmeldung verwalten (alle Mitglieder)</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_attendance_all %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Projektmitglieder verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_project_members %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Eigene Stimmgruppe verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_own_voice_group %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% if settings.modules.finance %}
                                        <tr class="table-secondary">
                                            <th colspan="{{ roles|length + 1 }}" class="small text-uppercase fw-bold">Finanzen</th>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Finanzen nur lesen</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_read_finances %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Finanzen lesen und schreiben</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_manage_finances %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                    {% if settings.modules.budget %}
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Budget verwalten</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_manage_budget %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                    <tr class="table-secondary">
                                        <th colspan="{{ roles|length + 1 }}" class="small text-uppercase fw-bold">Sponsoring &amp; Repertoire</th>
                                    </tr>
                                    {% if settings.modules.sponsoring %}
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Sponsoring verwalten</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_manage_sponsoring %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Repertoire verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_song_library %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% if settings.modules.sheet_archive %}
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Notenarchiv verwalten</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_manage_sheet_archive %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                    <tr class="table-secondary">
                                        <th colspan="{{ roles|length + 1 }}" class="small text-uppercase fw-bold">Kommunikation &amp; Planung</th>
                                    </tr>
                                    {% if settings.modules.newsletter %}
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Newsletter verwalten</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_manage_newsletters %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Mailversand verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_mail_queue %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% if settings.modules.tasks %}
                                        <tr>
                                            <th scope="row" class="roles-matrix-label">Projektplanung (Aufgaben)</th>
                                            {% for role in roles %}
                                                <td data-label="{{ role.name }}" class="text-center align-middle">
                                                    {% if role.can_manage_tasks %}
                                                        <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                    {% else %}
                                                        <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                    <tr class="table-secondary">
                                        <th colspan="{{ roles|length + 1 }}" class="small text-uppercase fw-bold">Stammdaten &amp; System</th>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Stammdaten verwalten</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_master_data %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Backup-Verwaltung</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                {% if role.can_manage_backups %}
                                                    <span class="badge rounded-pill bg-success" aria-label="Ja" title="Ja"><i class="bi bi-check-lg text-white"></i></span>
                                                {% else %}
                                                    <span class="badge rounded-pill bg-danger" aria-label="Nein" title="Nein"><i class="bi bi-x-lg text-white"></i></span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Aktive Mitglieder</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                <span class="badge bg-primary rounded-pill text-center">{{ role.active_users_count }}</span>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        <th scope="row" class="roles-matrix-label">Aktionen</th>
                                        {% for role in roles %}
                                            <td data-label="{{ role.name }}" class="text-center align-middle">
                                                <div class="btn-group"
                                                     role="group"
                                                     aria-label="Rollenaktionen für {{ role.name }}">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary edit-role-btn"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#editRoleModal"
                                                            data-id="{{ role.id }}"
                                                            data-name="{{ role.name }}"
                                                            data-level="{{ role.hierarchy_level }}"
                                                            data-manage="{{ role.can_manage_users ? '1' : '0' }}"
                                                            data-roles="{{ role.can_manage_roles ? '1' : '0' }}"
                                                            data-edit="{{ role.can_edit_users ? '1' : '0' }}"
                                                            data-attendance="{{ role.can_manage_attendance ? '1' : '0' }}"
                                                            data-attendance-all="{{ role.can_manage_attendance_all ? '1' : '0' }}"
                                                            data-events="{{ role.can_manage_events ? '1' : '0' }}"
                                                            data-project-members="{{ role.can_manage_project_members ? '1' : '0' }}"
                                                            data-finance-read="{{ role.can_read_finances ? '1' : '0' }}"
                                                            data-finances="{{ role.can_manage_finances ? '1' : '0' }}"
                                                            data-master-data="{{ role.can_manage_master_data ? '1' : '0' }}"
                                                            data-sponsoring="{{ role.can_manage_sponsoring ? '1' : '0' }}"
                                                            data-song-library="{{ role.can_manage_song_library ? '1' : '0' }}"
                                                            data-newsletters="{{ role.can_manage_newsletters ? '1' : '0' }}"
                                                            data-mail-queue="{{ role.can_manage_mail_queue ? '1' : '0' }}"
                                                            data-sheet-archive="{{ role.can_manage_sheet_archive ? '1' : '0' }}"
                                                            data-budget="{{ role.can_manage_budget ? '1' : '0' }}"
                                                            data-tasks="{{ role.can_manage_tasks ? '1' : '0' }}"
                                                            data-backups="{{ role.can_manage_backups ? '1' : '0' }}"
                                                            data-own-voice-group="{{ role.can_manage_own_voice_group ? '1' : '0' }}">
                                                        <i class="bi bi-pencil"></i> Bearbeiten
                                                    </button>
                                                    {% if role.assigned_users_count == 0 %}
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deleteRoleModal{{ role.id }}">
                                                            <i class="bi bi-trash"></i> Löschen
                                                        </button>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="2" class="text-center py-4 text-muted">Keine Rollen gefunden.</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </div>

    {% for role in roles %}
        {% if role.assigned_users_count == 0 %}
            <div class="modal fade" id="deleteRoleModal{{ role.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" action="/roles/{{ role.id }}/delete">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">Rolle löschen</h5>
                                <button type="button"
                                        class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"
                                        aria-label="Schließen"></button>
                            </div>
                            <div class="modal-body">
                                Möchtest du die Rolle <strong>{{ role.name }}</strong> wirklich löschen?
                                Dieser Vorgang kann nicht rückgängig gemacht werden.
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                                <button type="submit" class="btn btn-danger">Löschen</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    <!-- Add Role Modal -->
    <div class="modal fade"
         id="addRoleModal"
         tabindex="-1"
         aria-labelledby="addRoleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog">
            <form action="{{ role_create_action }}" method="post" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Neue Rolle anlegen</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">Rollenname *</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>

                    <div class="mb-3">
                        <label for="hierarchy_level" class="form-label">Hierarchie-Level (0-100) *</label>
                        <input type="number"
                               class="form-control"
                               id="hierarchy_level"
                               name="hierarchy_level"
                               min="0"
                               max="100"
                               value="0"
                               required>
                        <div class="form-text">
                            Höhere Level (z.B. 80-100) stehen für den Vorstand und die Chorleitung. "Mitglied" hat oft Level 0.
                        </div>
                    </div>

                    <h6 class="text-uppercase text-muted small fw-bold mt-4 mb-2 border-bottom pb-1">Mitgliederverwaltung</h6>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_users"
                               name="can_manage_users"
                               value="1">
                        <label class="form-check-label fw-bold text-danger" for="can_manage_users">Mitgliederverwaltung erlauben</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Rolle Mitglieder anlegen, bearbeiten und archivieren sowie ihnen Rollen
                            bis zum eigenen Hierarchie-Level zuweisen.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_roles"
                               name="can_manage_roles"
                               value="1">
                        <label class="form-check-label fw-bold text-danger" for="can_manage_roles">Rollen verwalten</label>
                        <div class="form-text">
                            Wenn aktiv, darf diese Rolle Rollen anlegen und bearbeiten - und damit jedes Recht vergeben,
                            auch an sich selbst. Nur an wenige, vertrauenswürdige Rollen vergeben.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_edit_users"
                               name="can_edit_users"
                               value="1">
                        <label class="form-check-label fw-bold text-warning" for="can_edit_users">Mitglieder editieren erlauben</label>
                        <div class="form-text">Wenn aktiv, darf diese Person die Zuweisungen anderer Mitglieder bearbeiten.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="can_manage_project_members"
                               name="can_manage_project_members"
                               value="1">
