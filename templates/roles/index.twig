                                   id="edit_can_manage_tasks"
                                   name="can_manage_tasks"
                                   value="1">
                            <label class="form-check-label fw-bold text-primary"
                                   for="edit_can_manage_tasks">Projektplanung (Aufgaben)</label>
                            <div class="form-text">Wenn aktiv, darf diese Person Aufgaben (auch übergreifend) verwalten.</div>
                        </div>
                    {% endif %}

                    {% if settings.modules.files %}
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="edit_can_manage_files"
                                   name="can_manage_files"
                                   value="1">
                            <label class="form-check-label fw-bold text-primary"
                                   for="edit_can_manage_files">Dateiverwaltung verwalten</label>
                            <div class="form-text">
