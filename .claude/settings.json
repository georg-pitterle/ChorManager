{
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Write(**/.claude/rotating-review-state.json)",
      "Edit(**/.claude/rotating-review-state.json)",
      "Write(.claude/rotating-review-state.json)",
      "Edit(.claude/rotating-review-state.json)",
      "Bash(php bin/rotating_review_state.php:*)",
      "Bash(ddev php bin/rotating_review_state.php:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-german-umlauts.sh",
            "statusMessage": "Umlaute prüfen"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-german-umlauts.sh",
            "if": "Bash(git commit:*)",
            "statusMessage": "Umlaute prüfen"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-german-umlauts.sh",
            "statusMessage": "Umlaute prüfen"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
