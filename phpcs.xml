<?xml version="1.0"?>
<ruleset name="ChorManager Standard">
    <description>PSR-12 Coding Standard for Slim App</description>
    
    <!-- Use PSR-12 as a base -->
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="130"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!--
        Phinx findet eine Migration über den Dateinamen und erwartet die Klasse
        im globalen Namensraum. Die Regel ist dort also nicht erfüllbar - alles
        andere aus PSR-12 gilt für Migrationen wie für den übrigen Code.
    -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>db/migrations/*</exclude-pattern>
    </rule>

    <!-- Directories to check -->
    <file>src/</file>
    <file>db/</file>
    <file>public/index.php</file>

    <!-- Exclude vendor directory -->
    <exclude-pattern>vendor/</exclude-pattern>

    <!-- Show progress and use colors -->
    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
</ruleset>
